# Fixed secrets for the THROWAWAY Mastodon interop-harness instance.
#
# Not real secrets and not sensitive: this Mastodon runs only inside the harness
# compose network against a fresh per-run DB that `compose down -v` destroys, and
# is never exposed off loopback. Fixed (not per-run) so the stack boots without a
# slow per-run `rake secret` / `webpush:generate_vapid_key` call — the VAPID pair
# below was minted once via the pinned image's own `mastodon:webpush:generate_vapid_key`
# (source-free, per the harness design's black-box rule).
RAILS_ENV=production
LOCAL_DOMAIN=mastodon.test
# Let Mastodon federate with the harness nest, whose `nest.test` alias resolves to
# an nginx IP in the compose subnet (a private 172.x address the built-in SSRF
# guard blocks by default). This is the compose network's pinned subnet
# (docker-compose.yml `networks.default.ipam`). Accepts CIDR ranges.
ALLOWED_PRIVATE_ADDRESSES=172.29.71.0/24
# Boot without external services the harness never exercises.
SINGLE_USER_MODE=false
ES_ENABLED=false
# Postgres (the `db` service below).
DB_HOST=db
DB_PORT=5432
DB_NAME=mastodon_production
DB_USER=mastodon
DB_PASS=mastodon
# Redis (the `redis` service below).
REDIS_HOST=redis
REDIS_PORT=6379
# Secrets (throwaway — see header).
SECRET_KEY_BASE=d7dc119ba3a6eccc53bbbfe15d1244994b338a3d1335ff0bd1a9e6e2e4e49b89219ba5aadefd26fb09204257bd656f45e2f3d35af5d2b5c035e8c492acdc26aa
OTP_SECRET=1184d2cdf5450a4cef547f56c55d6bc3a0cd5e738a32a9c635be21884961df08fc7c17383163dbe4441c9fb3e13bbb9255895e47f5fdf6dd9521c9d74a93d1ce
VAPID_PRIVATE_KEY=ND0VXRUd2teR_-FqdDETbz2trHAk8yyjczsOoQINLJM=
VAPID_PUBLIC_KEY=BJJqJXKW75I2gmMq__OOIn-OXlmw0VlvX46A6y0ZgLmYGDukMcIepwn7eFSOwMlPj4zFXp_V8rdVKVFcchE1iLk=
# ActiveRecord::Encryption keys (required since Mastodon 4.3).
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=e636382f8327c9749d8cba3d5284831e
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=a47b321f0e57f36fe01f02258004c389
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=1d5363da67d1132955909855a7f7f1e7
