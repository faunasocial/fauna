# nginx TLS front for the interop harness (rendered per run by the fixture,
# which substitutes __NEST_PORT__ and bind-mounts this at
# /etc/nginx/conf.d/default.conf).
#
# One nginx, two SNI-selected vhosts, both served with per-run test-CA certs:
#   * mastodon.test → the Mastodon web/streaming services on the compose network.
#   * nest.test     → the fauna-nest binary on the HOST, via host-gateway.
#
# Mastodon dials https://nest.test (compose alias → this nginx → host nest); our
# nest dials https://mastodon.test (resolve-override → the loopback-published
# 127.0.0.1:8443 → this nginx → web). Both certs chain to the CA the nest trusts
# (FAUNA_TEST_AP_EXTRA_CA_PEM) and Mastodon trusts (SSL_CERT_FILE / NODE_EXTRA_CA_CERTS).

server {
    listen 443 ssl default_server;
    server_name mastodon.test;

    ssl_certificate     /certs/mastodon.test.crt;
    ssl_certificate_key /certs/mastodon.test.key;

    client_max_body_size 40m;

    location / {
        proxy_pass http://web:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    # The streaming API is a separate Node service; upgrade to WebSocket.
    location /api/v1/streaming {
        proxy_pass http://streaming:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}

server {
    listen 443 ssl;
    server_name nest.test;

    ssl_certificate     /certs/nest.test.crt;
    ssl_certificate_key /certs/nest.test.key;

    client_max_body_size 40m;

    location / {
        # The fauna-nest binary runs on the host; host-gateway routes to it.
        # The nest must bind 0.0.0.0:__NEST_PORT__ (loopback is unreachable
        # across the container boundary). The nest serves its own HTTPS (a
        # public AP domain forces nest-owned TLS — it refuses plain HTTP), so we
        # re-encrypt to it: its cert is the self-signed floor, which nginx does
        # not (and cannot) verify — `proxy_ssl_verify off`. SNI carries the
        # requested `nest.test` so the nest serves that domain's floor leaf.
        proxy_pass https://host.docker.internal:__NEST_PORT__;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_ssl_name $host;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
