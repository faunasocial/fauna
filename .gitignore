# Svelte web app
apps/fauna-web/node_modules/
apps/fauna-web/.svelte-kit/
apps/fauna-web/.cache/
apps/fauna-web/build/
apps/fauna-web/deno.lock
# web/web-test's build-if-stale --stamp (deno task build keeps writing build/ for
# several seconds after reading its source, so the stamp — committed at the
# PRE-run instant — carries freshness, not build/'s own post-run mtime).
apps/fauna-web/.web-build.stamp

# Generator freshness stamps (i18n-generate / providers-generate / ui-ids-generate):
# the generators skip writing unchanged outputs, so the stamp — not the outputs'
# mtimes — carries freshness after a rebase touches only the sources' mtimes.
i18n/.i18n-generate.stamp
i18n/.providers-generate.stamp
tests/e2e-unified/.ui-ids-generate.stamp

# Go binaries
bins/fauna-dns/fauna-dns
bins/fauna-bridge-imap/fauna-bridge
bins/fauna-mail-bridge/fauna-mail-bridge
bins/fauna-mail-bridge/seal-helper-testonly
bins/fauna-mail-bridge/fauna-atproto-bridge

# Windows Rust lock file — VESTIGIAL since 2026-07-22: apps/fauna-windows is no
# longer a separate cargo workspace (unified into the root one), so nothing
# generates this file any more. Kept so a leftover copy in an older checkout
# doesn't show up as untracked noise.
apps/fauna-windows/Cargo.lock

# Fuzz crate lock file (standalone workspace; only root Cargo.lock is tracked)
libs/fauna-mls/fuzz/Cargo.lock
libs/fauna-mls/fuzz/target/

# Windows UniFFI codegen + native dll output (regenerated by `just windows-ffi`)
apps/fauna-windows/FaunaApp/FaunaApp.Core/Generated/uniffi/
apps/fauna-windows/FaunaApp/FaunaApp/runtimes/

# Generated test-fake bases (scripts/generate-windows-fake-bases.py, run as the
# last step of `just windows-ffi` / `_windows-ffi-bindgen` — one abstract
# <X>FakeBase per generated public interface; never stale relative to the
# bindings above since both regenerate together).
apps/fauna-windows/FaunaApp/FaunaApp.Tests/Generated/

# Windows installer build artifacts (the MSI, its wix debug db, + the wix staging
# dir; produced by `release.yml build-windows` / the README clean-build recipe,
# never tracked). `wix build` emits Fauna-Setup-<arch>.wixpdb beside the .msi.
Fauna-Setup-*.msi
Fauna-Setup-*.wixpdb
/stage/

# Debian package build artifacts (`just linux-deb`). `/debian` is a disposable
# copy of apps/fauna-linux/packaging/debian the recipe stages at the repo
# root on demand — dh / dpkg-buildpackage need it at the source-tree root;
# never committed (and never a symlink — dh's staging files must land here,
# not in the tracked source).
/debian
/*.deb
/*.buildinfo
/*.changes

# Android UniFFI codegen + native .so output. Same convention as Windows (above)
# and Apple (below): generated bindings + native libs are never committed.
#
# Staged per buildType since 2026-08-01 (testing.md § convention 15): `just
# android-ffi` builds the PRODUCTION flavor into src/release/ and
# `just android-ffi-test` the `test-helpers` flavor into src/debug/, so
# `assembleRelease` cannot see the e2e seams and `assembleDebug` always can.
# The src/main/ paths below are the retired pre-split slot — kept ignored so a
# checkout that still holds them doesn't surface them as untracked noise.
apps/fauna-android/app/src/debug/jniLibs/
apps/fauna-android/app/src/debug/java/com/fauna/ffi/
apps/fauna-android/app/src/debug/java/uniffi/
apps/fauna-android/app/src/release/jniLibs/
apps/fauna-android/app/src/release/java/com/fauna/ffi/
apps/fauna-android/app/src/release/java/uniffi/
# The storeSafe build type stages exactly like debug/release do (added
# 2026-08-16 with the App-Store escape hatch's android leg). A NEW build type
# needs its own three entries — this list is per-build-type by construction, so
# `src/<type>/` is never covered by a sibling's rule, and the omission is
# silent until a 128 MB `libfauna_ffi.so` reaches a push.
apps/fauna-android/app/src/storeSafe/jniLibs/
apps/fauna-android/app/src/storeSafe/java/com/fauna/ffi/
apps/fauna-android/app/src/storeSafe/java/uniffi/
# The foss build type (F-Droid / direct-download — installers/android.md
# § Goal) stages the same way via `just android-ffi-foss`.
apps/fauna-android/app/src/foss/jniLibs/
apps/fauna-android/app/src/foss/java/com/fauna/ffi/
apps/fauna-android/app/src/foss/java/uniffi/
# The kids build type (Fauna Kids — installers/android.md § Goal) stages its
# own `kids-safe,kids-floor` flavor via `just android-ffi-kids`. Its
# hand-written twin lives beside it under `src/kids/java/com/fauna/app/` and IS
# tracked.
apps/fauna-android/app/src/kids/jniLibs/
apps/fauna-android/app/src/kids/java/com/fauna/ffi/
apps/fauna-android/app/src/kids/java/uniffi/
apps/fauna-android/app/src/main/jniLibs/
apps/fauna-android/app/src/main/java/com/fauna/ffi/
apps/fauna-android/app/src/main/java/uniffi/

# E2E tests
tests/e2e/.venv/
tests/e2e-unified/.venv/
tests/e2e-unified/screenshots/
# Convention 17 layer (b)'s frame corpus — appended by every e2e run in this
# checkout (`helpers/frame_invariants.py::DEFAULT_CORPUS_NAME`), read by grep,
# never committed: it is one session's own evidence and dies with the checkout.
tests/e2e-unified/.frame-invariants.log
# Convention 10's windows focus axis: which tests took the desktop's foreground
# through a bridge fallback (`helpers/foreground_takes.py::CORPUS_NAME`).
tests/e2e-unified/.foreground-takes.log
tests/e2e-unified/test_provisioning.env
__pycache__/
.pytest_cache/

# Nest runtime artifacts (created by E2E test runs and local dev nests)
node.db
node.db-*
node_subscription_mls.db
node_subscription_mls.db-*
claim-code
nest_identity.key
services.json
sidecar-token-*
blobs/

# Kill-interrupted reclaim leftovers. The mac cargo-target cleanup sweep's
# self-trim is rename-then-delete, so a hook-timeout kill mid-`rm` leaves an
# inert `.trim-<pid>-<name>` dir beside its candidate —
# finished on the next pressure pass, but ignored meanwhile so it can never show
# up as untracked work. Apple build state renames beside itself under
# apps/fauna-apple/, i.e. inside the source tree; the cargo classes never do.
.trim-*

# Apple builds
apps/fauna-apple/.build/
apps/fauna-apple/FaunaFFI.xcframework/
apps/fauna-apple/generated/
# Prebuilt-FFI cache stamp (just apple-ffi) — records the cache key the local
# xcframework was built/restored for, so a repeat invocation can fast-path.
apps/fauna-apple/.ffi-cache.stamp
# Records which flavor (full release / host-only debug) the local xcframework was
# built for, so apple-ffi ↔ apple-ffi-host guard the shared-path host↔full switch.
apps/fauna-apple/.ffi-flavor
# Windows twin: records which cargo profile (dev / release / dist) staged the
# shared runtimes/ fauna_ffi.dll, so `windows-ffi` guards the same flavor switch.
apps/fauna-windows/.ffi-flavor
# android-debug's build-if-stale --stamp (Gradle is incremental and leaves a
# no-op assemble's APK mtime untouched, so the stamp carries freshness).
apps/fauna-android/.gradle-debug.stamp
# mac-debug's build-if-stale --stamp (swift build is incremental and leaves a
# no-op product's mtime untouched, so the stamp carries freshness). The sibling
# apple-ffi-host-cargo-*.stamp files live under target/ (gitignored already).
apps/fauna-apple/.mac-debug.stamp
# UniFFI Swift bindings are generated build artifacts (regenerated by
# `just apple-ffi`), not committed — same convention as Android/Windows
# (docs/goal/architecture/build-system.md § UniFFI app bindings). Only the
# hand-written FFICompat.swift in this dir is tracked.
apps/fauna-apple/FaunaFFISwift/Sources/*.swift
!apps/fauna-apple/FaunaFFISwift/Sources/FFICompat.swift
apps/fauna-apple/Fauna-macOS/*.xcodeproj/xcuserdata/
# The thin Fauna.xcodeproj's derived data (`.xcode-build` — the ONE tree both
# `just mac-app` and the tier_3 File Provider test build into; a rebuildable
# build-cache dir, reclaimed like `.build`) plus its auto-generated
# per-user / workspace state (only project.pbxproj is tracked). `.m0-build` /
# `.m2-build` are the retired spike names, still ignored so an old checkout's
# leftovers never show up as untracked.
apps/fauna-apple/.xcode-build/
apps/fauna-apple/.m0-build/
apps/fauna-apple/.m2-build/
apps/fauna-apple/Fauna.xcodeproj/xcuserdata/
apps/fauna-apple/Fauna.xcodeproj/project.xcworkspace/
apps/fauna-apple/Fauna-iOS/*.xcodeproj/xcuserdata/

scratchpad.md


# The derived (test-flavoured) Flatpak manifest — written by
# tests/e2e-unified/helpers/flatpak_manifest.py, never committed: the shipped
# manifest stays the single source of truth.
apps/fauna-linux/packaging/flatpak/social.fauna.fauna.e2e-derived.yml

# Scratch file for `git commit -F` messages. On Windows /tmp resolves to %TEMP%
# rather than the repository, so the message file is written here instead — where
# a `git add -A` would otherwise sweep it into the tree. It has been committed by
# accident more than once; ignoring it is cheaper than remembering not to.
.commitmsg.tmp
