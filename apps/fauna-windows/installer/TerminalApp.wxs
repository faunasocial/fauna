<?xml version="1.0" encoding="UTF-8"?>

<!--
  Fauna terminal app — fauna-tui.exe — and the cli app — fauna-cli.exe.

  The terminal app's channel is the per-OS release archive (fauna-tui +
  fauna-sync-agent + fauna-cli, docs/goal/architecture/installers/tui.md § The
  ratified channel); the MSI additionally carries the SAME binaries so a
  Windows user who installs the package gets them with a trusted signature and
  beside the agent the terminal app drives (user ruling 2026-09-26; the Store
  MSIX does NOT carry them). fauna-cli is the cli app's device shell — Fauna
  operated by an AI assistant over MCP (docs/goal/architecture/apps/cli.md
  § The device shell) — the archive's third member since decision 4 of
  installers/tui.md § Decisions; it rides this feature, never one of its own,
  because the two are one terminal-bound download everywhere.

  Lands in INSTALLFOLDER — beside fauna-sync-agent.exe — because that is how
  the app finds its agent: agent_spawner::agent_binary_absolute resolves the
  sibling first, then PATH. The Sync feature ships the agent; the TerminalApp
  feature (Package.wxs) ships these files. A TerminalApp-without-Sync install
  is legal and runs (the app only needs the agent for the sync pages).

  The PATH entry is what makes an installed terminal app usable from a shell:
  `fauna-tui` (and `fauna-cli`, in the same directory) typed anywhere, not a
  quoted Program Files path. Machine-wide (System="yes") because the install
  is perMachine; Part="last" appends; removed with the component on uninstall
  (WiX removes Environment rows it wrote). Nothing else in the package touches
  PATH. The cli's component carries no Environment row of its own: one
  directory, one entry.
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <ComponentGroup Id="TerminalAppComponents" Directory="INSTALLFOLDER">

      <Component Id="FaunaTuiExe" Guid="4a7b8c00-0060-4d3a-b5c6-d7e8f9a0b1c2">
        <File Id="FaunaTuiExe"
              Source="$(var.TuiBin)"
              KeyPath="yes"
              Name="fauna-tui.exe" />

        <Environment Id="FaunaTuiPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
      </Component>

      <Component Id="FaunaCliExe" Guid="4a7b8c00-0061-4d3a-b5c6-d7e8f9a0b1c3">
        <File Id="FaunaCliExe"
              Source="$(var.CliBin)"
              KeyPath="yes"
              Name="fauna-cli.exe" />
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
