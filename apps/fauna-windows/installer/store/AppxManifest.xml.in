<?xml version="1.0" encoding="utf-8"?>
<!--
  Fauna for Windows — MICROSOFT STORE package (full MSIX).

  This is the Store channel's artifact: a package that CARRIES ITS BINARIES INSIDE,
  which is what earns Store re-signing (no certificate to manage, no SmartScreen
  warning, free). Design of record:
  docs/goal/architecture/installers/windows.md § Store distribution (MSIX).

  ── How this differs from installer/sparse/AppxManifest.xml.in ──
  The sparse package is a manifest-ONLY identity carrier for the MSI-installed shell
  extension: uap10:AllowExternalContent + `Add-AppxPackage -ExternalLocation` point
  it at payload outside the package. That shape cannot be Store-distributed, hence
  this second manifest. Four deliberate divergences, each pinned by
  tests/e2e-unified/tests/platform/windows/test_store_package.py:

    1. No AllowExternalContent — content is internal.
    2. com:Class/@Path is the BARE fauna_shell.dll. Path 1's version-stamped
       filename exists to dodge an MSI's inability to replace a DLL Explorer holds
       open; an MSIX is replaced atomically, so there is no lock to dodge.
    3. A real AppListEntry — this package IS the app (the sparse one suppresses it
       because the MSI already installs the Start-menu shortcut).
    4. Identity/@Name is a token too, not just @Publisher: Partner Center assigns
       BOTH at name reservation, and the Store rejects any mismatch.

  ── THIS IS A TEMPLATE ── The dedicated store-package build script substitutes the four
  double-at tokens and packs the result; the packer hard-fails on any that survive.

    @@IdentityName@@           Partner-Center-reserved package name, minted at name
                               reservation. Reserved 2026-08-22: FaunaSocial.FaunaSocial
                               (the sparse package is FaunaSocial.Fauna, a deliberately
                               distinct identity so both may register on one box).
                               Still a token, never hard-coded: the dev loop registers
                               a plain-DN identity the Store would reject.
    @@Publisher@@              Partner Center's CN=<GUID>. MSIX requires
                               Identity/@Publisher to equal the signing cert Subject
                               DN exactly, and PackageFamilyName hashes from it — a
                               dev-signed package is a DIFFERENT app identity than
                               the Store-signed one. Remove-AppxPackage the dev one;
                               never expect an in-place upgrade across the swap.
    @@PackageVersion@@         4-part MSIX version, read from Package.wxs (one home).
                               Re-registering an unchanged version fails 0x80073CF9.
    @@ProcessorArchitecture@@  x64 or arm64. A full MSIX carries native binaries, so
                               each of the two packages we ship declares its own.

  ── Store uploads are UNSIGNED ── the Store signs. The build script's self-sign
  flag exists only for the local dev loop.
  (No "‑‑" digraph anywhere in this comment: XML forbids it inside a comment, so
  flags are named in prose rather than written out.)
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  IgnorableNamespaces="uap rescap desktop desktop4 desktop5 com">

  <Identity Name="@@IdentityName@@"
            Publisher="@@Publisher@@"
            Version="@@PackageVersion@@"
            ProcessorArchitecture="@@ProcessorArchitecture@@" />

  <Properties>
    <!-- MUST equal a name reserved for this product in Partner Center, which
         validates it at package upload. "Fauna" was unavailable (another
         publisher holds it), so the reservation, and therefore this value, is
         "Fauna Social".
         The APP's own name stays "Fauna" (Application/VisualElements below):
         priority 1 says a Store name-availability accident must not leak a
         naming divergence into the app UI, where Fauna is "Fauna" on all seven
         apps. Only the Store LISTING carries the longer name. -->
    <DisplayName>Fauna Social</DisplayName>
    <PublisherDisplayName>Fauna Social</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>

    <!-- NO write-virtualization opt-out, deliberately (user directive 2026-08-23).
         Packaged apps get AppData write virtualization by default, so this package
         writes to its own private %LocalAppData%\Fauna. That is fine, and the
         opt-out that used to sit here is gone.

         What it bought: one shared %LocalAppData%\Fauna across a Store install and
         an MSI install, i.e. coexistence with MSI-installed components plus
         MSI to Store migration. What it cost: `unvirtualizedResources`, a RESTRICTED
         capability, and the hand-written justification certification stops to read.
         With no MSI installs in the field, it served nobody and was dropped.

         Nothing breaks on a Store-only box: app, sync agent and shell extension all
         run under package identity and share one virtualized view. The one path
         that would escape it, extract_icons() handing Explorer a literal
         %LocalAppData%\Fauna\icons (shell-ext/src/lib.rs), is inert here: its only
         consumer is the icon overlay handler, which an MSIX package cannot register
         (it needs an HKLM key).

         Re-adding either the scoped virtualization:ExcludedDirectory form or the
         blanket desktop6 switch is a goal-doc decision, not a manifest edit:
         installers/windows.md section Data continuity. Pinned by
         test_store_package.py::test_declares_no_write_virtualization_opt_out. -->
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <!-- The MSIX packaging floor, matching the sparse package. The Win11 DEFAULT
         context menu only renders from 22000, but everything else here (the app,
         fauna://, the logon sync agent) works below that, so the floor is not the
         menu's. -->
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- runFullTrust ONLY. It is a restricted capability, but it is the standard
       desktop-bridge one every full-trust Win32 Store app declares. Anything beyond
       it is an unusual justification a human must write; see the Properties comment
       for why unvirtualizedResources is no longer among them. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="FaunaApp"
                 Executable="App\FaunaApp.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <!-- Deliberately "Fauna", NOT the Store listing name: this is the Start
           menu / taskbar / Alt+Tab label, and it matches the other six apps.
           Unlike Properties/DisplayName it is not reservation-validated. -->
      <uap:VisualElements DisplayName="Fauna"
                          Description="Fauna — your files, your nest."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- fauna://setup-complete?url=… — the manifest twin of Protocol.wxs's
             HKLM\SOFTWARE\Classes\fauna key, which a Store app cannot write. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="fauna">
            <uap:DisplayName>Fauna Protocol</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- The per-user sync agent's logon launch, replacing ServiceSync.wxs's
             HKLM\…\CurrentVersion\Run value (also unwritable by a Store app).
             Enabled="true" is honoured for full-trust desktop apps once the app has
             been launched once; from then on the user owns the switch in Task
             Manager's Startup tab — a better affordance than the Run key ever had. -->
        <desktop:Extension Category="windows.startupTask"
                           Executable="fauna-sync-agent.exe"
                           EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="FaunaSyncAgent"
                               Enabled="true"
                               DisplayName="Fauna Sync Agent" />
        </desktop:Extension>

        <!-- The Win11 default context menu. Clsid is the EXISTING root
             IExplorerCommand CLSID (FaunaContextMenu) that ShellExt.wxs registers
             as *\shell\Fauna's ExplorerCommandHandler and the sparse package also
             names — a THIRD registration surface for one implementation, never a
             9th COM class. The submenu's children come from the handler's
             EnumSubCommands, so only the root verb appears here. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="Fauna" Clsid="4A7B8C10-F1E2-4D3A-B5C6-D7E8F9A0B1C2" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="Fauna" Clsid="4A7B8C10-F1E2-4D3A-B5C6-D7E8F9A0B1C2" />
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory\Background">
              <desktop5:Verb Id="Fauna" Clsid="4A7B8C10-F1E2-4D3A-B5C6-D7E8F9A0B1C2" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <!-- Registers the CLSID in the MANIFEST instead of the registry; Explorer
             activates it out-of-process via the COM surrogate (dllhost.exe), which
             is what carries package identity into the handler. Unlike the sparse
             package, @Path resolves INSIDE the package, so it is the bare
             build-output name. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Fauna Shell Extension">
              <com:Class Id="4A7B8C10-F1E2-4D3A-B5C6-D7E8F9A0B1C2"
                         Path="fauna_shell.dll"
                         ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
