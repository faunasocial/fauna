<?xml version="1.0" encoding="UTF-8"?>

<!-- Directory layout for Fauna installation — the directories BOTH packages use
     (the full-feature ../Package.wxs and the nest MSI's nest/Package.wxs). The
     client-only ones live in the client fragment that uses them (App.wxs: the app
     folder and the Start menu folder; ServiceSync.wxs: the sync data folder), so
     the nest MSI links none of them. -->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <!-- Program Files\Fauna\ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Fauna" />
    </StandardDirectory>

    <!-- System32 — working directory for the full-feature package's custom
         actions (../Package.wxs). Always exists, unlike INSTALLFOLDER on a first
         install. -->
    <StandardDirectory Id="System64Folder" />

    <!-- ProgramData\Fauna\ — per-service data directories -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="FaunaDataFolder" Name="Fauna">
        <Directory Id="NestDataFolder" Name="nest" />
        <Directory Id="BridgeDataFolder" Name="bridge" />
      </Directory>
    </StandardDirectory>
  </Fragment>

</Wix>
