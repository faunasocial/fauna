<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- FaunaApp's runtime ids (see FaunaApp.csproj): a `-r` publish restores this
         referenced project for the same id, so its lockfile carries the same sections. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RootNamespace>FaunaApp.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- UniFFI-generated bindings use unsafe pointers for FFI marshalling
         (RustBuffer, RustCallStatus). Required by Generated/uniffi/. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <!-- Opt-in e2e automation flavor — see FaunaApp.csproj for the full rationale.
       Mirrored here because Core carries one seam forwarder of its own
       (OnboardingViewModel.CallMachineMethod), and MSBuild does not propagate a
       DefineConstants added in a referencing project. -->
  <PropertyGroup Condition="'$(FaunaE2eAgent)'=='true'">
    <DefineConstants>$(DefineConstants);FAUNA_E2E_AGENT</DefineConstants>
  </PropertyGroup>
  <!-- ── The `payments` compile condition — see FaunaApp.csproj for the full
       rationale. Mirrored here for the same reason FAUNA_E2E_AGENT is: MSBuild
       does not propagate a DefineConstants added in a referencing project, and
       Core is where the whole payments glue lives (INestRpcClient's payments
       region, NestRpcClient's FfiPaymentsClient calls, ProfileViewModel's §4/§5
       state, SubscriptionsSettingsViewModel). `/p:FaunaStoreSafe=true` is a
       GLOBAL property, so it does reach this project through the reference. ── -->
  <PropertyGroup Condition="'$(FaunaStoreSafe)'!='true'">
    <DefineConstants>$(DefineConstants);PAYMENTS</DefineConstants>
  </PropertyGroup>
  <!-- ── The `p2p-share` condition — its own define because `p2p-share` is its own
       registry member, not a subset of `payments` (one condition per member,
       dynamic-features.md § Platform-family surface excision). Core carries the
       offline-share ceremony doors (INestRpcClient / NestRpcClient). ── -->
  <PropertyGroup Condition="'$(FaunaStoreSafe)'!='true'">
    <DefineConstants>$(DefineConstants);P2P_SHARE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Canonical IPLD dag-cbor codec for the Windows named-pipe IPC wire
         (DagCbor.cs / IpcMessages.cs). Ctap2Canonical conformance mode gives
         the dag-cbor key sort + shortest-form + definite-length rules. -->
    <PackageReference Include="System.Formats.Cbor" Version="10.0.12" />
  </ItemGroup>
  <!-- UniFFI emits all generated types as `internal`. FaunaApp.Core is where the
       proxy ViewModel lives; the FaunaApp WinUI assembly needs to read those
       internals through XAML x:Bind generated code, so expose internals to it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FaunaApp" />
    <InternalsVisibleTo Include="FaunaApp.Tests" />
  </ItemGroup>
  <!-- C# bindings generated by `just windows-ffi` from libs/uniffi-bindgen-cs/
       are at Generated/uniffi/*.cs and picked up by the SDK's default Compile
       glob. Directory is gitignored; missing means the recipe hasn't run yet.

       NB: a build entry point OTHER than `just windows-debug`/`-release` (a direct
       `dotnet test`, an IDE build) does NOT regenerate these, so after a rebase
       that changed fauna-ffi (or a re-exported sibling crate) the on-disk bindings
       are stale and this project fails to compile (a new type "could not be
       found") — run `just windows-ffi` to heal. An in-build self-healing pre-build
       target was evaluated and rejected: it must invoke the bash-based `just`
       recipe, but the win build environment exposes `sh`/`bash`/`just` only inside
       Git Bash — never on the cmd/PowerShell/MSBuild/IDE PATH — so an `<Exec>` would
       break every build not launched from Git Bash. The robust home for the regen
       is a win SessionStart hook (runs in the Git Bash context, fires after the
       startup rebase), mirroring the analogous hook on the Linux dev machine. See
       docs/goal/architecture/build-system.md § UniFFI app bindings. -->
</Project>
