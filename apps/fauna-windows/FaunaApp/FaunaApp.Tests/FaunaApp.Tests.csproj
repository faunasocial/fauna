<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The windows TFM + Windows App SDK reference exist for one reason:
         KnockToastBuilderTests builds a real AppNotification payload
         (notifications.md § Localized body → The knock toast). No WinUI is
         loaded: unpackaged, framework-dependent, and with the MRT tooling off
         (its PriGen target fails under plain `dotnet` — MSB4062). Only the
         Windows gate compiles this project. -->
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <!-- Framework-dependent: the generated module initializer resolves the
         installed Windows App Runtime so the builder's WinRT classes activate. -->
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- ── The `payments` compile condition — see FaunaApp.csproj for the full
       rationale. Mirrored here because the payments view-model tests
       (SubscriptionsSettingsViewModelTests, ProfileViewModelTests' §4/§5 cases,
       MockNestRpcClient's payments arm) name types that a store-safe build does
       not have. dynamic-features.md § The feature-matrix test story: both flavors
       build and run their test subset, so this project has to compile in the
       excised flavor too. ── -->
  <PropertyGroup Condition="'$(FaunaStoreSafe)'!='true'">
    <DefineConstants>$(DefineConstants);PAYMENTS</DefineConstants>
  </PropertyGroup>
  <!-- The `p2p-share` condition, mirrored for MockNestRpcClient's ceremony arm. -->
  <PropertyGroup Condition="'$(FaunaStoreSafe)'!='true'">
    <DefineConstants>$(DefineConstants);P2P_SHARE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- The exact version FaunaApp.csproj pins (bump round 7, item B). -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FaunaApp.Core\FaunaApp.Core.csproj" />
  </ItemGroup>
  <!-- The knock toast's payload builder, linked in without the WinUI project. -->
  <ItemGroup>
    <Compile Include="..\FaunaApp\Services\KnockToastBuilder.cs" Link="Linked\KnockToastBuilder.cs" />
  </ItemGroup>
  <!-- CryptoServiceTests P/Invoke into [DllImport("fauna_ffi")] generated by
       `just windows-ffi`. Pull the same dll from the FaunaApp runtimes folder
       so tests don't need a separate copy step. Other tests use mocks and
       don't load it. -->
  <ItemGroup Condition="'$(Platform)'=='ARM64' or '$(RuntimeIdentifier)'=='win-arm64' or Exists('..\FaunaApp\runtimes\win-arm64\native\fauna_ffi.dll')">
    <Content Include="..\FaunaApp\runtimes\win-arm64\native\fauna_ffi.dll" Condition="Exists('..\FaunaApp\runtimes\win-arm64\native\fauna_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fauna_ffi.dll</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(Platform)'=='x64' or '$(RuntimeIdentifier)'=='win-x64'">
    <Content Include="..\FaunaApp\runtimes\win-x64\native\fauna_ffi.dll" Condition="Exists('..\FaunaApp\runtimes\win-x64\native\fauna_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fauna_ffi.dll</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
