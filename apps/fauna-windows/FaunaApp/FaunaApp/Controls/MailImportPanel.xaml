<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Controls.MailImportPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Panel_Loaded"
    Unloaded="Panel_Unloaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!-- User-facing mail-import wizard (docs/goal/behavior/mailbox-migration.md § UX
         shape / § Wizard steps / § Credential handling): a five-step wizard
         (Source → Scope → Confirm → Progress → Done) that pulls a person's existing
         mail off a foreign IMAP server and into their own nest. Dumb renderer of the
         shared fauna_client_mail_settings::MailImportMachine (exposed over UniFFI by
         build_mail_import_machine) — the wizard FSM lives in shared Rust (priority #2).
         Lifts apps/fauna-linux/src/settings/mail_import.rs and mirrors this app's own
         MailExportPanel.

         Unlike the export twin the backend is REAL end to end, so Connect/Start/Pause/
         Resume/Cancel drive a genuine import_sessions row against a genuine foreign
         IMAP source; a rejection is a real answer routed onto the host page's
         error-message, never a fake-green.

         All five steps' mail-import-* elements live in one tree, shown conditionally by
         step, so every ui.yaml ID is statically present. The step gating is ALSO what
         keeps the shared wizard-back-button / wizard-next-button ids unique: Scope
         carries Back+Next and Confirm carries Back, so two of each id exist in markup
         and exactly one of each is addressable at a time. A Collapsed element is absent
         from the UIA tree entirely (not merely offscreen), so the non-Source groups are
         Collapsed HERE, in markup, rather than being left visible until the first
         render hides them — that build-to-first-hydrate window would otherwise have two
         of each id addressable, a real flake. -->
    <StackPanel Spacing="12">

        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                   Text="{loc:Localize Key=mail_import/title}" />
        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                   Text="{loc:Localize Key=mail_import/description}" />

        <ProgressRing x:Name="LoadingRing"
                      IsActive="False" Visibility="Collapsed"
                      HorizontalAlignment="Left" />

        <!-- ════ Step 1 — Source ════ -->
        <StackPanel x:Name="SourceGroup" Spacing="8">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="{loc:Localize Key=mail_import/source_title}" />

            <!-- mail-import-source-picker — 4-way provider picker (driver.select, which
                 matches a ComboBoxItem by its exact UIA Name). Its ItemsSource is filled
                 from the shared importSourceKindLabel in code-behind rather than hard-coded
                 ComboBoxItems: the exportFormatLabel precedent, so a seventh app cannot
                 hand-roll a sixth copy of the same four-arm vocabulary. -->
            <ComboBox x:Name="SourcePicker"
                      AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourcePicker}"
                      AutomationProperties.Name="Source"
                      SelectionChanged="SourcePicker_SelectionChanged" />

            <!-- Gmail / iCloud: app password + the provider's help line. -->
            <PasswordBox x:Name="AppPasswordInput"
                         AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourceAppPassword}"
                         Header="{loc:Localize Key=mail_import/source_app_password_label}" />
            <TextBlock x:Name="AppPasswordHelp"
                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

            <!-- Outlook only: Sign in with Microsoft (mailbox-migration.md § Microsoft
                 sign-in — the device-code grant). Dispatches the shared
                 MicrosoftSignInActions; once Microsoft has answered with a code the code
                 row below paints it beside Open in browser, and the grant connects by
                 itself. Inert while the deployment has no registration or a sign-in is
                 under way. -->
            <Button x:Name="OauthButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourceOauthButton}"
                    Content="{loc:Localize Key=mail_import/source_oauth_button}"
                    Click="Oauth_Click" />
            <!-- mail-import-source-oauth-code: the sentence carries the address and the
                 code; its `code` and `url` attributes ride each alone, packed into
                 HelpText as the flaui bridge reads them (PackedAttr). -->
            <StackPanel x:Name="OauthCodeRow" Visibility="Collapsed"
                        Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="OauthCode"
                           AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourceOauthCode}"
                           VerticalAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <Button Click="OauthOpenBrowser_Click"
                        Content="{loc:Localize Key=mail_import/microsoft_open_browser}" />
            </StackPanel>
            <TextBlock x:Name="OauthNote" Visibility="Collapsed"
                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

            <!-- Generic IMAP. -->
            <TextBox x:Name="HostInput"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourceHost}"
                     PlaceholderText="{loc:Localize Key=mail_import/source_host_placeholder}" />
            <TextBox x:Name="PortInput"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourcePort}"
                     PlaceholderText="{loc:Localize Key=mail_import/source_port_placeholder}" />
            <ComboBox x:Name="TlsModePicker"
                      AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourceTlsMode}"
                      AutomationProperties.Name="TLS mode"
                      SelectionChanged="TlsModePicker_SelectionChanged" />
            <TextBox x:Name="UsernameInput"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourceUsername}"
                     PlaceholderText="{loc:Localize Key=mail_import/source_username_placeholder}" />
            <PasswordBox x:Name="PasswordInput"
                         AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourcePassword}"
                         PlaceholderText="{loc:Localize Key=mail_import/source_password_placeholder}" />

            <Button x:Name="ConnectButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportConnectButton}"
                    Style="{StaticResource AccentButtonStyle}"
                    Content="{loc:Localize Key=mail_import/connect_button}"
                    Click="Connect_Click" />

            <!-- The remembered source (mailbox-migration.md § Credential handling → The
                 remembered source): offered for every provider while the account holds a
                 saved source; ForgetSource deletes the record and resets these fields. -->
            <Button x:Name="ForgetSourceButton"
                    Visibility="Collapsed"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourceForgetButton}"
                    Content="{loc:Localize Key=mail_import/source_forget_button}"
                    Click="ForgetSource_Click" />
        </StackPanel>

        <!-- ════ Step 2 — Scope ════ -->
        <StackPanel x:Name="ScopeGroup" Spacing="8" Visibility="Collapsed">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="{loc:Localize Key=mail_import/scope_title}" />

            <TextBlock Opacity="0.7"
                       Text="{loc:Localize Key=mail_import/scope_mailboxes_label}" />

            <!-- mail-import-scope-mailboxes — multi-select container. Border-wrapped with
                 a non-empty Name + non-virtualizing panel so FlaUI realizes it and every
                 row (a bare layout root carrying only an AutomationId is pruned from the
                 UIA tree, and a virtualizing panel only realizes what is on screen). -->
            <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportScopeMailboxes}"
                    AutomationProperties.Name="Mailboxes"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="MailboxesEmpty" Opacity="0.5" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Text="{loc:Localize Key=mail_import/scope_mailboxes_empty}" />
                    <ItemsControl x:Name="MailboxesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MailImportMailboxRow">
                                <!-- The indexed mail-import-scope-mailbox-item. A CheckBox,
                                     not a Border: it is a real control, so it keeps its own
                                     automation peer, its Content gives get_text the mailbox
                                     name, and click drives it through TogglePattern rather
                                     than a foreground-dependent physical mouse click. It
                                     carries NO static AutomationProperties.Name — that would
                                     win over the Content-derived one and freeze get_text.
                                     HelpText is the `state` attribute the cross-app walk
                                     reads; Click (not Checked/Unchecked) fires only on user
                                     action, so the OneTime IsChecked bind never echoes a
                                     dispatch back. -->
                                <CheckBox AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportScopeMailboxItem}"
                                          AutomationProperties.HelpText="{x:Bind State}"
                                          Content="{x:Bind Name}"
                                          IsChecked="{x:Bind Selected}"
                                          Tag="{x:Bind Name}"
                                          Click="Mailbox_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBox x:Name="DateFromInput"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportScopeDateFrom}"
                     PlaceholderText="{loc:Localize Key=mail_import/scope_date_from_placeholder}" />
            <TextBox x:Name="MaxSizeInput"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportScopeMaxSize}"
                     Header="{loc:Localize Key=mail_import/scope_max_size_label}" />

            <!-- Informational only: no MailImportAction changes the destination mapping,
                 and the goal doc names no control for it either (§ Wizard steps step 3 —
                 mailboxes map 1:1 by name, unmatched names are created). -->
            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportScopeMailboxMapping}"
                       Opacity="0.7" TextWrapping="Wrap"
                       Text="{loc:Localize Key=mail_import/scope_mailbox_mapping_label}" />

            <!-- mail-import-scope-import-duplicates-toggle (§ Opt-out per session): off by
                 default, the label carries the double-storage warning itself. A CheckBox
                 like the mailbox rows: Click fires only on user action, and HelpText is the
                 `state` attribute read from the snapshot (RenderState), never a click echo. -->
            <CheckBox x:Name="ImportDuplicatesToggle"
                      AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportScopeImportDuplicatesToggle}"
                      AutomationProperties.HelpText="off"
                      Click="ImportDuplicates_Click">
                <TextBlock TextWrapping="Wrap"
                           Text="{loc:Localize Key=mail_import/scope_import_duplicates_label}" />
            </CheckBox>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.WizardBackButton}"
                        Content="{loc:Localize Key=mail_import/back}" Click="Back_Click" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.WizardNextButton}"
                        Content="{loc:Localize Key=mail_import/next}" Click="ScopeNext_Click" />
            </StackPanel>
        </StackPanel>

        <!-- ════ Step 3 — Confirm ════ -->
        <StackPanel x:Name="ConfirmGroup" Spacing="8" Visibility="Collapsed">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="{loc:Localize Key=mail_import/confirm_title}" />
            <TextBlock x:Name="ConfirmSummary"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportConfirmSummary}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.WizardBackButton}"
                        Content="{loc:Localize Key=mail_import/back}" Click="Back_Click" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportStartButton}"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{loc:Localize Key=mail_import/start_button}"
                        Click="Start_Click" />
            </StackPanel>
        </StackPanel>

        <!-- ════ Step 4 — Progress ════ -->
        <StackPanel x:Name="ProgressGroup" Spacing="8" Visibility="Collapsed">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="{loc:Localize Key=mail_import/progress_title}" />
            <TextBlock x:Name="ProgressSummary"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportProgressSummary}"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="ImportProgressBar"
                         AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportProgressBar}"
                         Minimum="0" Maximum="1" />

            <!-- The restart-resume credential prompt (mailbox-migration.md § Wizard steps
                 step 5, § Resume protocol step 2): painted while an adopted session needs
                 the source credential again. The Source step's own ids, as every app
                 paints them — SourceGroup is Collapsed on Progress, so each id is unique
                 in the UIA tree. Gmail/iCloud: the app password; Generic: port, connection
                 security and password; Outlook: the sentence alone (Resume re-asks). -->
            <StackPanel x:Name="ResumeCredentialGroup" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="ResumeNeedsText" TextWrapping="Wrap" />
                <PasswordBox x:Name="ResumeAppPasswordInput"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourceAppPassword}"
                             Header="{loc:Localize Key=mail_import/source_app_password_label}" />
                <TextBox x:Name="ResumePortInput"
                         AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourcePort}"
                         PlaceholderText="{loc:Localize Key=mail_import/source_port_placeholder}" />
                <ComboBox x:Name="ResumeTlsModePicker"
                          AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourceTlsMode}"
                          AutomationProperties.Name="TLS mode"
                          SelectionChanged="ResumeTlsModePicker_SelectionChanged" />
                <PasswordBox x:Name="ResumePasswordInput"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportSourcePassword}"
                             PlaceholderText="{loc:Localize Key=mail_import/source_password_placeholder}" />
            </StackPanel>

            <!-- The full-mailbox notice (§ Failure handling → Nest-side errors): shown while
                 the session is paused with pauseReason MailboxFull; Resume and Cancel are the
                 buttons below, Skip the rest is its own. -->
            <StackPanel x:Name="QuotaGroup" Spacing="8" Visibility="Collapsed">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportQuotaNotice}"
                           TextWrapping="Wrap"
                           Text="{loc:Localize Key=mail_import/quota_notice}" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportQuotaSkipRestButton}"
                        Content="{loc:Localize Key=mail_import/quota_skip_rest_button}"
                        Click="SkipRest_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PauseButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportPauseButton}"
                        Content="{loc:Localize Key=mail_import/pause_button}"
                        Click="Pause_Click" />
                <Button x:Name="ResumeButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportResumeButton}"
                        Content="{loc:Localize Key=mail_import/resume_button}"
                        Click="Resume_Click" />
                <Button x:Name="CancelButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportCancelButton}"
                        Content="{loc:Localize Key=mail_import/cancel_button}"
                        Click="Cancel_Click" />
            </StackPanel>
            <!-- A second row, so the longer labels never push a button off the edge of
                 the page (an off-screen button is not actionable). -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Offered only while the snapshot lists a rebuilt source mailbox
                     (UIDVALIDITY changed); the press drops those cursors and resumes. -->
                <Button x:Name="RestartButton"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportRestartButton}"
                        Content="{loc:Localize Key=mail_import/restart_button}"
                        Click="Restart_Click" />
                <!-- A failed import's one control (§ A failed import is a record the wizard
                     shows until the user moves on): Dismiss returns to Source. -->
                <Button x:Name="DismissButton"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportDismissButton}"
                        Content="{loc:Localize Key=mail_import/dismiss_failed_button}"
                        Click="Dismiss_Click" />
            </StackPanel>
            <TextBlock Opacity="0.7" FontSize="12"
                       Text="{loc:Localize Key=mail_import/error_log_title}" />
            <TextBlock x:Name="ErrorLog"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportErrorLog}"
                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

            <!-- mail-import-mailbox-progress-list — per-mailbox rows, one per mailbox
                 the run takes. The view model paints them from the shared machine's
                 snapshot mailboxProgress through ImportMailboxProgressText. -->
            <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportMailboxProgressList}"
                    AutomationProperties.Name="Mailbox progress"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <ItemsControl x:Name="MailboxProgressList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MailImportMailboxProgressRow">
                            <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportMailboxProgressListItem}"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Padding="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportMailboxProgressListItemName}"
                                               Text="{x:Bind Name}" />
                                    <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportMailboxProgressListItemProgress}"
                                               Text="{x:Bind Progress}" Opacity="0.7" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- ════ Step 5 — Done ════ -->
        <StackPanel x:Name="DoneGroup" Spacing="8" Visibility="Collapsed">
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="{loc:Localize Key=mail_import/done_title}" />
            <TextBlock x:Name="DoneSummary"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportDoneSummary}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportViewImportedButton}"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{loc:Localize Key=mail_import/view_imported_button}"
                        Click="ViewImported_Click" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportReviewSkippedButton}"
                        Content="{loc:Localize Key=mail_import/review_skipped_button}"
                        Click="ReviewSkipped_Click" />
            </StackPanel>
            <!-- Review skipped reveals the run's skip log here (§ Wizard steps step 6). The
                 heading and the log collapse together; the log shares the Progress log's id
                 (only one of the two groups is ever visible). -->
            <StackPanel x:Name="DoneErrorLogGroup" Spacing="8" Visibility="Collapsed">
                <TextBlock Opacity="0.7" FontSize="12"
                           Text="{loc:Localize Key=mail_import/error_log_title}" />
                <TextBlock x:Name="DoneErrorLog"
                           AutomationProperties.AutomationId="{x:Bind ids:Ids.MailImportErrorLog}"
                           Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
