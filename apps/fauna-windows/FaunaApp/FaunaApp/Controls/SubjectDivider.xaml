<UserControl
    x:Class="FaunaApp.Controls.SubjectDivider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ids="using:FaunaApp.UiIds">
    <!--
        AutomationId on the inner Grid, with Background + Name, so UIA
        includes it in the Content view. UserControl-only AutomationId
        gets dropped when the divider is hosted inside another
        UserControl-shaped container (MessagesList → page).
    -->
    <Grid Padding="16,8" ColumnSpacing="8"
          AutomationProperties.AutomationId="{x:Bind ids:Ids.SubjectDivider}"
          AutomationProperties.Name="Subject divider"
          Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" x:Name="SubjectText" Opacity="0.7" FontStyle="Italic" />
        <Border Grid.Column="2" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center" />
    </Grid>
</UserControl>
