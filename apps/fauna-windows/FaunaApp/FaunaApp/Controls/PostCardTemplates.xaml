<?xml version="1.0" encoding="utf-8"?>
<!--
  The post-card — ONE template for every page that paints a post as the feed does:
  the feed page's post list and the profile page's Posts tab (ui/profile.md § Layout &
  flow → The Posts tab: "the post-card component with every child it has on the feed …
  in identical paint"; ui.yaml `post-card` used_in [feed, profile]). Lifted verbatim
  from FeedPage.xaml's inline ItemTemplate, never copied.

  A ResourceDictionary with code-behind, so x:Bind and the template's event handlers
  compile here: each handler forwards to the PostCardHost (Feed/PostCardHost.cs) of
  the list the card sits in, which acts on that list's own feed manager — the
  timeline on the feed page, the author window on the profile. A page uses it by
  merging this dictionary and setting its ListView's ItemTemplate to
  {StaticResource PostCardTemplate}.
-->
<ResourceDictionary
    x:Class="FaunaApp.Controls.PostCardTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:helpers="using:FaunaApp.Helpers"
    xmlns:corehelpers="using:FaunaApp.Core.Helpers"
    xmlns:feed="using:FaunaApp.Feed"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:ids="using:FaunaApp.UiIds">

    <helpers:SourceToColorConverter x:Key="SourceToColor" />
    <helpers:HexColorToBrushConverter x:Key="HexBrush" />
    <helpers:TagChipTextConverter x:Key="TagChipText" />

    <DataTemplate x:Key="PostCardTemplate" x:DataType="vm:FeedPostItem">
        <!-- Outer wrapper: the post-card id/Name stay here so count("post-card")
             is unaffected by ANY withholding arm (topic-factors.md § Scoring — a
             mute collapses everywhere; family-safety.md § Content policy — a
             blocked post names the policy rather than disappearing; mirrors the
             dm-message-muted precedent). The accessible Name must never leak a
             muted / collapsed / BLOCKED body into the a11y tree, so it is computed
             from the render gates rather than bound to BodyText directly. IsMuted
             is read once at construction (FeedManager::is_muted — a manager query,
             not persistence); Revealed is session-local render state mutated in
             place on THIS instance (Reconcile excludes it from ContentEquals, so an
             unrelated re-sync tick never resets an already-revealed post); the
             content-policy reveal instead lives in ContentPolicyCache's id-keyed
             set, which survives a rebuild into a new item. -->
        <!-- The post-card root is a transparent Button so `click post-card`
             opens post_detail (PostCard_Click): a bare Grid/StackPanel root has
             no UIA invoke pattern (reference_winui_clickable_row_needs_button_root,
             event-card/addressbook-item/media-item idiom). The id + accessible
             Name live on the Button, so count("post-card")/get_text are
             unaffected. Unlike event-card, the card's interactive children stay
             NESTED inside (not moved out as siblings): the feed e2e scopes
             load-remote-content-button + feed-post-actions-button under
             `post-card[i]`, and a scoped lookup is confined to this element's own
             subtree (flaui-bridge/ElementFinder.cs WalkScope). Each nested child
             keeps its own InvokePattern so FlaUI drives it directly; the Button's
             Invoke opens the detail without double-firing (Invoke is direct, not
             pointer-routed). Padding=0 so the inner rows keep their own padding.
             HelpText is the card's post id — the `post` attr linux stamps on its
             row, so a test reads which post a card renders off the card itself
             (actions/feed.py `_post_id_of_card`), never by text or state order. -->
        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.PostCard}"
                AutomationProperties.Name="{x:Bind feed:PostCardBind.PostCardAccessibleName(RegionAccessibleNotice, NestAccessibleNotice, ShowContentBlockedNotice, ContentBlockedNoticeText, ShowMutedCollapse, ShowContentCollapse, BodyText), Mode=OneWay}"
                AutomationProperties.HelpText="{x:Bind PostId}"
                Tag="{x:Bind}" Click="PostCard_Click"
                Loaded="PostCard_Loaded" Unloaded="PostCard_Unloaded"
                Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- REGION placeholder (region-blocking.md § The blocked render and
                 the transparency surface): the app's frame naming the region and
                 its authority, the authority's name, and its reason VERBATIM, in
                 place of the body. Painted AHEAD of every family/muted arm
                 (SocialRenderGate's RegionWithheld, checked first); a `collapse`
                 adds the reveal, which shares the content-policy reveal set, a
                 `block` has none. Shares Grid.Row 0 with the family block — the
                 arms are exclusive. Each DataTemplate element carries a Name as
                 well as its AutomationId, or UIA prunes it
                 (reference_winui_flaui_datatemplate_name). The panel's Loaded /
                 Unloaded feed convention 17's painted side
                 (RegionPlaceholder_Loaded). -->
            <StackPanel Grid.Row="0" Spacing="4" Padding="8,12"
                        Tag="{x:Bind}"
                        Loaded="RegionPlaceholder_Loaded" Unloaded="RegionPlaceholder_Unloaded"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowRegionPlaceholder), Mode=OneWay}">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.RegionBlockedNotice}"
                           AutomationProperties.Name="{x:Bind RegionNoticeText}"
                           Text="{x:Bind RegionNoticeText}"
                           FontStyle="Italic" Opacity="0.6" FontSize="12"
                           TextWrapping="Wrap" />
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.RegionBlockedAuthority}"
                           AutomationProperties.Name="{x:Bind RegionAuthority}"
                           Text="{x:Bind RegionAuthority}"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.RegionBlockedReason}"
                           AutomationProperties.Name="{x:Bind RegionReason}"
                           Text="{x:Bind RegionReason}"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RegionCollapsedRevealButton}"
                        Content="{loc:Localize Key=region/reveal_button}"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowRegionReveal), Mode=OneWay}"
                        HorizontalAlignment="Left" Padding="8,2" FontSize="12"
                        Tag="{x:Bind}" Click="RegionRevealButton_Click" />
            </StackPanel>

            <!-- NEST placeholder (nest-rules.md § The nest source in the engine;
                 § Element IDs): a rule of the nest this post was read through
                 withholds it — the app's frame naming the nest
                 (`nest-blocked-notice`, its `verdict` attribute on HelpText),
                 the nest's domain, and the admin's reason VERBATIM, in place of
                 the body. The region placeholder's twin and checked right after
                 it (SocialRenderGate's NestWithheld); a `collapse` adds the
                 reveal, which shares the content-policy reveal set, a `block`
                 has none (never loosenable). Same Grid.Row 0 — the arms are
                 exclusive. The panel's Loaded / Unloaded feed convention 17's
                 nest twin (NestPlaceholder_Loaded). -->
            <StackPanel Grid.Row="0" Spacing="4" Padding="8,12"
                        Tag="{x:Bind}"
                        Loaded="NestPlaceholder_Loaded" Unloaded="NestPlaceholder_Unloaded"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowNestPlaceholder), Mode=OneWay}">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.NestBlockedNotice}"
                           AutomationProperties.Name="{x:Bind NestNoticeText}"
                           AutomationProperties.HelpText="{x:Bind NestVerb}"
                           Text="{x:Bind NestNoticeText}"
                           FontStyle="Italic" Opacity="0.6" FontSize="12"
                           TextWrapping="Wrap" />
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.NestBlockedDomain}"
                           AutomationProperties.Name="{x:Bind NestDomain}"
                           Text="{x:Bind NestDomain}"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.NestBlockedReason}"
                           AutomationProperties.Name="{x:Bind NestReason}"
                           Text="{x:Bind NestReason}"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.NestCollapsedRevealButton}"
                        Content="{loc:Localize Key=nest_rules/reveal_button}"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowNestReveal), Mode=OneWay}"
                        HorizontalAlignment="Left" Padding="8,2" FontSize="12"
                        Tag="{x:Bind}" Click="NestRevealButton_Click" />
            </StackPanel>

            <!-- Content-policy BLOCK (family-safety.md § Content policy): the
                 policy-naming notice paints in place of the body, with NO reveal
                 affordance — a blocked item never silently disappears, and it can
                 never be revealed past the guardian's floor. Checked ahead of both
                 collapse arms by FeedPostItem.RenderArm (the shared
                 SocialRenderGate the conversation bubble also uses), so a post
                 that is both blocked and muted stays blocked.
                 `content-policy-blocked-notice` (indexed, per post-card) carries
                 `state="blocked"` on HelpText, the attribute the collapse arm below
                 paints as `collapsed`. A DataTemplate element carrying only an
                 AutomationId is UIA-pruned, so Name carries the notice text too
                 (reference_winui_flaui_datatemplate_name). -->
            <StackPanel Grid.Row="0" Spacing="4" Padding="8,12"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowContentBlockedNotice), Mode=OneWay}">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ContentPolicyBlockedNotice}"
                           AutomationProperties.Name="{x:Bind ContentBlockedNoticeText}"
                           AutomationProperties.HelpText="blocked"
                           Text="{x:Bind ContentBlockedNoticeText}"
                           FontStyle="Italic" Opacity="0.6" FontSize="12"
                           TextWrapping="Wrap" />
                <!-- The guardian rule's reason VERBATIM beside the fixed frame
                     (`content-policy-blocked-reason`, nest-rules.md § The shared
                     rule editor → The reason is the member's to read): absent
                     (Collapsed, no UIA peer) when a floor, the viewer's own
                     threshold or a report drove the verdict. -->
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ContentPolicyBlockedReason}"
                           AutomationProperties.Name="{x:Bind GuardianReasonText}"
                           Text="{x:Bind GuardianReasonText}"
                           Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowGuardianReason)}"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="4" Padding="8,12"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowMutedCollapse), Mode=OneWay}">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedPostMuted}"
                           Text="{loc:Localize Key=muted_words/collapsed}"
                           FontStyle="Italic" Opacity="0.6" FontSize="12" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedPostMutedRevealButton}"
                        Content="{loc:Localize Key=muted_words/reveal}"
                        HorizontalAlignment="Left" Padding="8,2" FontSize="12"
                        Tag="{x:Bind}" Click="MutedRevealButton_Click" />
            </StackPanel>

            <!-- Content-policy COLLAPSE: a placeholder + one-tap session-local
                 reveal (its own reveal set, keyed on the post id in
                 ContentPolicyCache — NOT the muted arm's per-instance flag).
                 The placeholder is the block arm's `content-policy-blocked-notice`
                 in `state="collapsed"` (HelpText), beside
                 `content-policy-collapsed-reveal-button` (ids user-approved
                 2026-10-16; tui leads). A collapse can come from the guardian's
                 floor or the viewer's own threshold, so the text stays neutral. -->
            <StackPanel Grid.Row="2" Spacing="4" Padding="8,12"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowContentCollapse), Mode=OneWay}">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ContentPolicyBlockedNotice}"
                           AutomationProperties.Name="{loc:Localize Key=family/content_collapsed_notice}"
                           AutomationProperties.HelpText="collapsed"
                           Text="{loc:Localize Key=family/content_collapsed_notice}"
                           FontStyle="Italic" Opacity="0.6" FontSize="12"
                           TextWrapping="Wrap" />
                <!-- The collapse arm's guardian reason — the block arm's twin. -->
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ContentPolicyBlockedReason}"
                           AutomationProperties.Name="{x:Bind GuardianReasonText}"
                           Text="{x:Bind GuardianReasonText}"
                           Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowGuardianReason)}"
                           Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.ContentPolicyCollapsedRevealButton}"
                        AutomationProperties.Name="{loc:Localize Key=family/content_reveal_button}"
                        Content="{loc:Localize Key=family/content_reveal_button}"
                        HorizontalAlignment="Left" Padding="8,2" FontSize="12"
                        Tag="{x:Bind}" Click="ContentRevealButton_Click" />
            </StackPanel>

        <Grid Grid.Row="3" Padding="8,12" ColumnSpacing="12" RowSpacing="4"
              Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowNormalContent), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Author + time -->
            <StackPanel Grid.Row="0" Grid.Column="0"
                        Orientation="Horizontal" Spacing="8">
                <!-- `click post-author → profile` (id stays type: text); a
                     borderless HyperlinkButton so UIA offers Invoke. -->
                <HyperlinkButton Content="{x:Bind AuthorLabel}"
                                 AutomationProperties.AutomationId="{x:Bind ids:Ids.PostAuthor}"
                                 Click="PostAuthor_Click"
                                 Padding="0" MinHeight="0"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                 FontWeight="SemiBold" FontSize="13" />
                <!-- REPOST ROW attribution marker (feed.md § Interaction bar →
                     Repost, ratified 2026-08-10; id user-approved 2026-08-11): the ONLY affordance a repost row's
                     own card carries — its own interaction bar is hidden below
                     and PostCard_Click opens the ORIGINAL's detail instead. A
                     Border carrying only an AutomationId is UIA-pruned, so Name
                     carries the marker text too
                     (reference_winui_flaui_datatemplate_name). -->
                <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.RepostAttribution}"
                        AutomationProperties.Name="{loc:Localize Key=feed/post/reposted_marker}"
                        CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(IsRepostRow), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Key=feed/post/reposted_marker}"
                                   FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- Gated-post badge (feed.md § Encryption at rest; monetization.md
                     § Pillars 2+3): the tier name, shown iff the post is gated to a
                     tier — or, for a room-restricted post whose floor this reader is
                     on, the room's own label instead (GatedBadgeText; ui/feed.md
                     § Encryption at rest → Room-restricted — the card, (c)). The list
                     card body stays the public teaser; the full body unseals on
                     detail open. The Border carries the badge text as its
                     AutomationProperties.Name so FlaUI both COUNTS it (a bare
                     AutomationId-only Border is pruned) and returns it via
                     get_text (reference_winui_flaui_datatemplate_name) — the
                     content-label-badge pattern below. -->
                <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.GatedPostBadge}"
                        AutomationProperties.Name="{x:Bind GatedBadgeText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind GatedBadgeTooltip, Mode=OneWay}"
                        CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(HasGatedBadge), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="9" VerticalAlignment="Center" Opacity="0.7" />
                        <TextBlock Text="{x:Bind GatedBadgeText, Mode=OneWay}" FontSize="10"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Sold-post buyer teaser (gap (2c), monetization.md § Per-post
                     pay-to-unlock): the price, the optional external payment link and
                     the buy affordance, on the badge's row. Inside the payments plane
                     (dynamic-features.md § Platform-family surface excision → The
                     price-and-route class), so its markup lives in
                     Views/Payments/SoldPostTeaser.xaml and this host is filled from
                     code only, under `#if PAYMENTS`, exactly like TipDisplayHost
                     below (whose comments say why Loaded and why no element of the
                     plane may be named here). A store-safe build shows a sold post as
                     an ordinary gated post: the badge above, nothing more. -->
                <ContentControl x:Name="SoldPostTeaserHost" VerticalAlignment="Center"
                                Loaded="SoldPostTeaserHost_Loaded" />

                <!-- The tip display surface (monetization.md § Tips) — excised in a
                     store-safe build (dynamic-features.md § Platform-family surface
                     excision). The markup lives in
                     Views/Payments/PostTipDisplay.xaml, the removable build item
                     (XAML has no #if); this DataTemplate itself paints every
                     non-payments post-card element too, so it can't be the excision
                     unit. A `<payments:PostTipDisplay/>` element here would fail to
                     compile once FaunaApp.csproj drops Views\Payments\**, so this
                     always-present ContentControl is filled from code only —
                     PostCardHost's ContainerContentChanging, under
                     `#if PAYMENTS`. -->
                <!-- ⚠ Loaded, NOT the page's ContainerContentChanging. That event
                     belongs to ListViewBase's PHASED-RENDERING path, which only runs
                     under a virtualizing ItemsPanel — and this list deliberately
                     overrides ItemsPanel to a plain StackPanel (see its own comment
                     above). So the host was never filled and none of the ids this
                     surface paints ever entered the UIA tree: the whole per-card
                     plane was invisible from the moment it moved out here — and
                     this comment must not name those ids, since the store-safe
                     excision gate reads markup text and a .xaml has no #if to hide
                     behind.
                     Loaded fires per realized container under ANY panel, which is
                     exactly what a non-recycling list needs; the page's post-Reconcile
                     RefreshCardPayments covers the later re-bind that recycling would
                     otherwise have driven. The handler is declared unconditionally
                     (XAML resolves it at compile time and has no #if), with only its
                     body under PAYMENTS. -->
                <ContentControl x:Name="TipDisplayHost" VerticalAlignment="Center"
                                Loaded="TipDisplayHost_Loaded" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1"
                        Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{x:Bind TimeAgo}" Opacity="0.5"
                           FontSize="12" VerticalAlignment="Center" />
                <!-- Per-card ⋯ overflow (topic-factors.md § Authoring surface):
                     hosts the "more/less like this" training verbs. The
                     dm-message-actions-button precedent applied to posts — its
                     MenuFlyout (feed-post-actions-menu) is built imperatively in
                     BuildPostActionsMenu per the post's current example marker +
                     the feed's in-context training target. Always-enabled (a
                     disabled WinUI button can't be FlaUI-Invoked,
                     reference_windows_disabled_button_no_invoke) — training applies
                     to any post, no capability gate. -->
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedPostActionsButton}"
                        Tag="{x:Bind}" Click="PostActionsButton_Click"
                        Content="&#xE712;" FontFamily="Segoe MDL2 Assets"
                        FontSize="10" Padding="4,2" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="{loc:Localize Key=feed/post_actions_tooltip}" />
            </StackPanel>

            <!-- Body: walked from the shared RenderDocument (render-model.md
                 § D6) via DocumentPainter — the SAME painter the conversations
                 bubble uses — so bold/italic/headings/links render structurally,
                 not as raw markdown. A blocked remote image in the body reveals
                 via the per-card load-remote-content-button (html-mail Slice 3;
                 same posture + i18n strings as conversations + the linux/web legs). -->
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="2">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedPostText}"
                           helpers:FeedPostBodyBind.Item="{x:Bind}"
                           TextWrapping="Wrap" MaxLines="6" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.LoadRemoteContentButton}"
                        Content="{loc:Localize Key=conversations/detail/load_remote_content}"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(HasBlockedRemoteImage), Mode=OneWay}"
                        HorizontalAlignment="Left" Padding="8,2" FontSize="12"
                        Click="LoadRemoteContent_Click" />
            </StackPanel>

            <!-- Body remote images (render-model.md § D3 + § Implementation
                 status; apps/tui.md § Rendering): one `doc-remote-image` per
                 RenderBlock::RemoteImage, painted just under the body — the SAME
                 "own element ID ⇒ painted by the page" rule post-image/quoted-post/
                 link-preview-card already follow. DocumentRenderer's body walker
                 arm is inert for RemoteImage; RemoteImagesBind (the
                 FeedPostBodyBind twin) paints this panel imperatively since a
                 ListView DataTemplate can't reach a row's panel declaratively. -->
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                        helpers:RemoteImagesBind.Item="{x:Bind}" />

            <!-- Content label badge (spam/phishing/NSFW) — the highest-confidence
                 entry of PostSummary.labels, styled entirely from the shared
                 content_label_style map (icon/label/tint/accent; moderation.md
                 § Per-row badge data path). No hard-coded category strings/colours;
                 the tint background applies windows' own low-alpha treatment
                 (ConverterParameter=38 ≈ 15%, mirroring web/android's per-app
                 low-alpha convention). -->
            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.ContentLabelBadge}"
                    AutomationProperties.Name="{x:Bind ContentLabelText, Mode=OneWay}"
                    CornerRadius="4" Padding="4,1"
                    Background="{x:Bind ContentLabelTint, Converter={StaticResource HexBrush}, ConverterParameter=38, Mode=OneWay}"
                    Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(HasContentLabel), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="{x:Bind ContentLabelIcon, Mode=OneWay}" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ContentLabelText, Mode=OneWay}" FontSize="10"
                               Foreground="{x:Bind ContentLabelAccent, Converter={StaticResource HexBrush}, Mode=OneWay}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Post image: visible once MediaHashHex resolves via BlobImageLoader.
                 AutomationId + Click sit on the wrapping Button (never bare Tapped
                 on the Image), so FlaUI drives it via UIA InvokePattern instead of
                 falling back to physical SendInput — the SAME nested-Button-inside-
                 post-card idiom load-remote-content-button/feed-post-actions-button
                 already use below, and required here: a bare Image.Tapped measured
                 2026-09-07 reliably hit SendInput's "Access is denied" off-foreground.
                 The Button starts Collapsed and ImageHashBind.VisibilityTarget (not
                 an x:Bind on the hash string) flips it once the async fetch actually
                 resolves — gating on the hash alone let automation click the button
                 before Source was set, silently no-op'ing (post-card's own click
                 would then win instead, opening post_detail unexpectedly). feed.md
                 § Element IDs, image-lightbox: five other apps already open the
                 lightbox from this same list-card image.
                 A bridged post's picture (render-model.md § D6c) has no hash: it is
                 the nest-relative MediaProxiedPath, fetched with the session bearer.
                 It is the one case where the Button shows before a picture has
                 loaded — behind PostImagePlaceholder, with the path as its
                 automation Name until the bytes land (they may never: the remote
                 host can be gone), so the slot stays addressable. PostImage_Click
                 opens the lightbox only for a loaded bitmap, so a click on the
                 placeholder does nothing. -->
            <Button x:Name="PostImageButton" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PostImage}"
                    Click="PostImage_Click"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                    Margin="0,4,0,4"
                    Visibility="Collapsed">
                <Grid>
                    <Border x:Name="PostImagePlaceholder" Width="160" Height="100" CornerRadius="4"
                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                            Visibility="Collapsed">
                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="24" Opacity="0.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image MaxHeight="300" Stretch="Uniform"
                           helpers:ImageHashBind.VisibilityTarget="{x:Bind PostImageButton, Mode=OneTime}"
                           helpers:ImageHashBind.Placeholder="{x:Bind PostImagePlaceholder, Mode=OneTime}"
                           helpers:ImageHashBind.Hash="{x:Bind MediaHashHex, Mode=OneWay}"
                           helpers:ImageHashBind.Home="{x:Bind BlobHome, Mode=OneWay}"
                           helpers:ImageHashBind.ProxiedPath="{x:Bind MediaProxiedPath, Mode=OneWay}"
                           helpers:ImageHashBind.Loader="{x:Bind feed:PostCardBind.GetImageLoader(), Mode=OneTime}" />
                </Grid>
            </Button>
            <!-- C2PA provenance badge (media.md § C2PA provenance): overlays the
                 post image's bottom-right corner once PostCardHost.Sync's
                 fire-once trigger resolves the `x-c2pa` header (the SAME
                 authenticated blob GET post-image's own load performs — no extra
                 request) and sets HasC2pa on this row. Same corner placement +
                 glyph as windows' own conversations DmMessageBubble.BuildC2paBadge. -->
            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.C2paBadge}"
                    AutomationProperties.Name="{x:Bind C2paLabel}"
                    ToolTipService.ToolTip="{x:Bind C2paTooltip}"
                    Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(HasC2pa), Mode=OneWay}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,4,8,8" CornerRadius="12" Padding="6,2"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind C2paLabel}" FontSize="10"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <!-- Link-preview cards (render-model.md § D4): the producer folds a
                 LinkPreview block after EACH standalone bare-URL paragraph (the inline
                 link stays in the body), so a post can carry SEVERAL; this paints one
                 card per resolved preview, in body order, from the shared
                 LinkPreviewCardModel list. Until 2026-08-02 windows painted only the
                 first (a FirstOrDefault twin) — the lone-outlier gap in
                 render-model.md § Implementation status; the other six apps always
                 iterated. An ItemsControl with no cards renders nothing, which is what
                 replaces the old HasLinkPreviewCard visibility gate.
                 A DataTemplate layout Border with only an AutomationId is UIA-pruned,
                 so bind a non-empty Name (the title, always present on a resolved card)
                 to keep link-preview-card discoverable for FlaUI (memory
                 reference_winui_flaui_datatemplate_name). The og:image
                 (link-preview-image) is reveal-gated per D4 (user-ratified 2026-06-27):
                 blocked-by-default like a body RemoteImage until the post's
                 load-remote-content-button reveals it. The click-to-open +
                 post-detail-dialog render remain deferred. -->
            <!-- ItemsSource is OneWay (FeedPostItem is an ObservableObject), but every
                 binding INSIDE the template is OneTime: LinkPreviewCardModel is an
                 immutable record that raises no notifications, so OneWay there is a
                 no-op the XAML compiler flags (WMC1506). A card changes by the post
                 item being rebuilt (ContentEquals → replace), which re-runs the
                 template — never by a property notification on the card itself. -->
            <ItemsControl Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                          ItemsSource="{x:Bind LinkPreviewCards, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="corehelpers:LinkPreviewCardModel">
                        <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.LinkPreviewCard}"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneTime}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Padding="8" Margin="0,4,0,0" CornerRadius="4">
                            <StackPanel Spacing="2">
                                <!-- og:image (link-preview-image): reveal-gated per D4
                                     (user-ratified 2026-06-27) — blocked-by-default like a body
                                     RemoteImage. Visibility is owned by the card's ShowImage (the
                                     post's reveal state), NOT by ImageHashBind
                                     (ManageVisibility=False): so a tier_2 load failure (no real
                                     nest blob) leaves the revealed element realized for the e2e,
                                     and the blob is never fetched before reveal (Hash is "" until
                                     then). A real blob paints it in tier_3+/prod. The one per-post
                                     load-remote-content-button reveals body images + every card's
                                     og:image together (shared has_blocked_remote_images /
                                     set_remote_images_revealed). -->
                                <Image AutomationProperties.AutomationId="{x:Bind ids:Ids.LinkPreviewImage}"
                                       MaxHeight="200" Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch" Margin="0,0,0,2"
                                       Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(ShowImage), Mode=OneTime}"
                                       helpers:ImageHashBind.ManageVisibility="False"
                                       helpers:ImageHashBind.Hash="{x:Bind ImageHash, Mode=OneTime}"
                                       helpers:ImageHashBind.Loader="{x:Bind feed:PostCardBind.GetImageLoader(), Mode=OneTime}" />
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.LinkPreviewTitle}"
                                           Text="{x:Bind Title, Mode=OneTime}"
                                           FontSize="13" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.LinkPreviewDescription}"
                                           Text="{x:Bind Description, Mode=OneTime}"
                                           FontSize="12" Opacity="0.8"
                                           TextWrapping="Wrap" MaxLines="3" />
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.LinkPreviewDomain}"
                                           Text="{x:Bind Domain, Mode=OneTime}"
                                           FontSize="11" Opacity="0.6" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Video thumbnail (video-thumbnail): the D6b `Video` sibling of `Image`
                 (render-model.md § Implementation status today) — painted from the
                 folded `RenderBlock.Video` (VideoBlock), the twin of
                 MediaHashHex/post-image. No poster frame exists to paint
                 (`MediaItem.thumbnail`/`dimensions` are `None` from every writer,
                 deliberately) — a play glyph + the hash as text. Since inline
                 playback (§ D6c → Inline playback) the element is the player host:
                 controls:VideoThumbnailView swaps the glyph, on a tap, for WinUI's
                 MediaPlayerElement in the same slot, off the shared playback_source for
                 the bound VideoBlock — never autoplay — and publishes
                 state/position/source through its automation peer. It names itself
                 from the block (an unnamed DataTemplate element is UIA-pruned — memory
                 reference_winui_flaui_datatemplate_name).
                 A bridged post's `ProxiedVideo` (render-model.md § D6c → Proxied
                 video) is the block of this same element: the glyph + its
                 nest-relative path, never byte-loaded before the tap, and played off
                 the ticketed path playback_source answers for it. PostId routes the
                 player's progress to the engagement-cue capture (CueViewportObserver
                 .NotePlayed, the tracker-held peak), so a video played to its end
                 derives the media watch-complete. -->
            <controls:VideoThumbnailView Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                         Margin="0,4,0,0"
                                         AutomationProperties.AutomationId="{x:Bind ids:Ids.VideoThumbnail}"
                                         Block="{x:Bind VideoBlock, Mode=OneWay}"
                                         Home="{x:Bind BlobHome, Mode=OneWay}"
                                         PostId="{x:Bind PostId}"
                                         Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(HasVideo), Mode=OneWay}" />
            <!-- Quoted-post embed (render-model.md § D6). A bare layout Border inside a
                 DataTemplate that sets only AutomationId is pruned from the UIA tree, so
                 FlaUI's scoped is_visible("quoted-post", scope="post-card[i]") finds 0 even
                 when realized (memory reference_winui_flaui_datatemplate_name) — bind a
                 non-empty Name (the quoted author, always present when HasQuotedPost) to
                 keep it discoverable, exactly as post-card binds Name to its body text. -->
            <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.QuotedPost}"
                    AutomationProperties.Name="{x:Bind QuotedPostAccessibleName, Mode=OneWay}"
                    Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(HasQuotedPost), Mode=OneWay}"
                    BorderThickness="3,0,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Padding="8,4" Margin="0,4,0,0" CornerRadius="4">
                <StackPanel Spacing="2">
                    <!-- Author + unverified-source header. Hidden for a legal-takedown
                         tombstone (moderation.md § Categories & enforcement item 1): the
                         nest withheld the envelope, so author is empty and only the shared
                         tombstone (QuotedPostDisplayBody below) is shown — mirrors web
                         QuotedPost.svelte omitting the header on the `legal_takedown_ref` arm. -->
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(QuotedPostShowHeaderRow), Mode=OneWay}">
                        <TextBlock Text="{x:Bind QuotedPostAuthor, Mode=OneWay}"
                                   FontSize="11" FontWeight="SemiBold" Opacity="0.7"
                                   VerticalAlignment="Center" />
                        <!-- Slice 2b: unverified-source badge on the quoted embed iff the
                             quoted post's OWN verification FAILED (security.md § Client display
                             of unverified content). Reuses the unverified-source-badge ID,
                             scoped under the quoted-post component (no new ID). -->
                        <Border CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.UnverifiedSourceBadge}"
                                AutomationProperties.Name="{x:Bind UnverifiedSourceLabel}"
                                ToolTipService.ToolTip="{x:Bind UnverifiedSourceTooltip}"
                                Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(QuotedPostIsUnverified), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind UnverifiedSourceLabel}" FontSize="10"
                                           Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- The quoted embed's OWN D10 audit marker, scoped
                             under quoted-post (no new ID), same
                             Delegated-only rule as the card badge above. -->
                        <Border CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                                Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.DelegatedOriginBadge}"
                                AutomationProperties.Name="{x:Bind DelegatedOriginLabel}"
                                ToolTipService.ToolTip="{x:Bind DelegatedOriginTooltip}"
                                Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(QuotedPostIsDelegatedOrigin), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind DelegatedOriginLabel}" FontSize="10"
                                           Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind QuotedPostDisplayBody, Mode=OneWay}"
                               FontSize="12" TextWrapping="Wrap" MaxLines="3" />
                </StackPanel>
            </Border>

            <!-- Source badges: one protocol-badge per classified post source
                 (shared fauna-feed classifier; color keyed off the stable id,
                 label from the canonical shared label — feed.md § Where logic lives).
                 ItemsControl's default StackPanel is non-virtualizing, so every
                 badge realizes a UIA peer for the count-based e2e. -->
            <ItemsControl Grid.Row="8" Grid.Column="0" Margin="0,2,0,0"
                          HorizontalAlignment="Left"
                          ItemsSource="{x:Bind SourceBadges}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PostSourceBadge">
                        <Border CornerRadius="4" Padding="4,1"
                                Background="{x:Bind Id, Converter={StaticResource SourceToColor}}"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.ProtocolBadge}"
                                AutomationProperties.Name="{x:Bind Label}">
                            <!-- Shared SourceGlyph emoji (render-model.md § D5) + the
                                 canonical label, matching web's "{emoji} {label}" pill.
                                 The emoji renders in color via the default font's Segoe
                                 UI Emoji fallback (no white override, no symbol font). -->
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <TextBlock Text="{x:Bind Glyph}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind Label}" FontSize="10" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Unverified-source indicator: a muted badge shown iff THIS
                 client's own envelope verification of the post FAILED
                 (security.md § App display of unverified content). Never
                 fires on the feed-list projection (Unchecked — the home-nest
                 index card carries no signed envelope), so it's wired uniformly
                 but lights only on decode paths; the post still renders in full.
                 Right-aligned in the badge row, opposite the source badges. -->
            <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Spacing="4"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,2,0,0">
                <Border CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.UnverifiedSourceBadge}"
                        AutomationProperties.Name="{x:Bind UnverifiedSourceLabel}"
                        ToolTipService.ToolTip="{x:Bind UnverifiedSourceTooltip}"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(IsUnverifiedSource), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind UnverifiedSourceLabel}" FontSize="10"
                                   Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- The D10 audit marker (`delegated-origin-badge`,
                     atproto-pds-full.md § Problem 1 → D10 → *Audit*): an
                     external app wrote this post as the account, under the
                     delegation the AT Protocol page's row governs. Trails the
                     unverified badge, the order every app paints these two
                     in.

                     Shown iff the origin is DELEGATED. `Unknown` covers
                     verification-FAILED as well as never-decoded, and it
                     must stay un-badged: reading origin off an envelope
                     that did not verify would let a forgery paint itself as
                     "merely delegated", inverting the audit surface this
                     badge IS. -->
                <Border CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.DelegatedOriginBadge}"
                        AutomationProperties.Name="{x:Bind DelegatedOriginLabel}"
                        ToolTipService.ToolTip="{x:Bind DelegatedOriginTooltip}"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(IsDelegatedOrigin), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind DelegatedOriginLabel}" FontSize="10"
                                   Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Folded archive comments (archive-import.md § Placement under the
                 owner's own post): owner-only context under an imported post, one
                 `post-archive-comment-item` ("author: text") per shared
                 PostSummary.archive_comments entry. The container carries a Name
                 so UIA realizes it (an unnamed DataTemplate element is pruned);
                 each item is a named Border for the same reason. -->
            <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                        Margin="0,4,0,0" Padding="8,0,0,0" Spacing="2"
                        BorderThickness="2,0,0,0"
                        BorderBrush="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.PostArchiveComments}"
                        AutomationProperties.Name="archive comments"
                        Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(HasArchiveComments)}">
                <ItemsControl ItemsSource="{x:Bind ArchiveComments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ArchiveCommentLine">
                            <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.PostArchiveCommentItem}"
                                    AutomationProperties.Name="{x:Bind Display}">
                                <TextBlock Text="{x:Bind Display}" FontSize="12" Opacity="0.7"
                                           TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Interaction buttons: icon + interaction count (count hidden at 0,
                 a clean icon-only button until the post has activity), quote on
                 all seven apps (feed.md § Interaction bar, ratified 2026-06-27).
                 Counts bind PostSummary.{like,reply,repost,quote}_count. Like and
                 repost are TOGGLEs through FfiFeedManager::like/repost
                 (viewer_liked/viewer_repost_id drive the lit AccentButtonStyle);
                 reply/quote still fire the generic fauna.posts.interact (client
                 glue, feed.md § User actions). The WHOLE bar is hidden on a REPOST
                 ROW (IsRepostRow — its own counters are structurally dark; feed.md
                 § Interaction bar → Repost, ratified 2026-08-10) — see repost-attribution above, the only affordance such a
                 row's card carries. Each button's Name says what it paints (verb +
                 the count only while shown — FeedPostItem.LikeButtonName). -->
            <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Spacing="12" Margin="0,4,0,0"
                        Visibility="{x:Bind feed:PostCardBind.HideOnRepostRow(IsRepostRow), Mode=OneWay}">
                <Button Tag="{x:Bind PostId}" Click="LikeButton_Click" Padding="4,2"
                        Style="{x:Bind feed:PostCardBind.LikedToButtonStyle(ViewerLiked)}"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedLikeButton}"
                        AutomationProperties.Name="{x:Bind LikeButtonName}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="{x:Bind LikeCount}" FontSize="12"
                                   Visibility="{x:Bind feed:PostCardBind.CountToVisibility(LikeCount)}" />
                    </StackPanel>
                </Button>
                <Button Tag="{x:Bind PostId}" Click="ReplyButton_Click" Padding="4,2"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedReplyButton}"
                        AutomationProperties.Name="{x:Bind ReplyButtonName}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="&#xE97A;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="{x:Bind ReplyCount}" FontSize="12"
                                   Visibility="{x:Bind feed:PostCardBind.CountToVisibility(ReplyCount)}" />
                    </StackPanel>
                </Button>
                <Button Tag="{x:Bind PostId}" Click="RepostButton_Click" Padding="4,2"
                        Style="{x:Bind feed:PostCardBind.RepostedToButtonStyle(ViewerRepostId)}"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedRepostButton}"
                        AutomationProperties.Name="{x:Bind RepostButtonName}"
                        ToolTipService.ToolTip="{loc:Localize Key=feed/post/repost}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="{x:Bind RepostCount}" FontSize="12"
                                   Visibility="{x:Bind feed:PostCardBind.CountToVisibility(RepostCount)}" />
                    </StackPanel>
                </Button>
                <Button Tag="{x:Bind PostId}" Click="QuoteButton_Click" Padding="4,2"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedQuoteButton}"
                        AutomationProperties.Name="{x:Bind QuoteButtonName}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock Text="{x:Bind QuoteCount}" FontSize="12"
                                   Visibility="{x:Bind feed:PostCardBind.CountToVisibility(QuoteCount)}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Reaction pills (feed.md § Layout & flow → Reaction posts count and
                 paint, ruling 4; ids user-approved 2026-11-01): one `post-reaction-pill` button per emoji group of the
                 shared tally, in the nest's order, UNDER the interaction bar,
                 scoped in `post-card[i]`. Text/Name = "emoji count"; the viewer's
                 own is lit (AccentButtonStyle, the like button's idiom) and says
                 `state=on` on HelpText. Tap → the shared FeedManager.react. Absent
                 on a repost row (ReactionPills is empty there) and, from the shared
                 fold, on a bluesky row. Always-enabled Buttons with a Name, or
                 FlaUI counts 0 (reference_windows_disabled_button_no_invoke,
                 reference_winui_flaui_datatemplate_name). -->
            <ItemsControl Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                          HorizontalAlignment="Left" Margin="0,4,0,0"
                          ItemsSource="{x:Bind ReactionPills}"
                          Visibility="{x:Bind feed:PostCardBind.BoolToVisibility(HasReactionPills)}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PostReactionPill">
                        <Button Click="ReactionPill_Click" Padding="8,2" FontSize="12"
                                Content="{x:Bind Label}"
                                Style="{x:Bind feed:PostCardBind.LikedToButtonStyle(Own)}"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.PostReactionPill}"
                                AutomationProperties.Name="{x:Bind Label}"
                                AutomationProperties.HelpText="{x:Bind State}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Tags: an ItemsControl so ALL tags render (was a 5-slot static
                 x:Bind cap that truncated post 5 — linux's append_tag_chips and
                 this page's own post-detail dialog already render every tag
                 uncapped). Mirrors the SourceBadges ItemsControl above. -->
            <ItemsControl Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                          HorizontalAlignment="Left"
                          ItemsSource="{x:Bind Tags}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind Converter={StaticResource TagChipText}}"
                                   AutomationProperties.AutomationId="{x:Bind ids:Ids.TagChip}"
                                   FontSize="11" Opacity="0.4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
