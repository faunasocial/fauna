<?xml version="1.0" encoding="utf-8"?>
<!--
  One bridge's card — the shared `bridge-card` component (ui.yaml `bridge-card`:
  bridge-action-button + settings rows + follows). Extracted 2026-07-31 from the
  inline DataTemplate that lived in BridgesPage.xaml, so a SECOND surface can embed
  the identical widget tree: the AT Protocol page's Linked-account panel
  (ui/atproto.md § Layout & flow item 3 — "reused verbatim from the Bridges page …
  zero new IDs").

  windows is the last app to make this extraction; every sibling did it first and
  the concept is deliberately the same on all seven (priority #1/#3) — linux
  `build_bridge_detail_content`, apple `BridgeCardContent`, web `BridgeCard.svelte`,
  android's `internal` BridgeCard, tui `embed_bridge_card`.

  ⚠ THE LINK BUTTON GATES ON `linked`, NEVER ON DECLARED LINK MODES. web's own
  extraction surfaced that gap: a card that hides its action button when the
  provider declares no link modes makes the AT Protocol page's synthetic pre-fetch
  panel silently vanish instead of rendering an honest surface (ui/atproto.md:42).
  windows was already on the right side of it — the button is unconditional here
  and must stay that way.

  The visual tree is byte-for-byte the one BridgesPage rendered before the
  extraction, with one mechanical change: the per-row text/name/label are assigned
  in code-behind (OnBridgeChanged) rather than by x:Bind, because a UserControl in
  a DataTemplate binds against ITSELF, not the item. That also keeps the
  AutomationProperties.Name assignment explicit — without a Name, FlaUI reports a
  DataTemplate row's count/is_visible as 0 (memory
  reference_winui_flaui_datatemplate_name).
-->
<UserControl
    x:Class="FaunaApp.Controls.BridgeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ids="using:FaunaApp.UiIds">

    <Grid x:Name="Root" Padding="12" ColumnSpacing="12"
          AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeCard}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="NameText"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.6">
            <Run x:Name="IdentityRun" />
            <Run Text=" " />
            <Run x:Name="ModeRun" Foreground="{ThemeResource SystemAccentColor}" />
        </TextBlock>

        <Button Grid.RowSpan="2" Grid.Column="1" x:Name="ActionButton"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeActionButton}"
                Click="ActionButton_Click"
                VerticalAlignment="Center">
            <Button.Content>
                <TextBlock x:Name="ActionText" />
            </Button.Content>
        </Button>

        <!-- Metadata-driven settings rows (bridges.md § Bridge settings) — built imperatively in Render(), one row per
             BridgeSetting, since the set/shape varies per bridge and per nest
             version (a newer nest can add a setting_type this build predates).
             No ui.yaml ids of its own: these ride the shared bridge-card
             component, same as every sibling app's settings loop (tui
             setting_elements / web BridgeCard.svelte / linux
             build_settings_group / android SettingRow / apple
             BridgeCardContent). -->
        <StackPanel x:Name="SettingsPanel" Grid.Row="2" Grid.ColumnSpan="2"
                    Spacing="4" Margin="0,8,0,0" />

        <!-- Follows list -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFollowsList}"
                    AutomationProperties.Name="bridge-follows-list"
                    Visibility="Collapsed">
            <ListView SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- Literal ids — this DataTemplate has no x:DataType, so
                             `{x:Bind ids:Ids.…}` silently drops here; see
                             Controls/RecipientPicker.xaml. -->
                        <Grid Padding="4" ColumnSpacing="8"
                              AutomationProperties.AutomationId="bridge-follow-item"
                              AutomationProperties.Name="{Binding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="bridge-follow-remove"
                                    Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                    FontSize="10" Padding="4,2" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeAddFollowButton}"
                    Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                    Padding="6,2" HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Why linking is unavailable, painted BESIDE the (disabled) action button
             on the card itself — not only inside the link dialog, which a user with
             a disabled button can never open. bridges.md § Errors & edge cases.
             AutomationId but deliberately NO AutomationProperties.Name: this is a
             get_text target, and a static Name makes FlaUI return the Name instead
             of the text (memory reference_windows_flaui_gettext_dynamic_label_no_name). -->
        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" x:Name="LinkBlockedReason"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeLinkBlockedReason}"
                   Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!-- Feed-subscription shim (bridge-feed-subscriptions / bridge-feed-item /
             bridge-subscribe-feed-button) retired 2026-06-29 per bridges.md
             § Layout & flow: subscription is the Feed page's bridge-form-* surface
             (Feed-only decision, ratified 2026-06-28), not the bridge card's. -->
    </Grid>
</UserControl>
