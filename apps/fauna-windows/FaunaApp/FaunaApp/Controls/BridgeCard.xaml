<?xml version="1.0" encoding="utf-8"?>
<!--
  One bridge's card — the shared `bridge-card` component (ui.yaml `bridge-card`:
  bridge-action-button + settings rows + follows + follow requests). Extracted 2026-07-31 from the
  inline DataTemplate that lived in BridgesPage.xaml, so a SECOND surface can embed
  the identical widget tree: the AT Protocol page's Linked-account panel
  (ui/atproto.md § Layout & flow item 3 — "reused verbatim from the Bridges page …
  zero new IDs").

  windows is the last app to make this extraction; every sibling did it first and
  the concept is deliberately the same on all seven (priority #1/#3) — linux
  `build_bridge_detail_content`, apple `BridgeCardContent`, web `BridgeCard.svelte`,
  android's `internal` BridgeCard, tui `embed_bridge_card`.

  ⚠ THE LINK BUTTON GATES ON `linked`, NEVER ON DECLARED LINK MODES. web's own
  extraction surfaced that gap: a card that hides its action button when the
  provider declares no link modes makes the AT Protocol page's synthetic pre-fetch
  panel silently vanish instead of rendering an honest surface (ui/atproto.md:42).
  windows was already on the right side of it — the button is unconditional here
  and must stay that way.

  The visual tree is byte-for-byte the one BridgesPage rendered before the
  extraction, with one mechanical change: the per-row text/name/label are assigned
  in code-behind (OnBridgeChanged) rather than by x:Bind, because a UserControl in
  a DataTemplate binds against ITSELF, not the item. That also keeps the
  AutomationProperties.Name assignment explicit — without a Name, FlaUI reports a
  DataTemplate row's count/is_visible as 0 (memory
  reference_winui_flaui_datatemplate_name).
-->
<UserControl
    x:Class="FaunaApp.Controls.BridgeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ids="using:FaunaApp.UiIds">

    <Grid x:Name="Root" Padding="12" ColumnSpacing="12"
          AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeCard}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="NameText"
                   Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!-- `bridge-identity`: the linked account's identity, "<label>: <display>"
             (bridges.md § User actions). Its own TextBlock, AutomationId only and NO
             Name (a get_text target), so the mode beside it is never read with it. -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6" Opacity="0.6">
            <TextBlock x:Name="IdentityText" Visibility="Collapsed"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeIdentity}" />
            <TextBlock x:Name="ModeText" Foreground="{ThemeResource SystemAccentColor}" />
        </StackPanel>

        <Button Grid.RowSpan="2" Grid.Column="1" x:Name="ActionButton"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeActionButton}"
                Click="ActionButton_Click"
                VerticalAlignment="Center">
            <Button.Content>
                <TextBlock x:Name="ActionText" />
            </Button.Content>
        </Button>

        <!-- Metadata-driven settings rows (bridges.md § Bridge settings) — built imperatively in Render(), one row per
             BridgeSetting, since the set/shape varies per bridge and per nest
             version (a newer nest can add a setting_type this build predates).
             No ui.yaml ids of its own: these ride the shared bridge-card
             component, same as every sibling app's settings loop (tui
             setting_elements / web BridgeCard.svelte / linux
             build_settings_group / android SettingRow / apple
             BridgeCardContent). -->
        <StackPanel x:Name="SettingsPanel" Grid.Row="2" Grid.ColumnSpan="2"
                    Spacing="4" Margin="0,8,0,0" />

        <!-- Follows (bridges.md § Follows, § User actions) on a LINKED card whose
             provider supports them: the add row (`bridge-follow-id-input` +
             `bridge-follow-petname-input` + `bridge-add-follow-button`) and one row per
             follow, built in RenderFollows, painting the shared `follow_display`
             (nickname, else id) with its `bridge-follow-remove`. The container's Name
             is what keeps UIA from pruning a bare panel (memory
             reference_winui_flaui_datatemplate_name). -->
        <StackPanel x:Name="FollowsPanel" Grid.Row="3" Grid.ColumnSpan="2"
                    Spacing="4" Margin="0,8,0,0"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFollowsList}"
                    AutomationProperties.Name="bridge-follows-list"
                    Visibility="Collapsed">
            <TextBlock x:Name="FollowsHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FollowIdInput"
                         AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFollowIdInput}"
                         TextChanged="FollowIdInput_TextChanged" />
                <TextBox x:Name="FollowPetnameInput" Grid.Column="1"
                         AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFollowPetnameInput}" />
                <Button x:Name="AddFollowButton" Grid.Column="2" IsEnabled="False"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeAddFollowButton}"
                        Click="AddFollowButton_Click" />
            </Grid>
            <StackPanel x:Name="FollowRows" Spacing="4" />
        </StackPanel>

        <!-- Follow requests (bridges.md § Follow requests), under the follows list on a
             LINKED card whose provider declares supports_follow_requests (ActivityPub).
             `bridge-follow-requests-list` is the HEADING itself (ui.yaml: "Heading of
             the follow requests … with their count"), kept at a zero count when nothing
             waits; the rows are its siblings, built in RenderFollowRequests. The
             heading carries an AutomationId and NO Name: it is a get_text target, and
             FlaUI's GetText on a panel would join every descendant TextBlock — row
             text and button labels included (memory
             reference_windows_flaui_gettext_dynamic_label_no_name). -->
        <StackPanel x:Name="FollowRequestsPanel" Grid.Row="4" Grid.ColumnSpan="2"
                    Spacing="4" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="FollowRequestsHeading"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFollowRequestsList}"
                       Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel x:Name="FollowRequestRows" Spacing="4" />
        </StackPanel>

        <!-- Why linking is unavailable, painted BESIDE the (disabled) action button
             on the card itself — not only inside the link dialog, which a user with
             a disabled button can never open. bridges.md § Errors & edge cases.
             AutomationId but deliberately NO AutomationProperties.Name: this is a
             get_text target, and a static Name makes FlaUI return the Name instead
             of the text (memory reference_windows_flaui_gettext_dynamic_label_no_name). -->
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" x:Name="LinkBlockedReason"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeLinkBlockedReason}"
                   Margin="0,8,0,0" Opacity="0.8" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!-- The supervised ward's feed-source ask (family-safety.md § Feed-source
             approvals → App affordance): one bridge-source-request-state label per
             durable ask on THIS bridge and one bridge-source-request-button per refused
             link/follow with no durable row yet. Built imperatively in RenderSourceAsks
             (a card can carry several — a blocked link AND two blocked follows are three
             independent asks, each with its own verdict) and EMPTY in the common case:
             both inputs are supervised-only by construction, so the card re-tests no
             supervision. -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" x:Name="SourceAskPanel"
                    Spacing="4" Margin="0,8,0,0" Visibility="Collapsed" />

        <!-- Feed-subscription shim (bridge-feed-subscriptions / bridge-feed-item /
             bridge-subscribe-feed-button) retired 2026-06-29 per bridges.md
             § Layout & flow: subscription is the Feed page's bridge-form-* surface
             (Feed-only decision, ratified 2026-06-28), not the bridge card's. -->
    </Grid>
</UserControl>
