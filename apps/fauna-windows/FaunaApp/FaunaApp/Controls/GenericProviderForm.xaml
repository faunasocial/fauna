<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Controls.GenericProviderForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!-- Children populated dynamically by Rebuild() based on the Fields DP.
         Fields come from the OnboardingMachine's `visibleDnsFields()` /
         `visibleVpsFields()` helper, which already enforces kind-visibility
         (e.g. Hetzner's `kinds: ['vps']` field is hidden unless the
         same-provider checkbox is on). -->
    <StackPanel x:Name="FieldsPanel" Spacing="8" />
</UserControl>
