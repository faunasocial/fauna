<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Controls.EmailFilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FaunaApp.Markup"
    Loaded="Panel_Loaded"
    AutomationProperties.AutomationId="{x:Bind ids:Ids.EmailFilterPanel}"
    xmlns:ids="using:FaunaApp.UiIds">

    <StackPanel Spacing="12">

        <!-- Filter list -->
        <ListView x:Name="FilterList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- Literal ids — this DataTemplate has no x:DataType, so
                         `{x:Bind ids:Ids.…}` silently drops here; see
                         Controls/RecipientPicker.xaml. -->
                    <Grid ColumnSpacing="8" Padding="4,2"
                          AutomationProperties.AutomationId="filter-item"
                          AutomationProperties.Name="{Binding Name}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            AutomationProperties.AutomationId="filter-name"
                            Text="{Binding Name}"
                            VerticalAlignment="Center"
                            TextWrapping="NoWrap"
                            TextTrimming="CharacterEllipsis" />

                        <Border
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Padding="6,2"
                            CornerRadius="4"
                            Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                            <TextBlock
                                AutomationProperties.AutomationId="filter-action"
                                Text="{Binding Action}"
                                FontSize="11" />
                        </Border>

                        <Button
                            Grid.Column="2"
                            AutomationProperties.AutomationId="filter-edit"
                            Content="&#xE70F;"
                            FontFamily="Segoe MDL2 Assets"
                            Padding="6,4"
                            FontSize="11"
                            Visibility="{Binding EditVisibility}"
                            Click="EditFilter_Click"
                            ToolTipService.ToolTip="{loc:Localize Key=common/edit}" />

                        <Button
                            Grid.Column="3"
                            AutomationProperties.AutomationId="filter-delete"
                            Content="&#xE74D;"
                            FontFamily="Segoe MDL2 Assets"
                            Padding="6,4"
                            FontSize="11"
                            Click="DeleteFilter_Click"
                            ToolTipService.ToolTip="{loc:Localize Key=common/delete}" />

                        <!-- The post-succession review pair (succession-aftermath.md
                             § Adjudicating what the aftermath carries across): only on a
                             rule the aftermath carried across that the owner has not yet
                             answered — Collapsed (so absent from the UIA count) on every
                             other row. No review-Remove button: filter-delete above is
                             the Remove half (no second removal mechanism). -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{Binding MarkVisibility}">
                            <TextBlock
                                AutomationProperties.AutomationId="filter-unattested-mark"
                                Text="{loc:Localize Key=settings/privacy_page/filter_inherited}"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                Opacity="0.7"
                                FontSize="12" />
                            <Button
                                AutomationProperties.AutomationId="filter-review-keep-button"
                                Content="{loc:Localize Key=settings/privacy_page/filter_keep}"
                                Padding="6,2"
                                FontSize="12"
                                Click="KeepFilter_Click" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Loading indicator -->
        <ProgressRing
            x:Name="LoadingRing"
            IsActive="False"
            Visibility="Collapsed"
            HorizontalAlignment="Left" />

        <!-- Add filter toggle -->
        <ToggleButton
            x:Name="AddFilterToggle"
            AutomationProperties.AutomationId="{x:Bind ids:Ids.AddFilterBtn}"
            Content="{loc:Localize Key=settings/privacy_page/add_filter}"
            Checked="AddFilterToggle_Toggled"
            Unchecked="AddFilterToggle_Toggled" />

        <!-- Create filter form (collapsed by default) -->
        <StackPanel
            x:Name="AddFilterForm"
            Spacing="8"
            Visibility="Collapsed">

            <TextBox
                x:Name="FilterNameInput"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterNameInput}"
                Header="{loc:Localize Key=settings/filter_name}"
                PlaceholderText="e.g. Block newsletters" />

            <ComboBox
                x:Name="FilterRuleType"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterRuleType}"
                Header="{loc:Localize Key=settings/rule_type}"
                HorizontalAlignment="Stretch"
                SelectionChanged="FilterRuleType_SelectionChanged">
                <!-- AutomationProperties.Name = the wire enum (the cross-app select()
                     key) so the e2e bridge, which matches a ComboBoxItem by its UIA Name,
                     resolves "SenderIs" etc. regardless of the localized Content label. -->
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/sender_is}" Tag="SenderIs" AutomationProperties.AutomationId="SenderIs" IsSelected="True" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/sender_domain}" Tag="SenderDomain" AutomationProperties.AutomationId="SenderDomain" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/subject_contains}" Tag="SubjectContains" AutomationProperties.AutomationId="SubjectContains" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/body_contains}" Tag="BodyContains" AutomationProperties.AutomationId="BodyContains" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/header_exists}" Tag="HeaderExists" AutomationProperties.AutomationId="HeaderExists" />
                <ComboBoxItem Content="{loc:Localize Key=settings/privacy_page/header_value}" Tag="HeaderContains" AutomationProperties.AutomationId="HeaderContains" />
                <ComboBoxItem Content="{loc:Localize Key=settings/privacy_page/spam_score}" Tag="SpamScoreAtLeast" AutomationProperties.AutomationId="SpamScoreAtLeast" />
            </ComboBox>

            <TextBox
                x:Name="FilterRuleValue"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterRuleValue}"
                Header="{loc:Localize Key=settings/rule_value}"
                PlaceholderText="e.g. spam@example.com" />

            <!-- The two conditions with a second input (Collapsed, so absent from
                 the UIA count, unless their kind is selected). -->
            <TextBox
                x:Name="FilterRuleHeaderValueInput"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterRuleHeaderValue}"
                Header="{loc:Localize Key=settings/privacy_page/header_value}"
                Visibility="Collapsed" />
            <TextBox
                x:Name="FilterRuleSpamScoreInput"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterRuleSpamScore}"
                Header="{loc:Localize Key=settings/privacy_page/spam_score}"
                Visibility="Collapsed" />

            <ComboBox
                x:Name="FilterActionSelect"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterActionSelect}"
                Header="{loc:Localize Key=settings/privacy_page/action}"
                HorizontalAlignment="Stretch"
                SelectionChanged="FilterActionSelect_SelectionChanged">
                <!-- AutomationProperties.Name = the wire kind, as on the rule-type items
                     above: the e2e select() key. -->
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/action_allow}" Tag="Allow" AutomationProperties.AutomationId="Allow" IsSelected="True" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/action_discard}" Tag="Discard" AutomationProperties.AutomationId="Discard" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/action_reject}" Tag="Reject" AutomationProperties.AutomationId="Reject" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/action_forward}" Tag="Forward" AutomationProperties.AutomationId="Forward" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/action_file_into}" Tag="FileInto" AutomationProperties.AutomationId="FileInto" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/action_auto_reply}" Tag="AutoReply" AutomationProperties.AutomationId="AutoReply" />
                <ComboBoxItem Content="{loc:Localize Key=status/email_filters/action_add_label}" Tag="AddLabel" AutomationProperties.AutomationId="AddLabel" />
            </ComboBox>

            <!-- The Forward inputs: shown only while the action reads Forward
                 (Collapsed, so absent from the UIA count, otherwise). -->
            <StackPanel
                x:Name="ForwardInputs"
                Spacing="8"
                Visibility="Collapsed">
                <TextBox
                    x:Name="FilterForwardAddressInput"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterForwardAddress}"
                    Header="{loc:Localize Key=settings/privacy_page/forward_address}" />
                <CheckBox
                    x:Name="FilterKeepLocalCopyBox"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterKeepLocalCopy}"
                    Content="{loc:Localize Key=settings/privacy_page/keep_local_copy}"
                    IsChecked="True" />
            </StackPanel>

            <!-- The other actions' own inputs: each shown only while its action is
                 selected (Collapsed otherwise). -->
            <TextBox
                x:Name="FilterFileIntoMailboxInput"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterFileIntoMailbox}"
                Header="{loc:Localize Key=settings/privacy_page/file_into_mailbox}"
                Visibility="Collapsed" />
            <TextBox
                x:Name="FilterAddLabelInput"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterAddLabel}"
                Header="{loc:Localize Key=settings/privacy_page/add_label}"
                Visibility="Collapsed" />
            <StackPanel
                x:Name="AutoReplyInputs"
                Spacing="8"
                Visibility="Collapsed">
                <TextBox
                    x:Name="FilterAutoReplySubjectInput"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterAutoReplySubject}"
                    Header="{loc:Localize Key=settings/privacy_page/auto_reply_subject}" />
                <TextBox
                    x:Name="FilterAutoReplyBodyInput"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterAutoReplyBody}"
                    Header="{loc:Localize Key=settings/privacy_page/auto_reply_body}"
                    AcceptsReturn="True"
                    TextWrapping="Wrap" />
                <TextBox
                    x:Name="FilterAutoReplyIntervalInput"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterAutoReplyIntervalHours}"
                    Header="{loc:Localize Key=settings/privacy_page/auto_reply_interval_hours}" />
            </StackPanel>

            <!-- The rule's place in the order and its `continue` flag
                 (email-filters.md § Email filter rules). -->
            <TextBox
                x:Name="FilterPriorityInput"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterPriorityInput}"
                Header="{loc:Localize Key=settings/privacy_page/priority}" />
            <CheckBox
                x:Name="FilterContinueBox"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.FilterContinueToggle}"
                Content="{loc:Localize Key=settings/privacy_page/continue_matching}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="CreateFilterButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.CreateFilter}"
                    Content="{loc:Localize Key=common/create}"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="CreateFilter_Click" />
                <ProgressRing
                    x:Name="CreateRing"
                    IsActive="False"
                    Visibility="Collapsed"
                    VerticalAlignment="Center" />
            </StackPanel>

        </StackPanel>

    </StackPanel>
</UserControl>
