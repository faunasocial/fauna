<UserControl
    x:Class="FaunaApp.Controls.RecipientPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:ids="using:FaunaApp.UiIds">
    <StackPanel Spacing="8">
        <!--
            ItemsControl + StackPanel(Horizontal): a plain ItemsControl
            with the default StackPanel panel renders items straight to
            the visual tree so the recipient-picker-chip AutomationId is
            queryable as soon as the chip is added. ItemsWrapGrid (used
            elsewhere) requires a scroll-aware host like ListView and
            silently fails to materialize items inside an ItemsControl,
            which the e2e tests previously hit as a "chip not added"
            assertion.
        -->
        <ItemsControl x:Name="ChipsList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--
                        A Button root reading "{address} ×": a chip activates to its
                        ×, the one gesture a committed chip has
                        (remove_recipient_chip(i), conversations.md § User actions —
                        tui's and linux's chip). The Button carries a real UIA peer
                        and InvokePattern, so the id reaches the bridge and a click
                        drives the removal (a bare Border has no peer, and UIA drops
                        its AutomationId inside an ItemsControl).
                    -->
                    <!-- ⚠ A LITERAL id, not `{x:Bind ids:Ids.…}`, and `{Binding}`, not
                         `{x:Bind}`: this template declares no `x:DataType`, and an
                         x:Bind inside it yields nothing — the element would ship with
                         NO AutomationId at all, which is invisible to MSBuild, to the
                         C# unit tests and to ui-registry-lint (which greps for the id
                         text) and shows up only as `count=0` in an e2e run. -->
                    <Button AutomationProperties.AutomationId="recipient-picker-chip"
                            Content="{Binding Display}"
                            Tag="{Binding Index}"
                            Background="{ThemeResource SystemAccentColorLight2}"
                            CornerRadius="12" Padding="8,4" Margin="0,0,4,4"
                            Click="OnChipClicked" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBox x:Name="InputBox"
                 AutomationProperties.AutomationId="{x:Bind ids:Ids.RecipientPickerInput}"
                 PlaceholderText="{loc:Localize Key=conversations/unified/recipient_picker_placeholder}"
                 TextChanged="OnInputChanged"
                 KeyDown="OnInputKeyDown" />
        <!-- Chrome, no id (ui.yaml gives the bridges line none): which far networks a
             typed address may reach, by each serving bridge's declared label. Collapsed
             while no bridge serves the account. -->
        <TextBlock x:Name="BridgesLine" Visibility="Collapsed" Opacity="0.7" FontSize="12"
                   TextWrapping="Wrap" />
        <ItemsControl x:Name="SuggestionsList" Visibility="Collapsed">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- A Button root: it carries a real UIA InvokePattern, so the
                         e2e bridge drives the click directly (a bare TextBlock in a
                         ListViewItem has none). Literal id for the same reason as the
                         chip above. -->
                    <Button AutomationProperties.AutomationId="recipient-picker-suggestion"
                            Content="{Binding Display}"
                            Tag="{Binding Index}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="OnSuggestionClicked" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ResolveStatus"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.RecipientResolveStatus}"
                   Tag="idle" />
        <!-- The class of the room ABOUT to be created, stated once a recipient
             chip is committed and before the first message goes out
             (`conversation-rooms.md` § The three classes). Derived in shared
             Rust from the committed chips (`prospective_room_class`); this only
             paints it, and stays collapsed — absent — while there is nothing to
             say. Its token rides HelpText, the `class` attribute, exactly as
             `thread-room-class`'s does. -->
        <TextBlock x:Name="ProspectiveClass"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.RecipientPickerClass}"
                   Visibility="Collapsed"
                   Opacity="0.7" FontSize="12" />
        <!-- `recipient-picker-home-nest-toggle`: the new-thread composer's
             home-nest choice (ui.yaml; behavior owner community-rooms.md § The
             three classes). ON seats the user's home nest in the room about to be
             created, which makes it a community room the first send founds; the
             class statement above follows it. COLLAPSED (absent to a driver)
             wherever the picker is not the new-thread composer's — the
             add-participant overlay and the folder-share picker share this
             control and have no room to found. Its `checked` attribute rides
             HelpText (the `room-admin-toggle` shape); the label is the shared
             yes/no sentence, set with the state. -->
        <ToggleButton x:Name="HomeNestToggle"
                      AutomationProperties.AutomationId="{x:Bind ids:Ids.RecipientPickerHomeNestToggle}"
                      Visibility="Collapsed"
                      Click="OnHomeNestClicked" />
    </StackPanel>
</UserControl>
