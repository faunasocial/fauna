<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.SearchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SearchTitle" Text="{loc:Localize Key=common/search}"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Visibility="Collapsed" />

        <Grid Grid.Row="0" ColumnSpacing="8" Margin="0,0,0,8"
              AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchBar}"
              AutomationProperties.Name="search-bar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="SearchToggleButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchToggleButton}"
                    Content="&#xE721;" FontFamily="Segoe MDL2 Assets"
                    Click="SearchToggle_Click" Padding="10" />

            <TextBox Grid.Column="1" x:Name="SearchBox"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchQueryField}"
                     KeyDown="SearchBox_KeyDown" />

            <Button Grid.Column="2" x:Name="SearchClearButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchClearButton}"
                    Content="&#xE894;" FontFamily="Segoe MDL2 Assets"
                    Click="SearchClear_Click" Padding="10" />

            <Button Grid.Column="3" x:Name="SearchCancelButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchCancelButton}"
                    Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                    Click="SearchCancel_Click" Padding="10"
                    Visibility="Collapsed" />

            <Button Grid.Column="4" x:Name="SearchButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchSubmitButton}"
                    Content="&#xE721;" FontFamily="Segoe MDL2 Assets"
                    Click="SearchButton_Click" Padding="10"
                    Style="{StaticResource AccentButtonStyle}" />
        </Grid>

        <!-- Items populated in code-behind (PopulateTypeFilter) from the shared
             FaunaFfiMethods.SearchTypeFilterOptions() token list, so this combo can
             never drift from the mapping SearchManager applies to both search
             backends (search.md § State & data shape — Type filter). -->
        <ComboBox Grid.Row="1" x:Name="TypeFilterCombo"
                  AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchTypeFilter}"
                  Margin="0,0,0,8" HorizontalAlignment="Left" MinWidth="140"
                  SelectionChanged="TypeFilter_SelectionChanged" />

        <Grid Grid.Row="2" AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchResultsPanel}"
              AutomationProperties.Name="search-results-panel">
            <ListView x:Name="ResultsList" SelectionMode="None"
                      AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchResultsView}">
                <!-- Non-virtualizing panel: results are server-capped at limit≤100,
                     so render every row. Keeps result_count() deterministic (all
                     rows realized, not just the viewport) and every result reachable
                     by screen readers / UI automation, matching the other clients. -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchResult">
                        <!-- The result-row root is a transparent Button so activating it
                             routes by SearchNav (SearchResult_Click) — a bare Grid root has
                             no UIA invoke pattern (reference_winui_clickable_row_needs_button
                             _root, the post-card/event-card/addressbook-item/media-item
                             idiom). The id + accessible Name live on the Button; Tag carries
                             the bound row so the handler reads its Nav. No IsItemClickEnabled
                             on the ListView (mirrors FeedPage's post-card), so this Click is
                             the sole open path. -->
                        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchResultItem}"
                                AutomationProperties.Name="{x:Bind Snippet}"
                                Tag="{x:Bind}" Click="SearchResult_Click"
                                Background="Transparent" BorderThickness="0" Padding="8"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.RowSpan="2" Grid.Column="0"
                                       Text="{x:Bind TypeIcon}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       VerticalAlignment="Center" Opacity="0.6" />

                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{x:Bind Title}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <!-- Relative timestamp (matches linux search.rs + ui.yaml
                                 search-result-card; content_type carries no title). -->
                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="{x:Bind Timestamp}"
                                       Opacity="0.5" FontSize="12"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Text="{x:Bind Snippet}"
                                       Opacity="0.6" TextTrimming="CharacterEllipsis"
                                       MaxLines="2" />
                        </Grid>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock x:Name="NoResultsText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchNoResults}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" Visibility="Collapsed" />
        </Grid>

        <Button Grid.Row="3" x:Name="LoadMoreButton"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchLoadMoreButton}"
                HorizontalAlignment="Center"
                Margin="0,8,0,0" Visibility="Collapsed"
                Click="LoadMore_Click" />

        <ProgressRing Grid.Row="2" x:Name="LoadingRing"
                      IsActive="False" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <controls:CopyableInfoBar Grid.Row="2" x:Name="ErrorBar"
                 Severity="Error" IsOpen="False" IsClosable="True"
                 VerticalAlignment="Bottom" Margin="0,0,0,16" />
    </Grid>
</Page>
