<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.SettingsEncryptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">

            <!-- Error bar -->
            <controls:CopyableInfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="True" />

            <!-- Header -->
            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}" Style="{StaticResource TitleTextBlockStyle}" Text="{loc:Localize Key=settings/encryption_page/title}" />

            <!-- Encryption section -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Localize Key=settings/encryption_page/title}" />
                <TextBlock x:Name="MlsStatusText" Text="{loc:Localize Key=common/loading}" Opacity="0.7" />

                <!-- Low-supply flag (direct-messages.md § Key Package Management): read-only,
                     present in the automation tree ONLY while the shared threshold calls the
                     count low (Collapsed = absent). Never an auto-mint trigger. -->
                <TextBlock x:Name="LowWarningText"
                           AutomationProperties.AutomationId="{x:Bind ids:Ids.EncryptionKeypackageLowWarning}"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />

                <TextBlock Text="{loc:Localize Key=settings/encryption_page/mls_key_packages}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{loc:Localize Key=settings/encryption_page/mls_description}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Localize Key=settings/encryption_page/available_key_packages}" Opacity="0.7" />
                    <!-- Bare count (loading copy before the first read) — AutomationId only,
                         no static Name, so get_text reads the live text. -->
                    <TextBlock x:Name="KeyPackageCountText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.EncryptionKeypackageCount}"
                               Text="{loc:Localize Key=common/loading}" />
                </StackPanel>

                <TextBlock Text="{loc:Localize Key=settings/encryption_page/refresh_keys_description}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                <Button x:Name="RefreshKeysButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.EncryptionKeypackageRefreshButton}"
                        Click="RefreshKeysButton_Click"
                        Content="{loc:Localize Key=settings/encryption_page/refresh_keys}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
