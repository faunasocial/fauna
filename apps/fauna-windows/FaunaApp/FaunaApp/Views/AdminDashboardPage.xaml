<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">

            <!-- Error bar -->
            <controls:CopyableInfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="True" />

            <!-- Header -->
            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminDashboardHeading}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{loc:Localize Key=admin/dashboard/title}" />

            <!-- Loading -->
            <ProgressRing
                x:Name="LoadProgress"
                IsActive="False"
                Visibility="Collapsed"
                HorizontalAlignment="Left" />

            <!-- The shared card set (admin.md § 1. Dashboard → The card set):
                 one card per entry of AdminDashboardViewModel.Cards, in the
                 fold's order — windows chooses no card of its own. indexed:
                 true in ui.yaml; the literal AutomationIds repeat per card
                 (the e2e driver's index= picks the Nth occurrence).
                 AutomationProperties.Name on the card Border is load-bearing:
                 without it a DataTemplate Border is not surfaced to FlaUI. The
                 label/value leaves carry an AutomationId only, so get_text
                 reads their (dynamic) Text. A non-virtualizing StackPanel
                 keeps every card realized, below the fold included. -->
            <ItemsControl x:Name="CardsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AdminStatCardVm">
                        <Border CornerRadius="8" Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminStatCard}"
                                AutomationProperties.Name="{x:Bind Label}">
                            <StackPanel Spacing="4">
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminStatCardLabel}"
                                           Opacity="0.7" FontSize="13"
                                           Text="{x:Bind Label}" />
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminStatCardValue}"
                                           Text="{x:Bind Value}" FontSize="28" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- TextBlock mirrors for E2E -->
            <TextBlock x:Name="ErrorTextMirror"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.ErrorMessage}"
                       AutomationProperties.Name=" "
                       Text=" " FontSize="1" Height="1" Visibility="Collapsed" />
            <TextBlock x:Name="WarningTextMirror"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.WarningMessage}"
                       AutomationProperties.Name=" "
                       Text=" " FontSize="1" Height="1" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
