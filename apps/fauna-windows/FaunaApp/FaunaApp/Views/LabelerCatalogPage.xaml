<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.LabelerCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!-- Settings → Community labelers (content-moderation-and-ranking.md § Tier-3
         community models & background re-processing; ui.yaml labeler-catalog):
         browse + inspect-before-subscribe over EVERY published labeler
         (fauna.labelers.list). Reached from the Personalization home's
         browse-catalog button. A thin renderer over its OWN LabelerCatalogMachine
         instance (the windows per-page-machine convention — mirrors
         PersonalizationPage/DevicesPage/FoldersPage rather than linux's
         per-settings-shell shared machine). Mirrors apps/fauna-linux/src/views/
         personalization/mod.rs's CatalogShell (the lift reference).

         ⚠ No ConfigureAwait(false) — a WinUI page that mutates bound state off
         the UI thread throws a silent COMException
         (reference_windows_vm_configureawait_comexception). -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="16" MaxWidth="700" HorizontalAlignment="Left">

            <controls:CopyableInfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="True" />

            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{loc:Localize Key=labeler_catalog/title}" />

            <!-- labeler-inspect-panel: the inspect-before-subscribe detail,
                 collapsed until a row's inspect button is tapped
                 (LabelerCatalogSnapshot.inspecting). The same control the room
                 editor's labeler set paints in place. -->
            <controls:LabelerInspectPanel x:Name="InspectPanel"
                                          CloseRequested="InspectPanel_CloseRequested" />

            <!-- A Border (not a bare container) carries the list test id with a
                 non-empty Name — a container without one prunes from the UIA
                 tree along with its children (the bare-id-root prune trap);
                 rows live in a non-virtualizing StackPanel so FlaUI realizes
                 every row. -->
            <Border x:Name="CatalogListBorder"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.LabelerCatalogList}"
                    AutomationProperties.Name="{loc:Localize Key=labeler_catalog/title}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="CatalogEmptyText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.LabelerCatalogEmpty}"
                               Opacity="0.5" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Text="{loc:Localize Key=labeler_catalog/empty}" />
                    <StackPanel x:Name="CatalogContainer" Spacing="6" />
                </StackPanel>
            </Border>

            <ProgressRing x:Name="LoadProgress" IsActive="False" Visibility="Collapsed"
                          HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
