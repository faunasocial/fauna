<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.LaunchInstanceChooserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:core="using:FaunaApp.Core.Services"
    xmlns:ids="using:FaunaApp.UiIds">

    <!-- The launch-collision chooser (account-scoping.md § Concurrent instances →
         "the colliding instance's surface"; ui.yaml page `launch_instance_chooser`,
         platforms [windows, linux, tui]). Shown by a PLAIN interactive launch whose
         would-be account is already served by a live instance; a bound launch that
         collides is terminally refused and never reaches here.

         The `launch-instance-chooser` id sits on the Page-level root Grid rather
         than on an inner container: a WinUI element that is not itself a realized
         UIA peer (or lives under one that isn't) never enters the tree, and the
         page root always is (the PaneHeader lesson, e2e_status_and_tips § Windows). -->
    <Grid AutomationProperties.AutomationId="{x:Bind ids:Ids.LaunchInstanceChooser}"
          AutomationProperties.Name="Launch instance chooser"
          Padding="48"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          MaxWidth="520">
        <StackPanel Spacing="16">

            <TextBlock x:Name="TitleText"
                       Style="{StaticResource TitleTextBlockStyle}"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="SubtitleText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.8"
                       TextWrapping="Wrap" />

            <!-- The pick's failure surface. `account_taken` when the row lost the
                 race between render and click (arbitration stays at acquire), and
                 `no_running_instance` when neither forwarding exit could reach the
                 primary — the known gap for a collision against a BOUND sibling,
                 which owns no rendezvous name. Surfacing it beats exiting into
                 nothing (account-scoping.md § Concurrent instances, "Known gap"). -->
            <controls:CopyableInfoBar x:Name="ErrorBar" IsClosable="False" />

            <TextBlock x:Name="ChooseAccountText"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Visibility="Collapsed"
                       TextWrapping="Wrap" />

            <!-- Shown INSTEAD of the list when every registered account is already
                 served somewhere. Not an error state: the two exits below still work. -->
            <TextBlock x:Name="NoneAvailableText"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Opacity="0.8"
                       Visibility="Collapsed"
                       TextWrapping="Wrap" />

            <!-- Indexed rows. The DataTemplate root is a Button, and it carries an
                 AutomationProperties.Name: without BOTH, FlaUI reads count = 0 for
                 the row id and the row cannot be invoked (the two standing WinUI
                 e2e traps — see e2e_status_and_tips § Windows). -->
            <ItemsControl x:Name="ChoicesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:LaunchInstanceChoice">
                        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.LaunchInstanceChooserItem}"
                                AutomationProperties.Name="{x:Bind DisplayLabel}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Margin="0,0,0,4"
                                Click="ChoiceClick"
                                Tag="{x:Bind ActorId}"
                                Content="{x:Bind DisplayLabel}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="FocusExistingButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.LaunchInstanceFocusExistingButton}"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="FocusExistingClick" />
                <Button x:Name="AddAccountButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.LaunchInstanceAddAccountButton}"
                        Click="AddAccountClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
