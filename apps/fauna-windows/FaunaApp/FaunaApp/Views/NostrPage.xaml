<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.NostrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    xmlns:models="using:FaunaApp.Core.Models"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!--
      The standalone Nostr settings page (docs/goal/ui/nostr.md § Page structure —
      ratified 2026-06-13: Nostr keeps its OWN dedicated page, the same treatment as
      mail, NOT folded into the unified Bridges page). Windows was the last client with
      no Nostr surface at all; this closes the § Implementation status "windows ❌" row.

      A dumb renderer of the testable FaunaApp.Core NostrViewModel over the unified
      `fauna.bridges.*` seam (`bridge_id:"nostr"`) — no new FFI, no new Rust. All Nostr
      logic is shared Rust (priority #2): relay-URL validation (and its message) and
      the signing-mode label come from `fauna_protocol::nostr_relay::relay_url_error` and
      `fauna_client_bridges::nostr_key_source_label` via UniFFI.

      Two gates the layout must honour (both are bugs already paid for on other
      clients — see NostrViewModel's remarks):
        * `Registered` — NOT `Available` — gates the unavailable notice.
        * The link gate really swaps the surface: unlinked → only the link form;
          linked → pubkey copy + unlink + toggles + relays + follows.

      DMs are not on this page: a Nostr DM is a bridged room on unified
      Conversations (§ Implementation status today, DMs).
      Connected apps (nostr-bunker-*) landed 2026-07-30 — windows was the last app
      without it, closing § Implementation status's final Nostr row.

      Every list uses a non-virtualizing StackPanel ItemsPanel so FlaUI realizes each
      row for count-all, and each row template root carries AutomationProperties.Name
      (without it FlaUI counts zero — reference_winui_flaui_datatemplate_name). No
      ConfigureAwait(false) in the handlers (off-thread bound-state mutation throws a
      silent COMException).
    -->
    <!-- Compact by necessity, not by taste: the app window is 600x600 DIP
         (App.xaml.cs MinWindowDip), and `test_link_generate_and_unlink_round_trip`
         asserts nostr-pubkey-copy-btn AND all 5 content toggles are visible at the
         same time. `is_visible` is `!IsOffscreen`, so anything below the ScrollViewer
         fold reads invisible — the linked account block and the 5 toggles must
         therefore share one viewport. Relays/follows may sit below the fold; the
         driver scrolls them into view on `wait_for` before interacting. -->
    <ScrollViewer Padding="16">
        <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">

            <controls:CopyableInfoBar x:Name="ErrorBar"
                     Severity="Error" IsOpen="False" IsClosable="True" />

            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{loc:Localize Key=nostr/title}" />

            <!-- Shown only when the nest has no nostr bridge at all (built without the
                 `nostr` cargo feature). Never gated on `Available` — that is the
                 nsec-deposit bootstrap gate, and hiding the link form behind it is
                 exactly the web/apple bug of 2026-07-14. -->
            <InfoBar x:Name="UnavailableBar"
                     Severity="Informational" IsOpen="False" IsClosable="False"
                     Message="{loc:Localize Key=nostr/unavailable}" />

            <!-- ── 1. Account linking ── -->
            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="{loc:Localize Key=nostr/account/title}" />

                <!-- Unlinked: the account-link form. -->
                <StackPanel x:Name="LinkForm" Spacing="8">
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Localize Key=nostr/account/description}" />
                    <ComboBox x:Name="LinkModeCombo"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrLinkMode}"
                              Header="{loc:Localize Key=nostr/link_account/mode_label}"
                              SelectionChanged="LinkMode_SelectionChanged"
                              HorizontalAlignment="Stretch" />
                    <!-- Import mode only. The nsec is secret → PasswordBox. -->
                    <PasswordBox x:Name="NsecInput"
                                 AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrNsecInput}"
                                 Header="{loc:Localize Key=nostr/link_account/nsec_label}"
                                 PlaceholderText="{loc:Localize Key=nostr/link_account/nsec_placeholder}"
                                 Visibility="Collapsed" />
                    <!-- Remote (NIP-46) mode only. Native-only field, no ui.yaml id —
                         mirrors apple/android/linux/tui. -->
                    <TextBox x:Name="BunkerInput"
                             Header="{loc:Localize Key=nostr/account/mode_remote}"
                             PlaceholderText="bunker://"
                             Visibility="Collapsed" />
                    <Button x:Name="LinkButton"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrLinkButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{loc:Localize Key=nostr/link_account/link_button}"
                            Click="Link_Click" />
                </StackPanel>

                <!-- Linked: identity + signing mode + unlink, on two tight rows so the
                     block and the 5 toggles below it share one 600-DIP viewport. -->
                <StackPanel x:Name="LinkedAccount" Spacing="4" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="PubkeyText" IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrPubkeyCopyBtn}"
                                Content="{loc:Localize Key=common/copy}"
                                Click="PubkeyCopy_Click" />
                        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrUnlinkButton}"
                                Content="{loc:Localize Key=nostr/account/unlink_button}"
                                Click="Unlink_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7"
                                   Text="{loc:Localize Key=nostr/account/signing_mode}" />
                        <!-- AutomationId only, no static Name: a get_text label with a
                             static Name returns the wrong value
                             (reference_windows_flaui_gettext_dynamic_label_no_name). -->
                        <TextBlock x:Name="SigningModeText"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrSigningMode}" />
                    </StackPanel>

                    <!-- Succession-aftermath npub confirm (leg 3 — nostr.md § Key
                         succession and rotation). Dismissible, never a blocking
                         modal — the successor may reach this page long after the
                         ceremony (nostr.md's own Gotcha). -->
                    <StackPanel x:Name="NpubConfirmBanner" Spacing="4" Visibility="Collapsed">
                        <TextBlock x:Name="NpubConfirmBannerText"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrNpubConfirmBanner}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrNpubConfirmYesButton}"
                                    Content="{loc:Localize Key=nostr/npub_confirm/yes_button}"
                                    Click="NpubConfirmYes_Click" />
                            <!-- Reuses the existing unlink gesture — "the existing
                                 page machinery", not a bespoke flow (nostr.md:75). -->
                            <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrNpubConfirmNoButton}"
                                    Content="{loc:Localize Key=nostr/npub_confirm/no_button}"
                                    Click="Unlink_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- ── 2. Content settings (linked only) ──
                 Built in code-behind from the shared catalog
                 (fauna_client_bridges::nostr_settings::nostr_content_toggle_options)
                 — id, wire key, default, label and subtitle all come from there,
                 none re-spelled here (nostr.md § Where logic lives → *The
                 content-toggle catalog*). Header-less switches with the label
                 beside them, not above: a `Header=` ToggleSwitch is ~60 DIP tall
                 and 5 of those push the last toggle past the fold (see the
                 viewport note at the top of this file). Each mirrors on/off into
                 HelpText — the cross-app get_attr(id,"state") contract. -->
            <StackPanel x:Name="ContentSettings" Spacing="2" Visibility="Collapsed">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="{loc:Localize Key=nostr/settings/title}" />
                <StackPanel x:Name="ContentTogglesHost" Spacing="2" />
            </StackPanel>

            <!-- ── 3. Relays (linked only) ── -->
            <StackPanel x:Name="RelaysSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="{loc:Localize Key=nostr/relays/title}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RelayInput" Grid.Column="0"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrRelayInput}"
                             PlaceholderText="{loc:Localize Key=nostr/relays/placeholder}" />
                    <Button Grid.Column="1"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrAddRelay}"
                            Content="{loc:Localize Key=nostr/relays/add}"
                            Click="AddRelay_Click" />
                </Grid>
                <!-- A Border (not a bare ItemsControl) carries a non-empty Name: an
                     empty ItemsControl collapses to zero size → FlaUI IsOffscreen. -->
                <Border AutomationProperties.Name="Relays"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="RelaysEmpty" Opacity="0.5" TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Text="{loc:Localize Key=nostr/relays/none}" />
                        <ItemsControl x:Name="RelaysList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NostrRelayRow">
                                    <Grid AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrRelayItem}"
                                          AutomationProperties.Name="{x:Bind Url}"
                                          ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Url}"
                                                   VerticalAlignment="Center"
                                                   IsTextSelectionEnabled="True" />
                                        <Button Grid.Column="1"
                                                AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrRemoveRelay}"
                                                AutomationProperties.Name="{x:Bind Url}"
                                                Tag="{x:Bind Url}"
                                                Content="{loc:Localize Key=common/remove}"
                                                Click="RemoveRelay_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── 4. Follows (linked only) ── -->
            <StackPanel x:Name="FollowsSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="{loc:Localize Key=nostr/follows/title}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FollowPubkeyInput" Grid.Column="0"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrFollowPubkeyInput}"
                             PlaceholderText="{loc:Localize Key=nostr/follows/pubkey_placeholder}" />
                    <TextBox x:Name="FollowPetnameInput" Grid.Column="1"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrFollowPetnameInput}"
                             PlaceholderText="{loc:Localize Key=nostr/follows/petname_placeholder}" />
                    <Button Grid.Column="2"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrAddFollow}"
                            Content="{loc:Localize Key=nostr/follows/add}"
                            Click="AddFollow_Click" />
                </Grid>
                <Border AutomationProperties.Name="Follows"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="FollowsEmpty" Opacity="0.5" TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Text="{loc:Localize Key=nostr/follows/none}" />
                        <ItemsControl x:Name="FollowsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:BridgeFollow">
                                    <Grid AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrFollowItem}"
                                          AutomationProperties.Name="{x:Bind Id}"
                                          ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{x:Bind Id}" TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind Petname}" Opacity="0.7"
                                                       FontSize="12" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrRemoveFollow}"
                                                AutomationProperties.Name="{x:Bind Id}"
                                                Tag="{x:Bind Id}"
                                                Content="{loc:Localize Key=common/remove}"
                                                Click="RemoveFollow_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ── 5. Connect an app (Nostr Connect / NIP-46 bunker invite) ──
                 nostr.md § The nest as the user's NIP-46 signer + § Layout & flow
                 item 6. The connections themselves are signer rows on the
                 Connected apps page (connected-apps.md); this page keeps only the
                 invite start and its one-time reveal. Rendered only for a linked
                 account in a CUSTODIAL mode
                 (generated/imported) — a `remote` account keeps its key off this box,
                 so the box can never be its signer. The gate is
                 NostrViewModel.ShowConnectedApps (unit-tested in all three arms).

                 Vocabulary is "Connected apps" / "Connect an app" / "Disconnect" —
                 never "capability" or "grant" (§ data-shape paragraph).

                 This section sits below Follows, i.e. below the 600-DIP fold. That is
                 fine and deliberate: the driver scrolls a target into view on wait_for
                 before interacting, and only the account block + the 5 toggles have a
                 same-viewport assertion against them. -->
            <StackPanel x:Name="ConnectedAppsSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                           Text="{loc:Localize Key=nostr/connected_apps/title}" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap"
                           Text="{loc:Localize Key=nostr/connected_apps/description}" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrBunkerConnectBtn}"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{loc:Localize Key=nostr/connected_apps/connect_button}"
                        Click="ConnectApp_Click" />

                <!-- The one-time reveal. The nest never serves this string again (its
                     secret is single-use with a hard-coded TTL), so the hint saying so
                     is load-bearing, not decoration. -->
                <StackPanel x:Name="ConnectReveal" Spacing="6" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                               Text="{loc:Localize Key=nostr/connected_apps/reveal_title}" />
                    <TextBlock Opacity="0.7" TextWrapping="Wrap"
                               Text="{loc:Localize Key=nostr/connected_apps/reveal_hint}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- AutomationId only, no static Name: a get_text target with a
                             static Name returns the wrong value
                             (reference_windows_flaui_gettext_dynamic_label_no_name). -->
                        <TextBlock x:Name="ConnectStringText" Grid.Column="0"
                                   AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrBunkerConnectString}"
                                   IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                   VerticalAlignment="Center" FontFamily="Consolas" />
                        <Button Grid.Column="1"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrBunkerConnectCopyBtn}"
                                Content="{loc:Localize Key=common/copy}"
                                Click="ConnectStringCopy_Click" />
                    </Grid>
                    <!-- The QR is what a phone app scans off a desktop screen
                         (§ Connection model). `optional_elements` in ui.yaml — only tui
                         declines it; windows paints it via the shared
                         fauna_core::qr_matrix grid, same as identity export.
                         Background stays White in BOTH themes: a theme-inverted QR
                         does not scan. The AutomationProperties.Name is required, not
                         decoration: a bare Canvas is pruned from the UIA tree and
                         FlaUI would report count/is_visible = 0
                         (reference_winui_flaui_datatemplate_name; identity-export-qr
                         carries one for the same reason). -->
                    <Canvas x:Name="ConnectQrCanvas"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.NostrBunkerConnectQr}"
                            AutomationProperties.Name="{loc:Localize Key=nostr/connected_apps/qr_alt}"
                            Width="200" Height="200" Background="White"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <!-- ── 6. Zap signers (the NIP-57 trust root, monetization.md § Zap
                 receipts — the trust model; nostr.md § Layout & flow item 7).
                 Rendered for ANY linked account (not custodial-gated, unlike
                 Connected apps above). `zaps` rides the SAME store-safe axis
                 as Payments, and the markup lives in Views/Payments/ for the
                 same reason (dynamic-features.md § Platform-family surface
                 excision) — the host stays empty in the excised flavor.
                 NostrPage.xaml.cs fills it under `#if PAYMENTS`. ── -->
            <ContentControl x:Name="ZapSignersSectionHost"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" />
        </StackPanel>
    </ScrollViewer>
</Page>
