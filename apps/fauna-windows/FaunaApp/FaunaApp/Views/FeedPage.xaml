<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.FeedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    xmlns:models="using:FaunaApp.Core.Models"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:helpers="using:FaunaApp.Helpers"
    xmlns:corehelpers="using:FaunaApp.Core.Helpers"
    xmlns:loc="using:FaunaApp.Markup"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <Page.Resources>
        <!-- The post-card template and its converters — shared with the profile's
             Posts tab (ui/profile.md § Layout & flow → The Posts tab). -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:PostCardTemplates />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Feed rail (feed-selector): visible list of feed-item rows, matching the
             web/linux sidebar. A collapsed ComboBox previously hid the feed-items from
             the UIA tree (count("feed-item") == 0); a visible ListView realizes them. -->
        <Grid Grid.Column="0" Padding="8" BorderThickness="0,0,1,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="4,4,4,8"
                       Text="{loc:Localize Key=feed/list/title}" />
            <!-- Built-in Trending virtual feed (trending.md § The Trending feed): a
                 pseudo-entry above the user's own feeds — and above Local, mirroring
                 web/linux's ordering — NOT a feed-item (no feed row, no delete).
                 Selecting it drives FeedManager::select_trending_feed; selecting a
                 normal feed already clears trending_selected server-side (no client
                 bookkeeping needed for mutual exclusion). Its selected/unselected
                 visual state is toggled in SyncFeeds from Snapshot.trendingSelected
                 (an AccentButtonStyle swap — this plain Button sits outside the
                 FeedList ListView, so it can't ride the ListView's native
                 SelectedItem highlight the feed-item rows use). -->
            <Button Grid.Row="1" x:Name="TrendingFeedButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedTrendingItem}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Click="TrendingFeed_Click" Margin="0,0,0,4"
                    Content="{loc:Localize Key=feed/list/trending}" />
            <!-- Local built-in feed (NOT a feed-item; selects the home/local feed
                 via the shared FeedManager.select_feed(None)). -->
            <Button Grid.Row="2" x:Name="LocalFeedButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedLocalItem}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Click="LocalFeed_Click" Margin="0,0,0,4"
                    Content="{loc:Localize Key=feed/list/local}" />
            <ListView Grid.Row="3" x:Name="FeedList"
                      SelectionMode="Single"
                      SelectionChanged="FeedList_SelectionChanged">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Non-virtualizing panel so count("feed-item") sees every
                             row even when offscreen (memory: bounded count-all lists). -->
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <!-- The row root is a BUTTON, not a bare Grid — the windows shape for
                         every clickable e2e row (account-switcher-item, media-item,
                         addressbook-item, launch-instance-chooser-item). The FlaUI bridge
                         drives a click through the first UIA pattern the element supports
                         (Invoke → Toggle → SelectionItem → ExpandCollapse) and only falls
                         back to a physical mouse click when it supports none. A Grid
                         supports none, so `open_feed` took that fallback, the ListView's
                         selection never moved, FeedList_SelectionChanged never fired, and
                         `FeedManager::select_feed` was never called — the page silently kept
                         serving the previously-selected feed, which no assertion could see
                         because every nest-side key is 0 and a composed feed's first page is
                         the same posts in the same order the local feed already showed. Selecting by the row's OWN FeedId Tag
                         (never "whichever row the ListView thinks is selected") is
                         RowDeleteFeed_Click's rule applied to the row itself; SyncFeeds
                         still paints the rail's highlight from the snapshot. The id/Name stay
                         on the row root so feed-delete-button nests as a real UIA descendant
                         — `scope="feed-item[i]"` (test_feed_bridge_subscribe.py) resolves by
                         DESCENDANT match. -->
                    <DataTemplate x:DataType="models:FeedDefinition">
                        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedItem}"
                                AutomationProperties.Name="{x:Bind Name}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0"
                                Padding="4,2"
                                Click="FeedItem_Click" Tag="{x:Bind FeedId}">
                            <Grid ColumnSpacing="4" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedDeleteButton}"
                                        Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                        Click="RowDeleteFeed_Click" Tag="{x:Bind FeedId}"
                                        Padding="4" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Main feed content (search + posts + compose). -->
        <Grid Grid.Column="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: Feed selector -->
        <Grid Grid.Row="0" Padding="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           VerticalAlignment="Center"
                           Text="{loc:Localize Key=feed/list/title}" />
                <Button x:Name="CreateFeedButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedCreateFeedButton}"
                        Content="&#xE710;" FontFamily="Segoe MDL2 Assets"
                        Click="CreateFeed_Click" Padding="8"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="{loc:Localize Key=feed/post/create_tooltip}" />
                <!-- Opens the bridge-feed-subscribe form. Shown ONLY when the nest's
                     build serves ≥1 bridge (AvailableBridges non-empty) — the feed-selector
                     capability gate (version-compatibility.md § Dimension 3), matching
                     web/linux/android/apple. Code-set Collapsed by SyncAvailableBridges. -->
                <Button x:Name="BridgeFeedSubscribeToggle"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFeedSubscribeToggle}"
                        Content="&#xE774;" FontFamily="Segoe MDL2 Assets"
                        Click="BridgeFeedSubscribeToggle_Click" Padding="8"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        ToolTipService.ToolTip="{loc:Localize Key=feed/list/subscribe_bridge}" />
            </StackPanel>

            <Button Grid.Column="1" x:Name="RefreshButton"
                    Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                    Click="RefreshButton_Click" Padding="8"
                    ToolTipService.ToolTip="{loc:Localize Key=common/refresh}" />
        </Grid>

        <!-- Feed search bar + the report acknowledgement beneath it (`report-status`,
             moderation.md § User-initiated reporting → What the reporter is told). The
             acknowledgement lives OUTSIDE the report sheet — the sheet is closed by
             the time a landed report is acknowledged — and is present only after a
             send landed (collapsed → no UIA peer). AutomationId only, no static Name,
             so get_text reads the sentence. -->
        <StackPanel Grid.Row="1">
        <Grid Padding="16,0,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox Grid.Column="0" x:Name="FeedSearchBox"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedSearchField}"
                            QueryIcon="Find"
                            TextChanged="FeedSearchBox_TextChanged" />
            <Button Grid.Column="1" x:Name="FeedSearchClearButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedSearchClear}"
                    Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                    Click="FeedSearchClear_Click" Padding="8"
                    Visibility="Collapsed" Margin="4,0,0,0" />
        </Grid>
        <!-- The imported-posts selection's notice + clear (feed.md § The imported-posts
             selection) ← snapshot.imported_selected; collapsed (no UIA peer) unless it
             names a platform. -->
        <Grid x:Name="ImportedRow" Padding="16,0,16,4" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="ImportedNotice"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedImportedNotice}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" x:Name="ImportedClearButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedImportedClear}"
                    Click="ImportedClear_Click" />
        </Grid>
        <TextBlock x:Name="ReportStatusText"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.ReportStatus}"
                   Margin="16,0,16,4" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="Collapsed" />
        </StackPanel>

        <!-- Post list -->
        <!-- No IsItemClickEnabled: each post-card DataTemplate root is itself a
             Button (PostCard_Click) — the row-open path — so a ListView ItemClick
             would double-open the detail dialog (event-card/AgendaPanel precedent). -->
        <ListView Grid.Row="2" x:Name="PostsList" AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedView}" Padding="16,0"
                  SelectionMode="None" ItemTemplate="{StaticResource PostCardTemplate}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Non-virtualizing panel so count("post-card") sees every row
                         even when offscreen — a virtualizing ItemsStackPanel only
                         realizes visible rows, making the post count vary with scroll
                         position (e.g. after a feed search→clear). Matches the
                         feed-rail ListView above (memory: bounded count-all lists). -->
                    <StackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <!-- ItemTemplate: the shared post-card (Controls/PostCardTemplates.xaml),
                 set on the ListView element; the profile Posts tab paints the same one. -->

            <ListView.Footer>
                <Button x:Name="LoadMoreButton"
                        HorizontalAlignment="Center" Margin="0,8"
                        Click="LoadMoreButton_Click"
                        Content="{loc:Localize Key=common/load_more}" />
            </ListView.Footer>
        </ListView>

        <!-- The feed's two empty states (`ui/feed.md` § Errors & edge cases), at most one
             shown: painted in Refresh() off FeedViewModel.EmptyState — the shared
             FeedSnapshot::empty_state over UniFFI — so both stay absent while a read is
             in flight or posts are on screen. AutomationId only, no static Name, so
             get_text reads the copy (the MediaPage EmptyText shape). -->
        <TextBlock Grid.Row="2" x:Name="FeedEmptyStateText"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedEmptyState}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{loc:Localize Key=feed/list/no_posts}"
                   Visibility="Collapsed" />
        <TextBlock Grid.Row="2" x:Name="FeedNoResultsText"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedNoResults}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{loc:Localize Key=feed/list/no_matching_posts}"
                   Visibility="Collapsed" />

        <!-- Loading indicator -->
        <ProgressRing Grid.Row="2" x:Name="LoadingRing"
                      IsActive="False" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Compose bar (text + tags + post + dialog button) -->
        <controls:FeedComposeBar Grid.Row="3" x:Name="ComposeBar" Margin="16,0" />

        <!-- Error/Warning display. ErrorBar is a CopyableInfoBar because THAT is
             what carries `error-message` (its inner InfoBar stamps
             ids:Ids.ErrorMessage), the same shape ConversationsPage and
             NotificationsPage already use. A bare InfoBar here left the page's
             only visible error surface untagged, so a real feed failure was
             visible to the user and invisible to every e2e — convention 2
             unmet on this page, which is exactly what the missing
             `feed-read` 7 witness was hiding. -->
        <controls:CopyableInfoBar Grid.Row="3" x:Name="ErrorBar"
                 Severity="Error" IsOpen="False" IsClosable="True"
                 Margin="16,0,16,60" />
        <InfoBar Grid.Row="3" x:Name="WarningBar"
                 Severity="Warning" IsOpen="False" IsClosable="True"
                 Margin="16,0,16,30" />
        <!-- Compose state indicators (compose-error kept for error display) -->
        <InfoBar Grid.Row="3" x:Name="ComposeErrorBar"
                 AutomationProperties.AutomationId="{x:Bind ids:Ids.ComposeError}"
                 Severity="Error" IsOpen="False" IsClosable="True"
                 Visibility="Collapsed"
                 Margin="16,0,16,90" />
        <!-- Image Lightbox (image-lightbox) — the shared overlay the profile's Posts tab
             hosts too; Controls/ImageLightboxOverlay.xaml says why it is a toggled Button
             and not a ContentDialog. Grid.RowSpan covers every row so it overlays the
             whole page. -->
        <controls:ImageLightboxOverlay x:Name="Lightbox" Grid.RowSpan="4" />

        <!-- Tip attribution window — excised in a store-safe build, same rationale and
             mechanism as TipDisplayHost above. The markup lives in
             Views/Payments/PostTipListDialog.xaml; the page's PostCardHost fills this host
             under `#if PAYMENTS`, and both the list card's and the detail dialog's "open"
             requests land in it. -->
        <ContentControl x:Name="TipListDialogHost" Grid.RowSpan="4"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Bridge feed subscription form -->
        <StackPanel Grid.Row="0" x:Name="BridgeFeedPanel" Visibility="Collapsed"
                    Spacing="8" Padding="16,8">
            <!-- Options are the nest's available bridges (id+name), set from
                 SyncAvailableBridges — NOT a hard-coded protocol list, so a
                 bluesky-only nest never offers nostr/activitypub
                 (version-compatibility.md § Dimension 3). Each item is hand-built in
                 SyncAvailableBridges: Content is the human `name`, Tag and the UIA Name
                 are the `id` — the selected item's `id` is the subscribe kind, and the
                 cross-app `select` takes it. -->
            <ComboBox x:Name="BridgeTypeSelector"
                      AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFormBridgeSelect}"
                      MinWidth="160" />
            <TextBox x:Name="BridgeFeedUriBox"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFormUriInput}"
                     PlaceholderText="{loc:Localize Key=feed/bridge_form/uri}" />
            <TextBox x:Name="BridgeFeedNameBox"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFormNameInput}"
                     PlaceholderText="{loc:Localize Key=feed/bridge_form/name}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFormSubscribeButton}"
                        Content="{loc:Localize Key=feed/list/subscribe_bridge}" Style="{StaticResource AccentButtonStyle}"
                        Click="BridgeFeedSubscribe_Click" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFormCancelButton}"
                        Content="{loc:Localize Key=common/cancel}" Click="BridgeFeedCancel_Click" />
            </StackPanel>
        </StackPanel>
        <Button Grid.Row="0" x:Name="BridgeFeedUnsubscribeBtn"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgeFeedUnsubscribeButton}"
                Click="BridgeFeedUnsubscribe_Click"
                Visibility="Collapsed" />

        <!-- The `error-message` mirror that used to sit here is GONE: it was
             declared Visibility="Collapsed" (contradicting its own comment), so
             it never realized a UIA peer and the id it carried was unobservable
             — while the bar the user actually sees carried no id at all. The id
             now lives on ErrorBar above, via CopyableInfoBar, which is both
             visible and findable (proven on ConversationsPage, whose
             oversized-attachment journey asserts is_visible("error-message") on
             that very control). WarningTextMirror below is untouched: nothing
             in this batch witnesses `warning-message`, and rewiring it blind
             would be a change no test here could check. -->
        <TextBlock Grid.Row="0" x:Name="WarningTextMirror"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.WarningMessage}"
                   AutomationProperties.Name=" "
                   Text=" " FontSize="1" Height="1" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
