<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.SettingsLogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:logs="using:FaunaApp.Core.Logs"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!--
      Settings → Logs (observability.md § Surfaces) — the client's durable log record
      (the process-global fauna_log ring). Renders snapshot() newest-first with a
      severity filter (log-level-filter), copy (log-copy-button), and clear
      (log-clear-button). Mirrors linux settings/logs.rs; the row shape / time format
      / filter↔level map live in the shared FaunaApp.Core LogsFormat both Logs
      surfaces use. No nest handle — the ring is a process global the page reads over
      the ILogRing seam (FfiLogRing). Redaction: this renders only what tracing
      captured; call sites never log secrets (observability.md § Persistence & privacy).
    -->

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

            <controls:CopyableInfoBar
                x:Name="ErrorBar"
                Severity="Error" IsOpen="False" IsClosable="True" />

            <!-- settings-logs — page landmark (the e2e is_page_visible waits on it). -->
            <TextBlock x:Name="Heading"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.SettingsLogs}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{loc:Localize Key=logs/title}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="{loc:Localize Key=logs/description}" />

            <!-- Severity filter + copy + clear -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FilterCombo" Grid.Column="0"
                          AutomationProperties.AutomationId="{x:Bind ids:Ids.LogLevelFilter}"
                          Header="{loc:Localize Key=logs/filter_label}"
                          SelectedIndex="0"
                          SelectionChanged="FilterCombo_SelectionChanged">
                    <ComboBoxItem Content="{loc:Localize Key=logs/filter_all}" />
                    <ComboBoxItem Content="{loc:Localize Key=logs/level_error}" />
                    <ComboBoxItem Content="{loc:Localize Key=logs/level_warn}" />
                    <ComboBoxItem Content="{loc:Localize Key=logs/level_info}" />
                    <ComboBoxItem Content="{loc:Localize Key=logs/level_debug}" />
                    <ComboBoxItem Content="{loc:Localize Key=logs/level_trace}" />
                </ComboBox>
                <Button x:Name="CopyButton" Grid.Column="1" VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.LogCopyButton}"
                        Click="CopyButton_Click"
                        Content="{loc:Localize Key=logs/copy_button}" />
                <Button x:Name="ClearButton" Grid.Column="2" VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.LogClearButton}"
                        Click="ClearButton_Click"
                        Content="{loc:Localize Key=logs/clear_button}" />
            </Grid>

            <TextBlock x:Name="EmptyPlaceholder" Opacity="0.6" Visibility="Collapsed"
                       Text="{loc:Localize Key=logs/empty}" />

            <!-- log-entry rows, newest-first. ItemsControl is non-virtualizing, so the
                 e2e bounded count-all realizes every row; each row root carries the
                 log-entry AutomationId + a non-empty Name so FlaUI counts it
                 (reference_winui_flaui_datatemplate_name). -->
            <ItemsControl x:Name="LogList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="logs:LogRow">
                        <StackPanel AutomationProperties.AutomationId="{x:Bind ids:Ids.LogEntry}"
                                    AutomationProperties.Name="{x:Bind Line}"
                                    Spacing="2" Padding="0,6">
                            <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
