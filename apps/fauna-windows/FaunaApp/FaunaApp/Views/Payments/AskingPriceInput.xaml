<?xml version="1.0" encoding="utf-8"?>
<!--
  The single gated INPUT for the machine asking-price (monetization.md § The
  asking price; dynamic-features.md § Platform-family surface excision → "A
  gated plane's user-facing INPUTS excise with it"). Two call sites reuse this
  one control rather than each hand-rolling a TextBox: the subscription-tier
  form (`subscription-tier-form-asking-price`, ProfilePage) and the sell-post
  composer (`compose-sell-asking-price`, FeedComposeBar).

  ⚠ THIS FILE IS PART OF THE EXCISION UNIT for the same reason
  PaymentsAuthorSections.xaml is (see that file's header) — XAML has no
  preprocessor, so only removing the ITEM (FaunaApp.csproj's
  `Views\Payments\**` glob, store-safe only) removes the AutomationId literal
  from the compiled artifact. NOTHING may reference this type from markup;
  each host page's `#if PAYMENTS` code-behind instantiates it and sets its
  AutomationId/Header/PlaceholderText, then drops it into a ContentControl —
  the same indirection ProfilePage already uses for PaymentsSectionsHost.
-->
<UserControl
    x:Class="FaunaApp.Views.Payments.AskingPriceInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Whole-sats free text (`sats: u64, checked, no clamp` — the FFI call
         this feeds refuses rather than truncates an overflow; a client-side
         parse failure here is treated the same as empty, matching every
         other app's leg: no machine price, never an error). -->
    <TextBox x:Name="Box" InputScope="Number" />
</UserControl>
