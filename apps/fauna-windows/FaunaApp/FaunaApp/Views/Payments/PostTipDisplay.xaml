<?xml version="1.0" encoding="utf-8"?>
<!--
  The tip display surface on a post card (monetization.md § Tips): attribution +
  display only, unlocks nothing. post-tip-total and post-tip-count are guarded
  INDEPENDENTLY — a post can have real tips (HasTips) with no summable amount
  (HasTipTotal false), which is why they read two different bools, never one.
  post-tip-list-button opens the flat post-tip-list dialog (PostTipListDialog.xaml,
  same folder) via the OpenTipListRequested event.

  ⚠ THIS FILE IS THE EXCISION UNIT (same rationale as PaymentsAuthorSections.xaml in
  this folder): FeedPage's per-card DataTemplate hosts one of these per realized
  item through a ContentControl its `#if PAYMENTS` code-behind fills
  (PostsList_ContainerContentChanging) — never a `<payments:PostTipDisplay/>`
  element in FeedPage.xaml, which would fail to compile once FaunaApp.csproj drops
  Views\Payments\** for a store-safe build.
-->
<UserControl
    x:Class="FaunaApp.Views.Payments.PostTipDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:ids="using:FaunaApp.UiIds">

    <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock x:Name="TipTotalText"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.PostTipTotal}"
                   FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
        <TextBlock x:Name="TipCountText"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.PostTipCount}"
                   FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
        <Button x:Name="TipListButton"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.PostTipListButton}"
                Click="TipListButton_Click"
                Content="{loc:Localize Key=tips/list_open}"
                FontSize="10" Padding="4,1" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
