<?xml version="1.0" encoding="utf-8"?>
<!--
  Tip attribution window (post-tip-list / post-tip-item, monetization.md § Tips) —
  opened by a card's post-tip-list-button (PostTipDisplay.OpenTipListRequested) or the
  detail dialog's own tip row. An inline Border + Visibility toggle, NOT a
  ContentDialog: a modal ContentDialog does not reliably surface to the FlaUI
  is_visible tree in this app (the same discovery AdminDnsPage's RenameSheet
  documents — "a modal ContentDialog does NOT surface ... to the FlaUI is_visible
  tree; the Border+Visibility idiom does"). Flat, not scoped: exactly one open at a
  time (mirrors FeedPage's image-lightbox framing and tui's identical "painted flat"
  choice). Title carries the "and N more" tail from the nest's own has_more flag
  (the caller's precomputed title, never a length-comparison inferred here). Every
  row the nest sent renders, unfiltered — trust is settled at ingest, never at read
  (§ Zap receipts); an unattributed tipper (sender_ref, no local actor) still shows.

  ⚠ THIS FILE IS THE EXCISION UNIT — see PaymentsAuthorSections.xaml's header for the
  full rationale. FeedPage hosts one instance through a ContentControl its
  `#if PAYMENTS` code-behind fills; nothing may reference this type from FeedPage.xaml.
-->
<UserControl
    x:Class="FaunaApp.Views.Payments.PostTipListDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:ids="using:FaunaApp.UiIds">

    <Border x:Name="Root"
            AutomationProperties.AutomationId="{x:Bind ids:Ids.PostTipList}"
            AutomationProperties.Name="{loc:Localize Key=tips/list_title}"
            Visibility="Collapsed"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="6" Padding="12"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="4" MinWidth="280">
            <TextBlock x:Name="TitleText" FontWeight="SemiBold" />
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TipSenderRow">
                        <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PostTipItem}"
                                   Text="{x:Bind DisplayText}" FontSize="12" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Right" Margin="0,8,0,0"
                    Content="{loc:Localize Key=common/close}"
                    Click="Close_Click" />
        </StackPanel>
    </Border>
</UserControl>
