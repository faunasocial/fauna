<?xml version="1.0" encoding="utf-8"?>
<!--
  The price column of one row in the author's own tier list (monetization.md
  § Pillar 1). Inside the payments plane because it exists only to state a price
  (dynamic-features.md § Platform-family surface excision → The price-and-route
  class); the row's name, rank, edit and delete stay in ProfilePage's DataTemplate.

  ⚠ THIS FILE IS PART OF THE EXCISION UNIT (see PaymentsAuthorSections.xaml's
  header). ProfilePage's tier-row DataTemplate hosts one of these per row through
  a ContentControl whose Loaded handler fills it under `#if PAYMENTS`; nothing
  outside Views\Payments\ may name this type from markup.
-->
<UserControl
    x:Class="FaunaApp.Views.Payments.SubscriptionTierPriceText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ids="using:FaunaApp.UiIds">

    <TextBlock x:Name="PriceText"
               AutomationProperties.AutomationId="{x:Bind ids:Ids.SubscriptionTierPrice}"
               VerticalAlignment="Center" />
</UserControl>
