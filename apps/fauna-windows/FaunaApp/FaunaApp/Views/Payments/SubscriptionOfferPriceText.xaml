<?xml version="1.0" encoding="utf-8"?>
<!--
  The price line of one offered tier on another actor's profile (monetization.md
  § Pillar 1 surface 2). Inside the payments plane because it exists only to state a
  price (dynamic-features.md § Platform-family surface excision → The price-and-route
  class); the offer's name, description, status and Subscribe button stay in
  ProfilePage's DataTemplate, so a store-safe build shows a priced tier as an
  ordinary approval-gated one.

  ⚠ THIS FILE IS PART OF THE EXCISION UNIT (see PaymentsAuthorSections.xaml's
  header). ProfilePage's offer-row DataTemplate hosts one of these per row through
  a ContentControl whose Loaded handler fills it under `#if PAYMENTS`; nothing
  outside Views\Payments\ may name this type from markup.
-->
<UserControl
    x:Class="FaunaApp.Views.Payments.SubscriptionOfferPriceText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ids="using:FaunaApp.UiIds">

    <TextBlock x:Name="PriceText"
               AutomationProperties.AutomationId="{x:Bind ids:Ids.SubscriptionOfferPrice}"
               Opacity="0.7" />
</UserControl>
