<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.AdminAliasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!--
      Admin page: external mail forwarders (admin-aliases, admin.md § 4 /
      mail-aliases.md § Kind 7). A dumb renderer of the shared ForwarderMachine
      (libs/fauna-client-mail-settings, exposed over UniFFI by
      libs/fauna-ffi/src/mail_admin.rs build_forwarders_machine) through the
      testable AdminAliasesViewModel (FaunaApp.Core): the VM owns the WS-RPC
      (fauna.bridges.{list,create,delete}_forwarder + list_local_domains), the
      <pattern>@<domain> address render, the hex alias-id round-trip, and the
      refresh-then-act sequencing; this page only binds the snapshot rows / picker
      domains and forwards the add/delete gestures. Catch-all designation (Kind 4)
      is deferred — it rides admin-dns, not this page (admin.md § 4). Prior art:
      AdminUsersPage (VM-driven indexed list) + apps/fauna-linux/src/views/admin.rs
      (build_admin_aliases_page).
    -->
    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

            <!-- App-wide error surface (also mirrored below for the state protocol) -->
            <controls:CopyableInfoBar x:Name="ErrorBar"
                     Severity="Error" IsOpen="False" IsClosable="True" />

            <!-- Header -->
            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesHeading}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{loc:Localize Key=admin/aliases_page/title}" />

            <ProgressRing x:Name="LoadProgress" IsActive="False"
                          Visibility="Collapsed" HorizontalAlignment="Left" />

            <!-- Dedicated forwarder action-error (admin.md § 4 Errors —
                 conflicts_with_existing_alias / validate_forward_target /
                 reserved_local_part failures route here). -->
            <TextBlock x:Name="ActionError"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesActionError}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <!-- Hidden mirrors keep the app-wide IDs present for infra (state-protocol read). -->
            <TextBlock x:Name="ErrorTextMirror"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.ErrorMessage}"
                       AutomationProperties.Name=" " Text=" " FontSize="1" Height="1" Visibility="Collapsed" />
            <TextBlock x:Name="WarningTextMirror"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.WarningMessage}"
                       AutomationProperties.Name=" " Text=" " FontSize="1" Height="1" Visibility="Collapsed" />

            <!-- ════ External forwarders (Kind 7) ════
                 Section container = header + description + add form (always-visible
                 content, so the page-presence anchor admin-aliases-forwarders-section
                 never collapses; e2e polls it instead of the shared page heading). -->
            <StackPanel AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesForwardersSection}"
                        AutomationProperties.Name="{loc:Localize Key=admin/aliases_page/forwarders_title}"
                        Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{loc:Localize Key=admin/aliases_page/forwarders_title}" />
                <TextBlock Opacity="0.7" TextWrapping="Wrap"
                           Text="{loc:Localize Key=admin/aliases_page/forwarders_desc}" />

                <!-- Add form: hosted-domain picker + local-part + external target +
                     submit. The picker (a native ComboBox — the converged cross-app
                     select shape) is populated from the snapshot's hosted domains; a
                     forwarder must live on one of them. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="DomainSelect" Grid.Column="0"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesForwarderAddDomainSelect}"
                              MinWidth="140" VerticalAlignment="Center"
                              PlaceholderText="{loc:Localize Key=admin/aliases_page/forwarder_domain}" />
                    <TextBox x:Name="PatternInput" Grid.Column="1"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesForwarderAddPatternInput}"
                             Width="120" VerticalAlignment="Center"
                             PlaceholderText="{loc:Localize Key=admin/aliases_page/forwarder_local_part_placeholder}" />
                    <TextBox x:Name="TargetInput" Grid.Column="2"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesForwarderAddTargetInput}"
                             VerticalAlignment="Center"
                             PlaceholderText="{loc:Localize Key=admin/aliases_page/forwarder_target_placeholder}" />
                    <Button Grid.Column="3"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesForwarderAddSubmitButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="AddForwarderSubmit_Click"
                            VerticalAlignment="Center"
                            Content="{loc:Localize Key=admin/aliases_page/create_forwarder}" />
                </Grid>
            </StackPanel>

            <!-- Empty-state caption (mirrors linux no_forwarders); hidden once a
                 forwarder exists. Not a forwarder row, so it never counts. -->
            <TextBlock x:Name="NoForwardersText" Opacity="0.5" TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Text="{loc:Localize Key=admin/aliases_page/no_forwarders}" />

            <!-- Indexed forwarder list (admin-aliases-forwarder-list). Non-virtualizing
                 StackPanel item panel so FlaUI counts every row; each row carries a
                 non-empty AutomationProperties.Name (the source address) so the row
                 peer resolves (the Missing-Name list-count sweep). -->
            <ItemsControl x:Name="ForwardersList"
                          AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesForwarderList}"
                          AutomationProperties.Name="{loc:Localize Key=admin/aliases_page/title}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ForwarderRowVm">
                        <Grid Padding="8,12" ColumnSpacing="12"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,0,0,1"
                              AutomationProperties.Name="{x:Bind Address}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesForwarderRowAddress}"
                                       Text="{x:Bind Address}"
                                       FontFamily="Consolas" FontSize="13"
                                       IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesForwarderRowTarget}"
                                       Text="{x:Bind Target}"
                                       Opacity="0.8" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminAliasesForwarderRowDeleteButton}"
                                    Loaded="DeleteForwarderButton_Loaded"
                                    Click="DeleteForwarder_Click"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
