<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">

            <!-- Error bar -->
            <controls:CopyableInfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="True" />

            <!-- Header + Refresh -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource TitleTextBlockStyle}"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                    Text="{loc:Localize Key=common/status}" />

                <Button
                    Grid.Column="1"
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="{loc:Localize Key=common/refresh}" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressRing
                x:Name="LoadProgress"
                IsActive="False"
                Visibility="Collapsed"
                HorizontalAlignment="Left" />

            <!-- Connection status -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{loc:Localize Key=devices/peers/connection}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse
                        x:Name="ConnectionDot"
                        Width="12" Height="12"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="ConnectionText"
                        Text="{loc:Localize Key=common/unknown}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Service info / Account identity — carries the cross-platform
                 `account-settings-link` page landmark (linux status.rs +
                 web +page.svelte both fold it onto their default Status
                 sub-page the same way; settings.md § Navigation model).
                 AutomationProperties.Name required: a bare layout StackPanel
                 with only an AutomationId is pruned from the UIA tree (same
                 trap as quota-section below). -->
            <StackPanel Spacing="8" AutomationProperties.AutomationId="{x:Bind ids:Ids.AccountSettingsLink}"
                        AutomationProperties.Name="Account">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{loc:Localize Key=status/connection/service}" />

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Opacity="0.7" Text="{loc:Localize Key=admin/dashboard/version}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionText" Text="--" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.7" Text="{loc:Localize Key=admin/view/uptime}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UptimeText" Text="--" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.7" Text="{loc:Localize Key=common/actor_id}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ActorIdText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.AccountActorId}"
                               Text="--" IsTextSelectionEnabled="True" FontFamily="Consolas" />
                    <Button Grid.Row="2" Grid.Column="2" x:Name="StatusActorIdCopyButton"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.StatusActorIdCopyBtn}"
                            Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                            FontSize="10" Padding="4,2" Click="CopyActorId_Click"
                            ToolTipService.ToolTip="{loc:Localize Key=common/copy}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Opacity="0.7" Text="{loc:Localize Key=common/handle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="HandleText" Text="--" />

                    <TextBlock Grid.Row="4" Grid.Column="0" x:Name="NestUrlLabel" Opacity="0.7" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="NestUrlText" Text="--" IsTextSelectionEnabled="True" />
                    <Button Grid.Row="4" Grid.Column="2" x:Name="StatusNodeUrlCopyButton"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.StatusNodeUrlCopyBtn}"
                            Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                            FontSize="10" Padding="4,2" Click="CopyNestUrl_Click"
                            ToolTipService.ToolTip="{loc:Localize Key=common/copy}" />
                </Grid>

                <!-- Transient "Copied!" confirmation after a copy click (observability.md §
                     What must be logged, category 1 — the displayed line ViewModel_PropertyChanged
                     paints from StatusViewModel.NoticeMessage also logs at info, via
                     ViewModelBase.SetNotice). No AutomationId: nothing reads this element by id,
                     the copy buttons' own `copied` HelpText attr is the e2e contract (mirrors
                     MailAliasesPanel's un-id'd MintedToast). -->
                <TextBlock x:Name="CopyToast" Opacity="0.7" FontSize="12" Visibility="Collapsed" />
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Sync summary -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{loc:Localize Key=common/sync}" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse
                        x:Name="SyncDot"
                        Width="12" Height="12"
                        VerticalAlignment="Center" />
                    <TextBlock
                        x:Name="SyncStatusText"
                        Text="{loc:Localize Key=common/unknown}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <Grid RowSpacing="8" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- One combined row, matching tui's `status-sync-pending` shape
                         (status.md § State & data shape: "the shared status.sync.pending_summary
                         string over the file count and byte_size" — a single row, not
                         separate files/bytes rows; resolve drift toward the richer
                         existing pattern, priority #4). -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Opacity="0.7" Text="{loc:Localize Key=common/pending}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FilesPendingText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.StatusSyncPending}"
                               Text="0" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.7" Text="{loc:Localize Key=status/sync/last_sync}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastSyncText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.StatusSyncLast}"
                               Text="--" />
                </Grid>
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- MLS Encryption -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{loc:Localize Key=settings/encryption_page/title}" />
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Opacity="0.7" Text="{loc:Localize Key=status/encryption/mls_engine}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="MlsInitText" Text="--" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.7" Text="{loc:Localize Key=status/encryption/key_packages}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="KeyPackageCountText" Text="--" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.7" Text="{loc:Localize Key=status/encryption/dm_channels}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DmChannelCountText" Text="--" />
                </Grid>
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Quota section (folded in from the old SettingsPage so the live
                 nest quota the e2e reads — quota-inbox/quota-storage/quota-devices —
                 sits on the Settings shell's default Status sub-page, readable
                 without navigating; settings.md § Navigation model).
                 AutomationProperties.Name required: a bare layout StackPanel with
                 only an AutomationId is pruned from the UIA tree, so
                 is_visible/wait_for("quota-section") fails (the prune trap). -->
            <StackPanel Spacing="8" AutomationProperties.AutomationId="{x:Bind ids:Ids.QuotaSection}"
                        AutomationProperties.Name="Quota">
                <TextBlock x:Name="QuotaHeader" Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Localize Key=status/quota/title}" />
                <Grid RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Localize Key=common/inbox}" Opacity="0.7" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               x:Name="QuotaInboxText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.QuotaInbox}" Text="--" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Localize Key=common/storage}" Opacity="0.7" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               x:Name="QuotaStorageText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.QuotaStorage}" Text="--" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Localize Key=common/devices}" Opacity="0.7" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               x:Name="QuotaDevicesText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.QuotaDevices}" Text="--" />
                </Grid>
            </StackPanel>

            <!-- Feature limits (dynamic-features.md § Transparency & auditability;
                 settings.md § Layout & flow item 2b) — the controversial-class feature
                 plane's transparency read, placed directly after Quota as its sibling
                 "what bounds me" surface. Collapsed until the read resolves (ui.yaml
                 feature-limits-section: "registers only once fauna.features.status
                 resolves — like quota-section, so waiting on it waits for real data")
                 — unlike THIS page's own quota-section, which has no such gate; this
                 section follows the cross-app contract, not the pre-existing local
                 precedent. AutomationProperties.Name required, same prune trap as
                 quota-section above. -->
            <StackPanel x:Name="FeatureLimitsSection" Spacing="8"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.FeatureLimitsSection}"
                        AutomationProperties.Name="Feature Limits"
                        Visibility="Collapsed">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Localize Key=features/section_title}" />
                <TextBlock x:Name="FeatureLimitsEmptyText"
                           AutomationProperties.AutomationId="{x:Bind ids:Ids.FeatureLimitsEmpty}"
                           Text="{loc:Localize Key=features/empty}"
                           Visibility="Collapsed" />
                <!-- Rows built imperatively in code-behind (StatusPage.xaml.cs
                     UpdateFeatureLimits) — the row set + its per-row cell count are
                     both variable, unlike quota's fixed three fields. -->
                <StackPanel x:Name="FeatureLimitsRowsPanel" Spacing="12" />
            </StackPanel>

            <!-- Region (region-blocking.md § The blocked render and the transparency
                 surface; settings.md's Status sub-page, after feature limits — the
                 same home linux, web and the apple apps give it). The device's
                 declared region and its source (with the change path named — there
                 is no in-app override), each regional content policy in force, when
                 it was last checked, and the staleness warning. Painted in
                 code-behind from the shared FfiRegionPlane.view()
                 (StatusPage.PaintRegion); a device-level fact, so it paints even
                 before any nest read resolves. Named, like the sections above, so
                 UIA does not prune it. -->
            <StackPanel x:Name="RegionSection" Spacing="8"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.SettingsRegionSection}"
                        AutomationProperties.Name="Region">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Localize Key=region/section_title}" />
                <StackPanel x:Name="RegionRowsPanel" Spacing="8" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
