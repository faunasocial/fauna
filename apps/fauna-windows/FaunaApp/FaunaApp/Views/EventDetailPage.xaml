<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.EventDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:viewmodels="using:FaunaApp.Core.ViewModels"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <Page.Resources>
        <local:AttendeeRsvpColorConverter x:Key="RsvpColor" />
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailBack}"
                    Click="BackButton_Click">
                <SymbolIcon Symbol="Back" />
            </Button>

            <TextBlock x:Name="SummaryText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailSummary}"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="TimeText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailTime}"
                       Opacity="0.7" />
            <TextBlock x:Name="DtStartText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDtstart}"
                       Visibility="Collapsed" />
            <TextBlock x:Name="DtEndText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDtend}"
                       Visibility="Collapsed" />
            <TextBlock x:Name="LocationText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailLocation}"
                       Opacity="0.7" />
            <TextBlock x:Name="DescriptionText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailDescription}"
                       TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailRsvpGoing}"
                        Content="{loc:Localize Key=events/rsvp/going}" Click="RsvpGoing_Click" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailRsvpInterested}"
                        Content="{loc:Localize Key=events/rsvp/interested}" Click="RsvpInterested_Click" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailRsvpDecline}"
                        Content="{loc:Localize Key=events/rsvp/decline}" Click="RsvpDecline_Click" />
                <TextBlock x:Name="RsvpStatusText" VerticalAlignment="Center"
                           Opacity="0.6" FontSize="12" />
                <Button x:Name="DeleteButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDeleteBtn}"
                        AutomationProperties.Name="event-delete-btn"
                        Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                        Click="DeleteButton_Click"
                        ToolTipService.ToolTip="{loc:Localize Key=events/delete_event}"
                        Margin="16,0,0,0" />
            </StackPanel>

            <!-- Per-event reminder (event-reminder component; ui.yaml § events).
                 Mirrors linux/web: a preset select + Set when none is set, flipping
                 to a current-label + Remove once a reminder is set. The ComboBoxItem
                 AutomationProperties.Name is the ICS offset so driver.select matches
                 it; Tag carries the same offset for the Set handler. -->
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Localize Key=events/reminder/title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <StackPanel x:Name="ReminderSetPanel" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="ReminderSelect"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailReminderSelect}"
                              PlaceholderText="{loc:Localize Key=events/reminder/select_placeholder}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailReminderSet}"
                            AutomationProperties.Name="event-detail-reminder-set"
                            Content="{loc:Localize Key=events/reminder/set}" Click="SetReminder_Click" />
                </StackPanel>
                <StackPanel x:Name="ReminderCurrentPanel" Orientation="Horizontal"
                            Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="ReminderCurrentText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailReminderCurrent}"
                               VerticalAlignment="Center" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.EventDetailReminderRemove}"
                            AutomationProperties.Name="event-detail-reminder-remove"
                            Content="{loc:Localize Key=common/remove}" Click="RemoveReminder_Click" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{loc:Localize Key=events/attendees}" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="AttendeesList"
                      AutomationProperties.AutomationId="{x:Bind ids:Ids.AttendeeList}"
                      SelectionMode="None" MaxHeight="300">
                <ListView.ItemTemplate>
                    <!-- attendee-item: canonical enriched row shape (events.md § Attendee
                         list presentation, 2026-06-23) — monogram circle + display name +
                         email line (omitted when name == email) + colored RSVP status.
                         Uses x:DataType so x:Bind resolves the computed properties on
                         AttendeeInfo at compile time (no Binding fallback at runtime). -->
                    <DataTemplate x:DataType="viewmodels:AttendeeInfo">
                        <Grid Padding="4" ColumnSpacing="10"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.AttendeeItem}"
                              AutomationProperties.Name="{x:Bind Email}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />    <!-- monogram -->
                                <ColumnDefinition Width="*" />     <!-- name + email -->
                                <ColumnDefinition Width="Auto" />  <!-- rsvp status -->
                            </Grid.ColumnDefinitions>

                            <!-- Monogram circle -->
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                    Background="{ThemeResource SystemAccentColor}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Monogram}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Display name + optional email line beneath -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.AttendeeId}"
                                           Text="{x:Bind DisplayName}"
                                           FontSize="12"
                                           IsTextSelectionEnabled="True" />
                                <!-- Email line is display-only (no test ID); asserted by
                                     text per the attendee-rows decision (events.md § Attendee
                                     list presentation). EmailLine is null when name == email,
                                     so the TextBlock shows an empty string (zero visual height)
                                     but remains in the tree for layout continuity. -->
                                <TextBlock Text="{x:Bind EmailLine}"
                                           FontSize="11" Opacity="0.6"
                                           IsTextSelectionEnabled="True" />
                            </StackPanel>

                            <!-- Colored RSVP status -->
                            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.AttendeeStatus}"
                                       Grid.Column="2"
                                       Text="{x:Bind RsvpLabel}"
                                       Foreground="{x:Bind RsvpHexColor, Converter={StaticResource RsvpColor}}"
                                       FontSize="11" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="InviteRow" Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="InviteActorIdBox"
                         AutomationProperties.AutomationId="{x:Bind ids:Ids.AttendeeInviteField}"
                         Width="300" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.AttendeeInviteButton}"
                        Content="{loc:Localize Key=events/invite/button}" Click="InviteButton_Click" />
            </StackPanel>

            <controls:CopyableInfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
            <ProgressRing x:Name="LoadProgress" IsActive="False" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
