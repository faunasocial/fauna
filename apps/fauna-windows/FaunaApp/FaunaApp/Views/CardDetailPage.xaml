<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.CardDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FaunaApp.Markup"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!-- Read-only vCard detail pane (slice 4b — no write UI). Mirrors
         EventDetailPage's structure (ui.yaml contacts § card_detail sub_page):
         a back button (real Frame navigation, the windows master→detail
         convention) + FN header + ORG/EMAIL/TEL/ADR/NOTE. The already-decoded
         CardInfo rides the nav args directly (CardDetailNavigationArgs), so
         Page_Loaded just renders — no FFI round-trip needed. -->
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="700" HorizontalAlignment="Left">
            <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.CardDetailBack}"
                    Click="BackButton_Click">
                <SymbolIcon Symbol="Back" />
            </Button>

            <!-- vcard-detail-fn: AutomationId ONLY, no static Name — a dynamic-text
                 TextBlock's e2e get_text must read the assigned Text via the WinUI
                 auto-derived Name, which a hardcoded Name would shadow
                 (reference_windows_flaui_gettext_dynamic_label_no_name). Same rule
                 applies to every vcard-detail-* TextBlock below. -->
            <TextBlock x:Name="FnText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.VcardDetailFn}"
                       Style="{StaticResource TitleTextBlockStyle}" />

            <!-- TITLE — display-only, no test id (ui.yaml's card_detail sub_page
                 doesn't define one; mirrors linux/web, which also render TITLE
                 without a dedicated element). -->
            <TextBlock x:Name="TitleText"
                       Opacity="0.7"
                       Visibility="Collapsed" />

            <TextBlock x:Name="OrgText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.VcardDetailOrg}"
                       Opacity="0.7"
                       Visibility="Collapsed" />

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Localize Key=contacts/address_book/email}"
                           Opacity="0.5" FontSize="12" />
                <ItemsControl x:Name="EmailsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Non-virtualizing panel so count("vcard-detail-email")
                                 sees every row even when offscreen. -->
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}"
                                       AutomationProperties.AutomationId="{x:Bind ids:Ids.VcardDetailEmail}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Localize Key=contacts/address_book/phone}"
                           Opacity="0.5" FontSize="12" />
                <ItemsControl x:Name="TelsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}"
                                       AutomationProperties.AutomationId="{x:Bind ids:Ids.VcardDetailTel}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{loc:Localize Key=contacts/address_book/address}"
                           Opacity="0.5" FontSize="12" />
                <ItemsControl x:Name="AddressesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <!-- FfiPostalAddress.Formatted is already the single
                                 human-readable line (shared-crate render); rendered
                                 verbatim, same as linux/web. -->
                            <TextBlock Text="{x:Bind}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="{x:Bind ids:Ids.VcardDetailAdr}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="NoteText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.VcardDetailNote}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
