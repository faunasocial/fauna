<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.VpsConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FaunaApp.Views.Onboarding"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Error display: shared element, must be present on every page
                 per the cross-app e2e contract. Mirrors DnsConfigView. -->
            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Text="{loc:Localize Key=onboarding/vps_config/title}"
                           HorizontalAlignment="Center" />

                <!-- Provider row. Populated imperatively in codebehind:
                     one Button per VPS-capable provider with a non-empty
                     CuratedOffers list, each with AutomationId
                     vps-provider-row[<provider_id>] to match the indexed
                     pattern. AutomationProperties.Name=" " forces the
                     panel into the UIA "content" view — same trick as
                     dns-provider-row in DnsConfigView, which also explains
                     the controls:WrapStack — a horizontal StackPanel
                     overflows this MaxWidth="700" page once the provider
                     list outgrows one line, and an overflowed child reads
                     IsOffscreen=true to UIA. -->
                <controls:WrapStack x:Name="VpsProviderRow"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsProviderRow}"
                                    AutomationProperties.Name=" "
                                    HorizontalSpacing="8"
                                    VerticalSpacing="8" />

                <!-- Per-provider section: link, open-in-browser, help text,
                     credentials form, verify, location picker, server-type
                     radios. Visibility bound to a bool VM property because
                     FaunaApp.Core can't reference Microsoft.UI.Xaml.Visibility. -->
                <StackPanel x:Name="ProviderSection"
                            Visibility="{x:Bind local:VpsConfigView.BoolToVisibility(ViewModel.VpsProviderSectionVisible), Mode=OneWay}"
                            Spacing="8">
                    <HyperlinkButton x:Name="ProviderLink"
                                     AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsProviderLink}"
                                     Click="OnProviderLinkClick" />
                    <Button x:Name="ProviderOpenBrowserBtn"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsProviderOpenBrowserButton}"
                            Content="{loc:Localize Key=onboarding/dns_config/open_in_browser}"
                            Click="OnProviderLinkClick"
                            HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="ProviderHelpText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsProviderHelpText}"
                               TextWrapping="Wrap"
                               Opacity="0.7" />

                    <!-- Reusable credentials form. Wrapper carries the
                         vps-credentials-form id; child input ids come from
                         FieldMetaPlain.id. AutomationProperties.Name=" "
                         forces the UserControl peer into the content view
                         (same trick used on vps-provider-row above). The
                         Fields list is built in codebehind from the
                         selected provider's Vps-kind fields, mirroring
                         apps/fauna-linux/src/views/onboarding/vps_config.rs. -->
                    <controls:GenericProviderForm
                        x:Name="CredsForm"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsCredentialsForm}"
                        AutomationProperties.Name=" "
                        SetField="{x:Bind ViewModel.SetVpsCred}"
                        GetField="{x:Bind ViewModel.GetVpsCred}"
                        HostedAuthLabel="{x:Bind ViewModel.HostedAuthLabelVps}"
                        HostedAuthEnabled="{x:Bind ViewModel.HostedAuthEnabledVps}"
                        HostedAuthRun="{x:Bind ViewModel.HostedAuthRunVps}" />

                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsVerifyButton}"
                            Content="{loc:Localize Key=provisioning/verify_credentials}"
                            IsEnabled="{x:Bind ViewModel.CanVerifyVps, Mode=OneWay}"
                            Command="{Binding VerifyVpsCommand}"
                            HorizontalAlignment="Stretch" />

                    <!-- Location picker — populated by verify_vps via
                         ViewModel.VpsLocations. SelectedValuePath="id" so
                         SelectedValue round-trips the location id directly
                         to the machine, matching the Linux ComboBoxText
                         active_id pattern.

                         ⚠ The paths are the BARE field names, never the
                         `@id`/`@name` spelling the generated C# record
                         declares. `@` is a C#-source escape for an identifier
                         that could collide with a keyword — the runtime
                         property is plainly `id`/`name`, and a XAML property
                         path is matched by reflection, where `@` is just a
                         character that resolves to nothing. Spelled `@name`
                         here until 2026-09-06, this picker rendered one
                         BLANK row for the one location the provider returned,
                         and `SelectedValue` never round-tripped: the e2e
                         `select` reported `visible items: ` — an empty item
                         list is what ONE nameless item looks like through a
                         comma-join, which is why it read as "no locations
                         loaded". Nothing had ever reached vps_config on
                         windows to see it. Its sibling
                         `bridge-form-bridge-select` (FeedPage.xaml) already
                         spelled it bare. -->
                    <ComboBox x:Name="LocationPicker"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsLocationPicker}"
                              ItemsSource="{x:Bind ViewModel.VpsLocations, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.SelectedVpsLocationId, Mode=TwoWay}"
                              SelectedValuePath="id"
                              DisplayMemberPath="name"
                              Visibility="{x:Bind local:VpsConfigView.BoolToVisibility(ViewModel.VpsLocationPickerVisible), Mode=OneWay}"
                              HorizontalAlignment="Stretch" />

                    <!-- Mail-vs-social mode toggle. Decided here (before the
                         box boots) so cloud-init knows whether to provision the
                         scanner sidecars + mail ports; it RAM-gates the
                         server-type radio just below (mail ON => only >=2 GB
                         plans, via the shared server_type_allowed_for_mail in
                         ViewModel.VpsServerTypes). Default reads
                         ProvisionMailModeEnabled (handle real-domain default);
                         the codebehind re-syncs IsChecked from the snapshot
                         each tick, guarded against re-firing
                         SetProvisionMailMode. onboarding.md §5. -->
                    <StackPanel Spacing="4" Margin="0,8,0,0">
                        <CheckBox x:Name="MailModeCheck"
                                  AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsConfigMailModeToggle}"
                                  Content="{loc:Localize Key=onboarding/vps_config/mail_mode_label}"
                                  Checked="MailModeCheck_Toggled"
                                  Unchecked="MailModeCheck_Toggled" />
                        <TextBlock Text="{loc:Localize Key=onboarding/vps_config/mail_mode_desc}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7"
                                   Margin="28,0,0,0" />
                    </StackPanel>

                    <!-- Server-type radio group. ItemsControl + RadioButton
                         with shared GroupName gives us a flat list whose
                         children carry vps-server-type-radio[i] ids
                         (indexed by position, capped at 5 by the VM).
                         The wrapper carries the container id so the test
                         driver can count() against the parent and resolve
                         child indices via scope. -->
                    <ItemsControl x:Name="ServerTypeRadios"
                                  AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsServerTypeRadio}"
                                  AutomationProperties.Name=" "
                                  ItemsSource="{x:Bind ViewModel.VpsServerTypes, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServerTypeItemViewModel">
                                <RadioButton AutomationProperties.AutomationId="{x:Bind RadioItemId}"
                                             Content="{x:Bind Display}"
                                             GroupName="VpsServerType"
                                             Checked="OnVpsServerTypeChecked" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsConfigBackButton}"
                            Content="{loc:Localize Key=common/back}"
                            Command="{Binding BackCommand}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsConfigContinueButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{loc:Localize Key=common/continue}"
                            IsEnabled="{x:Bind ViewModel.CanContinueVps, Mode=OneWay}"
                            Command="{Binding VpsConfigContinueCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.VpsContinueBlockedReasonText, Mode=OneWay}"
                           Visibility="{x:Bind local:VpsConfigView.TextToVisibility(ViewModel.VpsContinueBlockedReasonText), Mode=OneWay}"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
