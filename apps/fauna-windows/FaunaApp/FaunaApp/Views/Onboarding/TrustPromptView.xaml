<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.TrustPromptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FaunaApp.Views.Onboarding"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12">
                <!-- Untagged on purpose (ui.yaml `onboarding.trust_prompt`'s approved
                     element set has no page-heading — trust-box-summary is the
                     readable text a driver asserts on). Mirrors tui/linux. -->
                <TextBlock Style="{StaticResource TitleTextBlockStyle}"
                           Text="{loc:Localize Key=onboarding/trust_prompt/title}" />

                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.TrustBoxSummary}"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Text="{loc:Localize Key=onboarding/trust_prompt/summary}" />

                <!-- No Back button: like nat_mode_choice before it, the admin is
                     already server-committed by the time this shows, and grant/skip
                     are its only two exits, both concluding the wizard with the same
                     LoggedIn outcome (ui.yaml transitions). -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.TrustBoxGrantButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{loc:Localize Key=onboarding/trust_prompt/grant_button}"
                            Command="{Binding GrantDefaultTrustCommand}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.TrustBoxSkipButton}"
                            Content="{loc:Localize Key=onboarding/trust_prompt/skip_button}"
                            Command="{Binding SkipTrustPromptCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
