<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.IdentityCreatedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <StackPanel Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{loc:Localize Key=onboarding/identity_created/title}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Localize Key=onboarding/identity_created/desc}"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           TextAlignment="Center" />

                <Border BorderBrush="Orange" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,16,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Localize Key=onboarding/identity_created/secret_key_label}" FontWeight="Bold" Foreground="Orange" />
                        <TextBlock
                            x:Name="SecretKeyText"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.SecretKeyDisplay}"
                            FontFamily="Consolas"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"
                            Text="{Binding GeneratedSecret, Mode=OneWay}" />
                        <TextBlock Text="{loc:Localize Key=onboarding/identity_created/warning}" TextWrapping="Wrap" Opacity="0.7" />
                        <Button x:Name="SecretKeyCopyBtn"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.SecretKeyCopyBtn}"
                                Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                Padding="8,4" HorizontalAlignment="Left"
                                Click="SecretKeyCopyBtn_Click"
                                ToolTipService.ToolTip="{loc:Localize Key=common/copy}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch" Margin="0,16,0,0">
                    <Button
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.IdentityCreatedBackButton}"
                        Content="{loc:Localize Key=common/back}"
                        Command="{Binding BackCommand}" />
                    <Button
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.IdentityContinueButton}"
                        Content="{loc:Localize Key=onboarding/identity_created/continue}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding ConfirmGeneratedIdentityCommand}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
