<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.ClaimCodeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FaunaApp.Views.Onboarding"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Text="{loc:Localize Key=onboarding/claim_code/title}" />

                <TextBlock TextWrapping="Wrap"
                           Opacity="0.7"
                           Text="{loc:Localize Key=onboarding/claim_code/description}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox AutomationProperties.AutomationId="{x:Bind ids:Ids.ClaimCodeInput}"
                             Text="{Binding ClaimCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="380"
                             PlaceholderText="{loc:Localize Key=onboarding/claim_code/placeholder}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.ClaimCodeSubmitButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.ClaimCodeSubmitEnabled, Mode=OneWay}"
                            Command="{Binding SubmitClaimCodeCommand}"
                            Content="{loc:Localize Key=onboarding/claim_code/submit_button}" />
                </StackPanel>

                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ClaimCodeStatus}"
                           Text="{x:Bind ViewModel.ClaimCodeStatusText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Opacity="0.85" />

                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.ClaimCodeBackButton}"
                        Command="{Binding ClaimCodeBackCommand}"
                        Margin="0,16,0,0"
                        Content="{loc:Localize Key=common/back}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
