<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.NestProvisioningView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FaunaApp.Views.Onboarding"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page-level error InfoBar. Shown when ProvisioningPageErrorMessage
                 is non-empty (snapshot.final_error preferred over machine.ErrorMessage).
                 Mirrors Linux nest_provisioning.rs:336-349. -->
            <controls:CopyableInfoBar
                Grid.Row="0"
                Severity="Error"
                IsOpen="{x:Bind ViewModel.ProvisioningHasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ProvisioningPageErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Text="{loc:Localize Key=onboarding/nest_provisioning/title}"
                           HorizontalAlignment="Center" />

                <!-- Top-region price summary ("Bill of Materials").
                     Pre-commit recap of up to two priced line items from
                     bill_of_materials(): the domain's one-time registration
                     price (only on the buy-a-new-domain path) and the
                     selected VPS's monthly price. Both the line templates and
                     the first-year/renewal split are chosen in shared Rust
                     (bom_domain_line/bom_vps_line), so this region is pure
                     render — the same shape linux/tui/web/apple/android use
                     (onboarding.md §6).

                     AutomationProperties.Name=" " hoists the bare StackPanel
                     into the UIA content view, same trick as
                     provisioning-progress below. -->
                <StackPanel AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningPriceBom}"
                            AutomationProperties.Name=" "
                            Spacing="2">
                    <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningBomDomainLine}"
                               Text="{x:Bind ViewModel.ProvisioningBomDomainLineText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind local:NestProvisioningView.BoolToVisibility(ViewModel.ProvisioningBomDomainLineVisible), Mode=OneWay}" />
                    <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningBomVpsLine}"
                               Text="{x:Bind ViewModel.ProvisioningBomVpsLineText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind local:NestProvisioningView.BoolToVisibility(ViewModel.ProvisioningBomVpsLineVisible), Mode=OneWay}" />
                </StackPanel>

                <!-- Top-region "Buy and set up" CTA. Visible only at Idle
                     per target doc §6 click-handler table. -->
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningStartButton}"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{loc:Localize Key=onboarding/nest_provisioning/start_button}"
                        Command="{x:Bind ViewModel.ProvisioningStartCommand}"
                        Visibility="{x:Bind local:NestProvisioningView.BoolToVisibility(ViewModel.ProvisioningStartButtonVisible), Mode=OneWay}"
                        HorizontalAlignment="Stretch" />

                <!-- Four-step progress region. The wrapper carries
                     provisioning-progress; each row's StackPanel root carries
                     the bare provisioning-step-row id (tree-position scoping
                     via tests/e2e-unified/drivers/scope.py). The
                     AutomationProperties.Name=" " trick hoists the ItemsControl
                     into the UIA content view (same as vps-server-type-radio). -->
                <ItemsControl x:Name="ProvisioningProgress"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningProgress}"
                              AutomationProperties.Name=" "
                              ItemsSource="{x:Bind ViewModel.ProvisioningSteps, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProvisioningStepItemViewModel">
                            <StackPanel AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningStepRow}"
                                        AutomationProperties.Name=" "
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,2">
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningStepCheckbox}"
                                           Text="{x:Bind Glyph}"
                                           Width="20" />
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningStepLabel}"
                                           Text="{x:Bind Label}" />
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningSubstep}"
                                           Text="{x:Bind Substep}"
                                           Opacity="0.7"
                                           Visibility="{x:Bind local:NestProvisioningView.BoolToVisibility(SubstepVisible)}" />
                                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningStepError}"
                                           Text="{x:Bind Error}"
                                           Foreground="{ThemeResource SystemErrorTextColor}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind local:NestProvisioningView.BoolToVisibility(ErrorVisible)}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Elapsed time. Visible once started_at_ms is set; the
                     1Hz timer fires PropertyChanged(ProvisioningElapsedText)
                     while overall == Running. -->
                <TextBlock x:Name="ElapsedText"
                           AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningElapsed}"
                           Text="{x:Bind ViewModel.ProvisioningElapsedText, Mode=OneWay}"
                           Opacity="0.7"
                           Visibility="{x:Bind local:NestProvisioningView.BoolToVisibility(ViewModel.ProvisioningElapsedVisible), Mode=OneWay}" />

                <!-- Bottom row: Back, Cancel (Running), Retry (Failed),
                     Continue (enabled when Succeeded). All four are always
                     present in the tree so the test driver can probe
                     visibility/enabled state. -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningBackButton}"
                            Content="{loc:Localize Key=common/back}"
                            Command="{x:Bind ViewModel.BackCommand}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningCancelButton}"
                            Content="{loc:Localize Key=onboarding/nest_provisioning/cancel_button}"
                            Command="{x:Bind ViewModel.ProvisioningCancelCommand}"
                            Visibility="{x:Bind local:NestProvisioningView.BoolToVisibility(ViewModel.ProvisioningCancelVisible), Mode=OneWay}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningRetryButton}"
                            Content="{loc:Localize Key=onboarding/nest_provisioning/retry_button}"
                            Command="{x:Bind ViewModel.ProvisioningRetryCommand}"
                            Visibility="{x:Bind local:NestProvisioningView.BoolToVisibility(ViewModel.ProvisioningRetryVisible), Mode=OneWay}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.ProvisioningContinueButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{loc:Localize Key=common/continue}"
                            IsEnabled="{x:Bind ViewModel.ProvisioningContinueEnabled, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ProvisioningContinueCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.ProvisioningContinueBlockedReasonText, Mode=OneWay}"
                           Visibility="{x:Bind local:NestProvisioningView.TextToVisibility(ViewModel.ProvisioningContinueBlockedReasonText), Mode=OneWay}"
                           FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
