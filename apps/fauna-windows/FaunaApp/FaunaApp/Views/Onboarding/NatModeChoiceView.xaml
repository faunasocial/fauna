<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.NatModeChoiceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FaunaApp.Views.Onboarding"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Text="{loc:Localize Key=onboarding/nat_mode/title}" />

                <TextBlock TextWrapping="Wrap"
                           Opacity="0.7"
                           Text="{loc:Localize Key=onboarding/nat_mode/description}" />

                <!-- Two-option NAT-mode radio group. No GroupName-shared
                     ItemsControl (unlike VpsConfigView's dynamic server-type
                     list) since there are always exactly two, fixed
                     options — plain static RadioButtons instead. Selection
                     is synced from the snapshot in code-behind (see
                     SyncRadios), guarded against re-firing SelectNatMode
                     while the sync itself sets IsChecked. -->
                <RadioButton x:Name="PublicRadio"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.PublicNatModeRadio}"
                             GroupName="NatMode"
                             IsEnabled="{x:Bind ViewModel.NatModeRadiosEnabled, Mode=OneWay}"
                             Checked="PublicRadio_Checked"
                             Margin="0,8,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Localize Key=onboarding/nat_mode/public_label}" />
                        <TextBlock Text="{loc:Localize Key=onboarding/nat_mode/public_desc}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7"
                                   FontSize="12" />
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="PrivateRadio"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.PrivateNatModeRadio}"
                             GroupName="NatMode"
                             IsEnabled="{x:Bind ViewModel.NatModeRadiosEnabled, Mode=OneWay}"
                             Checked="PrivateRadio_Checked">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Localize Key=onboarding/nat_mode/private_label}" />
                        <TextBlock Text="{loc:Localize Key=onboarding/nat_mode/private_desc}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7"
                                   FontSize="12" />
                    </StackPanel>
                </RadioButton>

                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.NatModeStatus}"
                           Text="{x:Bind ViewModel.NatModeStatusText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Opacity="0.85"
                           Margin="0,8,0,0" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.NatModeDeferButton}"
                            Content="{loc:Localize Key=onboarding/nat_mode/defer_button}"
                            Command="{Binding DeferNatModeChoiceCommand}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.NatModeConfirmButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.NatModeConfirmEnabled, Mode=OneWay}"
                            Content="{loc:Localize Key=onboarding/nat_mode/confirm_button}"
                            Command="{Binding SubmitNatModeChoiceCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
