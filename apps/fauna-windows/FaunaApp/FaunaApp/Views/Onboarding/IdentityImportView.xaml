<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.IdentityImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Error display -->
            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{loc:Localize Key=onboarding/identity_import/title}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Localize Key=onboarding/identity_import/paste_subtitle}"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           TextAlignment="Center" />

                <!-- No MaxLength: the field takes the shared import grammar, not just a
                     bare 64-hex secret — `fauna://identity?secret=<64 hex>&handle=<h>`
                     is ~110 chars, and a cap here truncated it to a string the parser
                     rejects ("Secret key must be 64 hex characters"). The parser
                     (ConfirmImportedIdentity → ParseIdentityImport) owns validation. -->
                <PasswordBox
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PasteSecretField}"
                    Header="{loc:Localize Key=onboarding/identity_import/paste_label}"
                    PlaceholderText="{loc:Localize Key=onboarding/identity_import/paste_placeholder}"
                    Password="{Binding ImportedSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                    <Button
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.IdentityImportBackButton}"
                        Content="{loc:Localize Key=common/back}"
                        Command="{Binding BackCommand}" />
                    <Button
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.ImportSubmitButton}"
                        Content="{loc:Localize Key=onboarding/identity_import/import}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding ConfirmImportedIdentityCommand}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
