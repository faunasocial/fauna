<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.DnsPostInstructionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Error display -->
            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{loc:Localize Key=onboarding/dns_post_instructions/title}"
                           AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{loc:Localize Key=onboarding/dns_post_instructions/description}"
                           TextWrapping="Wrap"
                           Opacity="0.7" />

                <!-- Read-only text block of DNS records. The TextBox (rather
                     than TextBlock) is intentional: the FlaUI bridge probes
                     visibility via UIA's value pattern, and TextBox exposes
                     it cleanly. Monospace + multiline mirrors the Linux/web
                     rendering of the same machine.dns_post_instructions()
                     markdown. -->
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="DnsPostInstructionsText"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.DnsPostInstructionsText}"
                             Text="{x:Bind ViewModel.DnsPostInstructions, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" />
                </ScrollViewer>

                <!-- Copy-to-clipboard handler is in codebehind because the
                     Windows.ApplicationModel.DataTransfer APIs aren't
                     reachable from FaunaApp.Core (net10.0). -->
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.DnsPostInstructionsCopyButton}"
                        Content="{loc:Localize Key=onboarding/dns_post_instructions/copy_button}"
                        Click="OnCopyClick"
                        HorizontalAlignment="Stretch" />

                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.DnsPostInstructionsContinueButton}"
                        Content="{loc:Localize Key=common/continue}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding DnsPostInstructionsContinueCommand}"
                        HorizontalAlignment="Stretch"
                        Margin="0,16,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
