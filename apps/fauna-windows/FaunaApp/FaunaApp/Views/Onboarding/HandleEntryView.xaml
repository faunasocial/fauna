<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.HandleEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FaunaApp.Views.Onboarding"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Error display: shared cross-app element. -->
            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Text="{loc:Localize Key=onboarding/handle/prompt}"
                           HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap"
                           Text="{loc:Localize Key=onboarding/handle/examples_help}"
                           Opacity="0.7"
                           TextAlignment="Center" />
                <TextBlock TextWrapping="Wrap"
                           Text="{loc:Localize Key=onboarding/handle/localhost_hint}"
                           Opacity="0.7"
                           TextAlignment="Center" />

                <!-- Handle input + Check button row.
                     The machine drives the phased probe (DNS → nest health
                     → challenge); see HandleCheckSnapshot. Re-pressing
                     Check while a probe is in flight cancels and restarts
                     (the Rust CancelFlag handles it). -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Name="HandleInputBox"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.HandleInput}"
                        Text="{Binding CurrentHandle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="alice@example.com"
                        HorizontalAlignment="Stretch"
                        Width="380" />
                    <Button
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.HandleCheckButton}"
                        Content="{loc:Localize Key=common/check}"
                        IsEnabled="{x:Bind ViewModel.HandleCheckEnabled, Mode=OneWay}"
                        Command="{Binding HandleCheckCommand}" />
                </StackPanel>

                <!-- Auto-sizing message panel — renders the current
                     LocalizedText from the snapshot (resolved on the C#
                     side via key+args lookup). Idle phase ⇒ empty string,
                     so the TextBlock collapses to nothing visually. -->
                <TextBlock
                    x:Name="HandleMessageArea"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.HandleMessageArea}"
                    Text="{x:Bind ViewModel.HandleCheckMessage, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Opacity="0.85"
                    Margin="0,8,0,0" />

                <!-- "I control DNS for this domain" — visible only when
                     the snapshot's outcome is RegisteredNoNest. Hidden
                     otherwise. -->
                <CheckBox
                    x:Name="HandleControlCheckbox"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.HandleControlCheckbox}"
                    Content="{loc:Localize Key=onboarding/handle/control_checkbox}"
                    IsChecked="{Binding HandleControlCheckboxChecked, Mode=TwoWay}"
                    Visibility="{x:Bind local:HandleEntryView.BoolToVisibility(ViewModel.HandleControlCheckboxVisible), Mode=OneWay}" />

                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch" Margin="0,16,0,0">
                    <Button
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.HandleEntryBackButton}"
                        Content="{loc:Localize Key=common/back}"
                        Command="{Binding BackCommand}" />
                    <Button
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.HandleEntryContinueButton}"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{loc:Localize Key=common/continue}"
                        IsEnabled="{x:Bind ViewModel.HandleCheckContinueEnabled, Mode=OneWay}"
                        Command="{Binding HandleEntryContinueCommand}"
                        HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
