<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.NestRecoveryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FaunaApp.Views.Onboarding"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Text="{loc:Localize Key=onboarding/recovery/title}" />

                <TextBlock TextWrapping="Wrap"
                           Opacity="0.7"
                           Text="{loc:Localize Key=onboarding/recovery/subtitle}" />

                <!-- Fresh-device / not-yet-synced case (the production default until
                     the C2 reachable-nest box-list fetch lands). -->
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoverBoxEmptyMessage}"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           Visibility="{x:Bind BoolToVisibilityInverse(ViewModel.HasRecoveryBoxes), Mode=OneWay}"
                           Text="{loc:Localize Key=onboarding/recovery/empty_message}" />

                <TextBlock Opacity="0.7"
                           Visibility="{x:Bind BoolToVisibility(ViewModel.HasRecoveryBoxes), Mode=OneWay}"
                           Text="{loc:Localize Key=onboarding/recovery/box_list_label}" />

                <!-- One selectable row per custodied box. ItemsControl (non-
                     virtualizing) realizes every row so FlaUI can count them;
                     the container carries recover-box-list and a blank Name to
                     force it into the UIA content view (mirrors the vps radio
                     list). Each row's dash-indexed recover-box-item-{i} id
                     matches the e2e + web/linux. -->
                <ItemsControl x:Name="BoxList"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoverBoxList}"
                              AutomationProperties.Name=" "
                              Visibility="{x:Bind BoolToVisibility(ViewModel.HasRecoveryBoxes), Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.RecoveryBoxItems, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecoveryBoxItemViewModel">
                            <Button AutomationProperties.AutomationId="{x:Bind BoxItemId}"
                                    Content="{x:Bind ShortId}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Margin="0,2"
                                    Click="OnRecoveryBoxItemClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoverMethodCloudButton}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch"
                        Margin="0,16,0,0"
                        IsEnabled="{x:Bind ViewModel.RecoveryMethodButtonsEnabled, Mode=OneWay}"
                        Command="{Binding RecoverViaCloudCommand}"
                        Content="{loc:Localize Key=onboarding/recovery/method_cloud}" />

                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoverMethodSelfhostedButton}"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{x:Bind ViewModel.RecoveryMethodButtonsEnabled, Mode=OneWay}"
                        Command="{Binding RecoverViaSelfhostedCommand}"
                        Content="{loc:Localize Key=onboarding/recovery/method_selfhosted}" />

                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoverBackButton}"
                        Command="{Binding BackCommand}"
                        Margin="0,16,0,0"
                        Content="{loc:Localize Key=common/back}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
