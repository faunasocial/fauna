<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.EmergencyLockoutEntryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Every refusal the door gives (the machine's one
                 EmergencyLockoutOutcomeMessage table) renders here. -->
            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{loc:Localize Key=onboarding/emergency_lockout/title}"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{loc:Localize Key=onboarding/emergency_lockout/desc}"
                           TextWrapping="Wrap"
                           Opacity="0.7" />

                <!-- identity_import's paste field — a PasswordBox, the secret key
                     itself. Read for one call and never stored. -->
                <PasswordBox
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PasteSecretField}"
                    Header="{loc:Localize Key=onboarding/emergency_lockout/secret_label}"
                    Password="{Binding LockoutSecret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{loc:Localize Key=onboarding/emergency_lockout/account_hint}"
                           TextWrapping="Wrap"
                           Opacity="0.7" />
                <TextBox
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoveryEntryAccountField}"
                    Header="{loc:Localize Key=common/handle}"
                    Text="{Binding LockoutAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- REQUIRED copy, always visible — never behind the confirm
                     (ui/sessions.md § Layout & flow, region 3). -->
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.SessionsLockoutWarning}"
                           Text="{loc:Localize Key=sessions/lockout_warning}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <TextBox
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SessionsLockoutConfirmField}"
                    PlaceholderText="{loc:Localize Key=sessions/lockout_confirm_placeholder}"
                    Text="{Binding LockoutWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.EmergencyLockoutBackButton}"
                            Content="{loc:Localize Key=common/back}"
                            Command="{Binding BackCommand}" />
                    <!-- A Click, not a Command: a Command's CanExecute would own
                         IsEnabled and drop the word gate bound here. -->
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.SessionsLockoutButton}"
                            Content="{loc:Localize Key=sessions/lockout_button}"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding LockoutArmed, Mode=OneWay}"
                            Click="OnLockClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
