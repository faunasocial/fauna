<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.InviteRequestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FaunaApp.Views.Onboarding"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           Text="{loc:Localize Key=onboarding/invite_request/title}"
                           HorizontalAlignment="Center" />

                <!-- Top row: admin-flow Submit + status + (conditional) Recheck. -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.InviteRequestSubmitButton}"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="{loc:Localize Key=onboarding/invite/request_button}"
                                Command="{Binding SubmitInviteRequestCommand}" />
                        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.InviteRequestRecheckButton}"
                                Content="{loc:Localize Key=onboarding/invite/recheck_button}"
                                Visibility="{x:Bind local:InviteRequestView.BoolToVisibility(ViewModel.InviteRequestRecheckVisible), Mode=OneWay}"
                                Command="{Binding RecheckInviteStatusCommand}" />
                    </StackPanel>
                    <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.InviteRequestStatus}"
                               Text="{x:Bind ViewModel.InviteRequestStatusText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Opacity="0.85" />
                </StackPanel>

                <Border Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="0,8" />

                <!-- Bottom row: out-of-band invite code (independent sub-flow). -->
                <StackPanel Spacing="6">
                    <TextBlock TextWrapping="Wrap"
                               Text="{loc:Localize Key=onboarding/oob_code/idle}"
                               Opacity="0.7" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="InviteCodeInput"
                                 AutomationProperties.AutomationId="{x:Bind ids:Ids.InviteCodeInput}"
                                 Text="{Binding InviteCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="380" />
                        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.InviteCodeCheckButton}"
                                Content="{loc:Localize Key=common/check}"
                                Command="{Binding VerifyOobInviteCodeCommand}" />
                    </StackPanel>
                    <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.InviteCodeStatus}"
                               Text="{x:Bind ViewModel.InviteCodeStatusText, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Opacity="0.85" />
                    <!-- family-safety.md § App surface — the verify-reply's
                         supervised_by, rendered before redemption. -->
                    <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.InviteCodeSupervisedNotice}"
                               Text="{x:Bind ViewModel.InviteCodeSupervisedNoticeText, Mode=OneWay}"
                               Visibility="{x:Bind local:InviteRequestView.BoolToVisibility(ViewModel.ShowInviteCodeSupervisedNotice), Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.InviteRequestBackButton}"
                            Content="{loc:Localize Key=common/back}"
                            Command="{Binding InviteRequestBackCommand}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.InviteRequestContinueButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{loc:Localize Key=common/continue}"
                            IsEnabled="{x:Bind ViewModel.InviteRequestContinueEnabled, Mode=OneWay}"
                            Command="{Binding InviteRequestContinueCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
