<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.RecoverSelfhostedInstructionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FaunaApp.Views.Onboarding"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Text="{loc:Localize Key=onboarding/recovery/selfhosted_title}" />

                <TextBlock TextWrapping="Wrap"
                           Opacity="0.7"
                           Text="{loc:Localize Key=onboarding/recovery/selfhosted_desc}" />

                <!-- The installer invocation carrying FAUNA_DEPLOYMENT_SEED. A
                     placeholder until the C2 reachable-nest command render lands
                     (box-recovery.md § Implementation status of step 4); mirrors
                     linux's SELFHOSTED_COMMAND_PENDING. -->
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoverSelfhostedCommand}"
                           Text="{x:Bind ViewModel.RecoverSelfhostedCommand, Mode=OneWay}"
                           FontFamily="Consolas"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"
                           Opacity="0.85" />

                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoverSelfhostedCopyButton}"
                        Click="OnCopyClick"
                        Content="{loc:Localize Key=common/copy}" />

                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoverRestoreCta}"
                        Command="{Binding RecoverResetCommand}"
                        Margin="0,16,0,0"
                        Content="{loc:Localize Key=onboarding/recovery/restore_cta}" />

                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoverSelfhostedContinueButton}"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding RecoverResetCommand}"
                        Content="{loc:Localize Key=onboarding/recovery/selfhosted_continue}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
