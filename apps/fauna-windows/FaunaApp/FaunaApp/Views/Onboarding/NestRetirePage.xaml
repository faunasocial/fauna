<?xml version="1.0" encoding="utf-8"?>
<!-- nest_retire — retire an app-provisioned nest
     (docs/goal/behavior/nest-retirement.md; ui.yaml onboarding.nest_retire).
     A paint shell over the shared NestRetireMachine: credentials → list →
     confirm → running → done, every state the machine's. Each state is one
     panel below, shown or collapsed by the code-behind from the snapshot (a
     collapsed element leaves the UIA tree, so a state's ids are absent outside
     it). The credential state reuses vps_config's controls by id; the running
     and done states reuse provisioning-step-row. -->
<Page
    x:Class="FaunaApp.Views.Onboarding.NestRetirePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="700">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12">
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Text="{loc:Localize Key=onboarding/retire/title}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.7"
                           Text="{loc:Localize Key=onboarding/retire/subtitle}" />

                <!-- credentials: the vps_config provider row, credential form and
                     verify button, by the same ids — no location or server-type
                     controls. Every VPS-capable provider is offered: a box bought
                     through a provider no longer on the curated offer list must
                     still be retirable. Name=" " puts each container in the UIA
                     content view (the vps_config idiom). -->
                <StackPanel x:Name="CredentialsPanel" Spacing="8">
                    <controls:WrapStack x:Name="VpsProviderRow"
                                        AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsProviderRow}"
                                        AutomationProperties.Name=" "
                                        HorizontalSpacing="8"
                                        VerticalSpacing="8" />
                    <StackPanel x:Name="ProviderSection" Visibility="Collapsed" Spacing="8">
                        <HyperlinkButton x:Name="ProviderLink"
                                         AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsProviderLink}"
                                         Click="OnProviderLinkClick" />
                        <Button x:Name="ProviderOpenBrowserBtn"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsProviderOpenBrowserButton}"
                                Content="{loc:Localize Key=onboarding/dns_config/open_in_browser}"
                                Click="OnProviderLinkClick"
                                HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="ProviderHelpText"
                                   AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsProviderHelpText}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                        <controls:GenericProviderForm
                            x:Name="CredsForm"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsCredentialsForm}"
                            AutomationProperties.Name=" " />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="VerifyButton"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.VpsVerifyButton}"
                                    Content="{loc:Localize Key=provisioning/verify_credentials}"
                                    Click="OnVerifyClick" />
                            <ProgressRing x:Name="ListingRing" IsActive="False"
                                          Visibility="Collapsed" Width="20" Height="20" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- list: one row per server Fauna created in the account. Rows are
                     built in the code-behind with the scoped-descendant idiom: each
                     row is a Button carrying retire-server-item (named, so UIA keeps
                     it, and invokable, so a click selects it), its members INSIDE it,
                     so retire-server-item[n] addresses the row by its position. -->
                <StackPanel x:Name="ListPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock x:Name="EmptyMessage"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireServerEmptyMessage}"
                               TextWrapping="Wrap"
                               Text="{loc:Localize Key=onboarding/retire/empty_message}" />
                    <TextBlock x:Name="ListLabel" Opacity="0.7"
                               Text="{loc:Localize Key=onboarding/retire/list_label}" />
                    <StackPanel x:Name="ServerList"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireServerList}"
                                AutomationProperties.Name=" "
                                Spacing="8" />
                    <Button x:Name="DeleteButton"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireDeleteButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{loc:Localize Key=onboarding/retire/delete_button}"
                            Click="OnDeleteClick" />
                </StackPanel>

                <!-- confirm: the typed-name gate (§ Confirm shape). -->
                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock x:Name="ConfirmSummary"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireConfirmSummary}"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="ConfirmNameInput"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireConfirmNameInput}"
                             Header="{loc:Localize Key=onboarding/retire/confirm_name_label}"
                             TextChanged="OnConfirmNameChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConfirmButton"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireConfirmButton}"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="{loc:Localize Key=onboarding/retire/confirm_button}"
                                Click="OnConfirmClick" />
                        <Button x:Name="CancelButton"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireCancelButton}"
                                Content="{loc:Localize Key=onboarding/retire/cancel_button}"
                                Click="OnCancelClick" />
                    </StackPanel>
                </StackPanel>

                <!-- running / done: the done headline, then the two step rows
                     (DNS = 0, Server = 1) reusing provisioning-step-row's ids and
                     the glyphs the provisioning page paints for the shared status. -->
                <TextBlock x:Name="DoneHeadline" Visibility="Collapsed"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="StepsPanel" Visibility="Collapsed" Spacing="4" />

                <StackPanel x:Name="RunningPanel" Visibility="Collapsed" Spacing="8">
                    <Button x:Name="RetryButton"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireRetryButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{loc:Localize Key=onboarding/retire/retry_button}"
                            Click="OnRetryClick" />
                    <!-- The dangling-record warning, repeated where the choice is made. -->
                    <TextBlock x:Name="ForceServerWarning"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireForceServerWarning}"
                               Foreground="{ThemeResource SystemErrorTextColor}"
                               TextWrapping="Wrap"
                               Text="{loc:Localize Key=onboarding/retire/force_server_warning}" />
                    <Button x:Name="ForceServerButton"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireForceServerButton}"
                            Content="{loc:Localize Key=onboarding/retire/force_server_button}"
                            Click="OnForceServerClick" />
                </StackPanel>

                <StackPanel x:Name="DonePanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock x:Name="LeftoverText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireDnsLeftoverText}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Opacity="0.7"
                                   Text="{loc:Localize Key=onboarding/retire/leftover_copy}" />
                        <Button x:Name="LeftoverCopyButton"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireDnsLeftoverCopyButton}"
                                Content="{loc:Localize Key=common/copy}"
                                Click="OnLeftoverCopyClick" />
                    </StackPanel>
                    <Button x:Name="DoneButton"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireDoneButton}"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="{loc:Localize Key=onboarding/retire/done_button}"
                            Click="OnDoneClick" />
                </StackPanel>

                <Button x:Name="BackButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.RetireBackButton}"
                        Margin="0,8,0,0"
                        Content="{loc:Localize Key=common/back}"
                        Click="OnBackClick" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
