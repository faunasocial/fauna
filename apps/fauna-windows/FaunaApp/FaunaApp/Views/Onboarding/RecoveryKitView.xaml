<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FaunaApp.Views.Onboarding.RecoveryKitView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:loc="using:FaunaApp.Markup"
    mc:Ignorable="d"
    xmlns:ids="using:FaunaApp.UiIds">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="48" HorizontalAlignment="Center" MaxWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:CopyableInfoBar
                Grid.Row="0"
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="{Binding HasError, Mode=OneWay}"
                Message="{Binding ErrorMessage, Mode=OneWay}"
                IsClosable="True"
                Margin="0,0,0,16" />

            <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{loc:Localize Key=onboarding/recovery_kit/title}"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoveryKitDescription}"
                           Text="{loc:Localize Key=onboarding/recovery_kit/desc}"
                           TextWrapping="Wrap"
                           Opacity="0.7" />

                <!-- The bare 64-hex — what a user copies onto paper. The QR and the
                     copy button below both carry the machine's one fauna://recovery
                     URI instead (identity-succession.md § The RecoveryKey). Same ids
                     as the Settings kit panel: it is the same artifact. -->
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoveryKitSecretDisplay}"
                           FontFamily="Consolas"
                           IsTextSelectionEnabled="True"
                           TextWrapping="Wrap"
                           Text="{Binding RecoveryKitSecretText, Mode=OneWay}" />
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoveryKitSecretCopyBtn}"
                        Content="{loc:Localize Key=common/copy}"
                        Click="CopyButton_Click" />
                <!-- Dark-on-light explicitly (a theme-inverted QR does not scan), and
                     AutomationProperties.Name is required: a container whose only
                     children are dynamically-added Rectangles is otherwise pruned from
                     the UIA tree (identity-export-qr's own note). -->
                <Canvas x:Name="QrCanvas"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoveryKitQr}"
                        AutomationProperties.Name="Recovery kit QR code"
                        Width="220" Height="220" Background="White"
                        HorizontalAlignment="Left" />

                <!-- The ONE state this screen's escrow line renders: no nest exists at
                     this position, so the ceremony runs at the signed-in handoff —
                     never an EscrowOutcome, never "protected". -->
                <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoveryKitEscrowStatus}"
                           Text="{loc:Localize Key=onboarding/recovery_kit/escrow_deferred}"
                           TextWrapping="Wrap"
                           Opacity="0.7" />

                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoveryKitSkipButton}"
                            Content="{loc:Localize Key=onboarding/recovery_kit/skip}"
                            Command="{Binding SkipRecoveryKitCommand}" />
                    <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.RecoveryKitConfirmButton}"
                            Content="{loc:Localize Key=onboarding/recovery_kit/confirm}"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding ConfirmRecoveryKitCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
