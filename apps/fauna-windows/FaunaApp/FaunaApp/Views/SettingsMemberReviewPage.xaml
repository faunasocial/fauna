<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.SettingsMemberReviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!--
      Settings to Members To Review (succession-aftermath.md § Propagation,
      Removing a flagged member): the
      PERMANENT half of the post-succession unattested-member review. Holds
      whatever the ephemeral kit-side pass (SettingsAccountPage's Recovery Kit
      section) leaves unanswered — deferred, or never reached. No sweep gate on
      purpose: the only condition is whether anything is open, so this page is
      reachable at all times and empty most of the time; that is the design,
      not a gap. Reference: apps/fauna-tui/src/settings/member_review.rs.
    -->

    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">

            <controls:CopyableInfoBar
                x:Name="ErrorBar"
                Severity="Error" IsOpen="False" IsClosable="True" />

            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{loc:Localize Key=settings/member_review_page/title}" />

            <!-- The lead line the ephemeral pass never has to say: chrome,
                 not an id (ui.yaml scopes none for it); only while something
                 is open, same gate as the rows below. -->
            <TextBlock x:Name="Intro" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="{loc:Localize Key=settings/member_review_page/intro}" />

            <!-- Not a safety verdict: an empty list says nothing about whether
                 the account is safe (succession-aftermath.md § Implementation
                 status today). Hidden while loading too: "nobody asked this
                 nest to hold anything" must never stand in for "the read has
                 not answered yet". -->
            <TextBlock x:Name="EmptyState"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.MemberReviewEmpty}"
                       Opacity="0.6" TextWrapping="Wrap" Visibility="Collapsed"
                       Text="{loc:Localize Key=settings/member_review_page/empty}" />

            <!-- The rows: the SAME control the ephemeral pass on the Recovery
                 Kit section renders (one id family, two surfaces; the row is
                 built once — settings.md § Recovery kit). -->
            <controls:MemberReviewList x:Name="ReviewList" />
        </StackPanel>
    </ScrollViewer>
</Page>
