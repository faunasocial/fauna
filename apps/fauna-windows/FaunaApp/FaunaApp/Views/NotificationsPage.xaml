<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <TextBlock x:Name="NotificationsTitle" Style="{StaticResource SubtitleTextBlockStyle}"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}" />
            <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.NotificationMarkRead}"
                    x:Name="MarkReadButton" Click="MarkRead_Click" />
            <TextBlock x:Name="CountBadge"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.NotificationCountBadge}"
                       VerticalAlignment="Center" Foreground="{ThemeResource SystemAccentColor}"
                       FontWeight="Bold" />
        </StackPanel>

        <ListView Grid.Row="1" x:Name="NotificationsList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- ⚠ LITERAL ids in this template, not `{x:Bind ids:Ids.…}` — the
                         same rule `Controls/RecipientPicker.xaml` states at length:
                         `x:Bind` inside a DataTemplate resolves against that template's
                         `x:DataType`, and this one declares none. Here it did not fail
                         quietly, as it does there: these two were the ONLY `x:Bind`s in
                         the template, so they were the whole reason the XAML compiler
                         emitted a binding class for it at all — and with no `x:DataType`
                         to infer from, its `SetDataRoot` cast the real `NotificationItem`
                         to `DataTemplate` and threw `ArgumentException` the moment a push
                         mounted this page. A FATAL app crash, not a missing id.
                         Page-scope `x:Bind` above is fine — the Page IS its own data root. -->
                    <Grid Padding="8" ColumnSpacing="12"
                          AutomationProperties.AutomationId="notification-item"
                          AutomationProperties.Name="{Binding Text}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock AutomationProperties.AutomationId="notification-type-icon"
                                   Text="{Binding TypeIcon}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="2" Text="{Binding TimeAgo}" Opacity="0.5"
                                   FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="2" x:Name="LoadMoreButton"
                HorizontalAlignment="Center" Click="LoadMore_Click" Visibility="Collapsed" />

        <controls:CopyableInfoBar Grid.Row="3" x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
        <ProgressRing Grid.Row="1" x:Name="LoadProgress" IsActive="False" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
