<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.LaunchProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ids="using:FaunaApp.UiIds">
    <!-- launch_progress: the launch's sign-in check is in flight. Blank but for
         launch-identity-label, the bound account's cached identity; nothing at all
         while the cache holds no handle (android's LaunchProgressScreen). -->
    <Grid Padding="48" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
        <TextBlock x:Name="IdentityText"
                   AutomationProperties.AutomationId="{x:Bind ids:Ids.LaunchIdentityLabel}"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
</Page>
