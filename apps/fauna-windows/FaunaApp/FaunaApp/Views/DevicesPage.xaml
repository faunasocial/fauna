<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!-- Settings → Devices sub-page (devices.md; ui.yaml § devices): the device
         ROSTER only. Split out of the former top-level SyncPage by the 2026-06-28
         sync/folder UI unification (spec §§ 1, 6): the folder wizard / list /
         conflicts moved to Settings → Folders (FoldersPage), the roster stays
         here re-homed under the Settings shell. Reached via {"view":"settings",
         "id":"devices"}. A thin renderer over the shared-Rust DevicesMachine
         (libs/fauna-devices-machine) — renders only the roster slice
         (DevicesSnapshot.devices + .error). -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="24" MaxWidth="900" HorizontalAlignment="Left">

            <!-- Error bar — page error surfaces here AND via App.CurrentErrorMessage
                 (the global error-message TextBox MainPage drills through to while a
                 settings sub-page is shown; e2e reads it via the state protocol). -->
            <controls:CopyableInfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="True" />

            <TextBlock x:Name="PageHeading" AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{loc:Localize Key=devices/title}" />

            <!-- ══════════════════════════════════════════════════════
                 Peer Identity
                 ══════════════════════════════════════════════════════ -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="PeerInfoHeader" Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{loc:Localize Key=common/identity}" />
                <Grid ColumnSpacing="16" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" x:Name="ActorIdLabel" Opacity="0.6"
                               Text="{loc:Localize Key=common/actor_id}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PeerActorIdText" IsTextSelectionEnabled="True"
                               FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="0" Grid.Column="2"
                            AutomationProperties.AutomationId="{x:Bind ids:Ids.PeerActorIdCopyBtn}"
                            Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                            FontSize="10" Padding="4,2" Click="CopyPeerActorId_Click"
                            ToolTipService.ToolTip="{loc:Localize Key=common/copy}" />
                </Grid>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- ══════════════════════════════════════════════════════
                 Connected Devices (roster)
                 ══════════════════════════════════════════════════════ -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="DevicesHeader" Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{loc:Localize Key=devices/title}" />

                <ListView x:Name="DevicesList" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- Literal ids below — this DataTemplate has no x:DataType, so
                                 `{x:Bind ids:Ids.…}` silently drops (or crashes the page, if
                                 an AutomationId were the template's only x:Bind); see
                                 Controls/RecipientPicker.xaml. -->
                            <!-- AutomationProperties.Name is set to the device label so
                                 WinUI 3 surfaces this Grid in the UIA content view. Bare
                                 panels with only an AutomationId get pruned and FlaUI's
                                 ByAutomationId() can't find them — same trick as post-card
                                 in FeedPage.xaml. -->
                            <Grid Padding="8" ColumnSpacing="12" RowSpacing="4"
                                  AutomationProperties.AutomationId="device-card"
                                  AutomationProperties.Name="{Binding Name}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <TextBlock Grid.Column="1"
                                           AutomationProperties.AutomationId="device-name"
                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <!-- Everything after the name wraps on a second line (Controls/WrapStack.cs):
                                     one nine-column line clipped the name and the remove button to zero
                                     width in a narrow window once the participation toggle joined it
                                     (measured 2026-09-29 on a ~234 px page; test_device_remove_button_visible). -->
                                <controls:WrapStack Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                    HorizontalSpacing="12" VerticalSpacing="4">
                                <!-- The guardian-enrolled-device marker (family-safety.md § Full
                                     visibility for young children, Slice F / Slice-G client lift).
                                     The WARD'S OWN list renders it — the child must always see
                                     which device their guardian enrolled (transparency by
                                     construction); `guardian_marked` is always false on an
                                     unsupervised account, so the badge is simply absent there.
                                     Collapsed (not just hidden) on unmarked rows so FlaUI's
                                     count() sees exactly the marked ones. Mirrors linux
                                     (views/devices_folders/roster.rs) + web (DevicesSection.svelte). -->
                                <TextBlock
                                           AutomationProperties.AutomationId="device-guardian-mark-badge"
                                           Text="{loc:Localize Key=devices/guardian_marked_badge}"
                                           Visibility="{Binding GuardianBadgeVisibility}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                                <!-- Marks the row whose device_id matches this app's own
                                     locally-stored id — removes the hex-comparison a user used
                                     to do by eye (devices.md; ID user-approved 2026-08-11).
                                     Collapsed (not just hidden) on every other row so FlaUI's
                                     count() sees exactly the one marked row. -->
                                <TextBlock
                                           AutomationProperties.AutomationId="device-this-mark-badge"
                                           Text="{loc:Localize Key=devices/this_device_badge}"
                                           Visibility="{Binding ThisMarkVisibility}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Opacity="0.6" />
                                <!-- Piece 1 of the custody facet (devices.md § Custody facet):
                                     an own device enrolled relay-only wears the "holds no keys"
                                     marker. The DERIVED posture — the shared
                                     fauna_devices_machine::keyless_posture join behind
                                     devices_keyless_posture — never stored or asked, so a fact
                                     with no control. Collapsed on every other row so FlaUI's
                                     count() sees exactly the marked ones. Mirrors linux's
                                     roster.rs. -->
                                <TextBlock
                                           AutomationProperties.AutomationId="device-keyless-posture-badge"
                                           Text="{loc:Localize Key=devices/keyless_posture_badge}"
                                           Visibility="{Binding KeylessVisibility}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Opacity="0.6" />
                                <!-- One chip per folder this device carries, stating its place in
                                     that folder (its three place flags, composed —
                                     DeviceSummary.folders). Indexed: a device in three folders
                                     paints three chips; the ItemsControl is empty (renders
                                     nothing) when the device carries none, matching every other
                                     app leg's `if !device.folders.is_empty()` guard without
                                     needing one explicitly. The WrapStack items panel is a plain
                                     non-virtualizing Panel, so every chip realizes a UIA peer for the
                                     count/get_text-based e2e (mirrors FeedPage.xaml's
                                     protocol-badge). No AutomationProperties.Name on the chip
                                     itself (AutomationId-only) — a static Name here would make
                                     get_text() return the Name instead of the bound Text
                                     (reference_windows_flaui_gettext_dynamic_label_no_name).
                                     devices.md § Element table / § Where logic lives; mirrors
                                     linux's devices_folders/roster.rs one-badge-per-folder loop. -->
                                <ItemsControl
                                              ItemsSource="{Binding FolderRoleBadges}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <!-- Wraps too: one composed full-sync place label
                                                 alone runs ~450 px. -->
                                            <controls:WrapStack HorizontalSpacing="4" VerticalSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Literal for the same reason as device-card above. -->
                                            <TextBlock AutomationProperties.AutomationId="device-folder-role-badge"
                                                       Text="{Binding}" TextWrapping="Wrap"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       Opacity="0.6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                           AutomationProperties.AutomationId="device-status"
                                           Text="{Binding Status}"
                                           Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                <!-- Whether this device takes part in peer transfers
                                     (behavior/p2p.md § Per-device participation): the own
                                     row's switch is the device's own, both directions; any
                                     other row can only be asked off. The paint's two arms
                                     are Core.ViewModels.DeviceParticipationPaint (tui's,
                                     rule for rule). A CheckBox, as tui's checkbox: its
                                     TogglePattern is the `checked` mirror the driver reads,
                                     and its Content TextBlock is the label get_text reads
                                     (no static Name). Disabled when the gesture could not
                                     succeed (a sibling already off or asked off). -->
                                <CheckBox
                                          AutomationProperties.AutomationId="device-p2p-participation-toggle"
                                          Content="{Binding ParticipationLabel}"
                                          IsChecked="{Binding ParticipationChecked, Mode=OneWay}"
                                          IsEnabled="{Binding ParticipationActionable}"
                                          MinWidth="0" VerticalAlignment="Center"
                                          Tag="{Binding Index}" Click="ParticipationToggle_Click" />
                                </controls:WrapStack>
                                <Button Grid.Column="2"
                                        AutomationProperties.AutomationId="device-remove-button"
                                        Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                        FontSize="10" Padding="4,2"
                                        Tag="{Binding Index}" Click="RemoveDevice_Click"
                                        ToolTipService.ToolTip="{loc:Localize Key=devices/detail/remove_device}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="NoDevicesText" Opacity="0.5" Visibility="Collapsed"
                           Text="{loc:Localize Key=devices/no_devices}" />

                <ProgressRing x:Name="LoadProgress" IsActive="False" Visibility="Collapsed"
                              HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════
                 T16 custody facet (devices.md § Custody facet), in the
                 facet's order: who holds my data (piece 2), what I hold for
                 others and the offers waiting on me (piece 3), then the ask
                 (custody-mint-*). Below the roster — none of these are this
                 account's devices. Every section hides when empty (an empty
                 titled group reads as a feature that failed to load); every
                 control is live through Core.ViewModels.DevicesCustodyFacet.

                 Piece 2: cross-account custodian DEVICES, never intermixed
                 with device-card rows above (a custody whose accept bound the
                 host's NEST belongs to the Nests page's nest-trust-custody-*
                 family instead — filtered in code-behind on
                 custodianNestUrl). -->
            <StackPanel x:Name="CustodySection" Spacing="8" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{loc:Localize Key=devices/custody_holder_section}" />

                <ListView x:Name="CustodyList" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- Literal for the same reason as device-card above. -->
                            <Grid Padding="8" RowSpacing="2"
                                  AutomationProperties.AutomationId="custody-holder-card"
                                  AutomationProperties.Name="{Binding Name}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- The counterpart account, abbreviated through the SAME
                                     shared shortId every app uses. -->
                                <TextBlock Grid.Row="0"
                                           AutomationProperties.AutomationId="custody-holder-name"
                                           Text="{Binding Name}" FontWeight="SemiBold" />
                                <!-- Three states, three strings — never collapsed, never
                                     empty (the A7 honesty rule): a stale custodian must read
                                     as degraded redundancy the owner can see, not as an
                                     absent row. -->
                                <TextBlock Grid.Row="1"
                                           AutomationProperties.AutomationId="custody-holder-receipt-status"
                                           Text="{Binding ReceiptStatusText}"
                                           Foreground="{Binding ReceiptStatusBrush}"
                                           FontSize="12" />
                                <TextBlock Grid.Row="2"
                                           AutomationProperties.AutomationId="custody-holder-held-bytes"
                                           Text="{Binding HeldBytesText}"
                                           Opacity="0.6" FontSize="12" />
                                <!-- The honest bound, stated beside the control it bounds
                                     (REQUIRED — nests.md § Trust facet, custody rows):
                                     revoking stops future carriage and serving on honest
                                     boxes; copies already held stay held. A pending
                                     ceremony has minted nothing to revoke, so the note
                                     would over-promise there and is withheld (matches the
                                     control's own disabled state). -->
                                <TextBlock Grid.Row="3"
                                           Text="{loc:Localize Key=devices/custody_revoke_bound_note}"
                                           Visibility="{Binding RevokeBoundNoteVisibility}"
                                           Opacity="0.5" FontSize="11" TextWrapping="Wrap" />
                                <Button Grid.Row="4"
                                        AutomationProperties.AutomationId="custody-holder-revoke-button"
                                        Content="{loc:Localize Key=devices/custody_revoke}"
                                        IsEnabled="{Binding RevokeEnabled}"
                                        Tag="{Binding}" Click="RevokeCustody_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Piece 3, held for others: one custody-held-card per custody this
                 device holds for another account — the owner, the scope, the
                 metered bytes, the adjustable budget, stop and remove. An
                 ItemsControl (non-virtualizing, no selection chrome) so every
                 card and its controls realize a UIA peer. -->
            <StackPanel x:Name="HeldSection" Spacing="8" Visibility="Collapsed">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="{loc:Localize Key=devices/custody_held_section}" />
                <ItemsControl x:Name="HeldList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Literal ids for the same reason as device-card above. -->
                            <StackPanel Padding="8" Spacing="4"
                                        AutomationProperties.AutomationId="custody-held-card"
                                        AutomationProperties.Name="{Binding Owner}">
                                <TextBlock AutomationProperties.AutomationId="custody-held-owner"
                                           Text="{Binding Owner}" FontWeight="SemiBold" />
                                <TextBlock AutomationProperties.AutomationId="custody-held-scope"
                                           Text="{Binding Scope}" TextWrapping="Wrap"
                                           Opacity="0.6" FontSize="12" />
                                <TextBlock AutomationProperties.AutomationId="custody-held-bytes"
                                           Text="{Binding Bytes}" FontSize="12" />
                                <!-- The budget commits on Enter AND on blur — the
                                     FoldersPage member-cap shape: Enter never moves focus
                                     off a single-line TextBox, and the e2e driver's click
                                     on an editable commits by shifting focus. Seeded from
                                     the shared budget_draft; the refold re-seeds it. -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Localize Key=devices/custody_budget_label}"
                                               VerticalAlignment="Center" />
                                    <TextBox AutomationProperties.AutomationId="custody-held-budget-input"
                                             Text="{Binding Draft, Mode=OneTime}" MinWidth="160"
                                             Tag="{Binding}"
                                             KeyDown="HeldBudget_KeyDown"
                                             LostFocus="HeldBudget_LostFocus" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- Stopping pauses the hold and keeps the bytes; once
                                         stopped the control says so and disables. -->
                                    <Button AutomationProperties.AutomationId="custody-held-stop-button"
                                            Content="{Binding StopLabel}"
                                            IsEnabled="{Binding StopEnabled}"
                                            Tag="{Binding}" Click="HeldStop_Click" />
                                    <!-- Always available, stopped or not: stop is the
                                         pause and this is the reclaim. -->
                                    <Button AutomationProperties.AutomationId="custody-held-remove-button"
                                            Content="{loc:Localize Key=devices/custody_remove}"
                                            Tag="{Binding}" Click="HeldRemove_Click" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Piece 3, the consent surface: one custody-offer-card per pending
                 offer (indexed — two owners can have offers pending). The floor
                 copy is REQUIRED before accept; the target select renders ONLY
                 where custody_offer_shows_target_select says so (absent
                 otherwise, never disabled). The cards carry their own titles. -->
            <StackPanel x:Name="OfferSection" Spacing="8" Visibility="Collapsed">
                <ItemsControl x:Name="OfferList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8" Spacing="4"
                                        AutomationProperties.AutomationId="custody-offer-card"
                                        AutomationProperties.Name="{Binding Title}">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock AutomationProperties.AutomationId="custody-offer-floor-note"
                                           Text="{loc:Localize Key=devices/custody_offer_floor}"
                                           TextWrapping="Wrap" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Spacing="8"
                                            Visibility="{Binding TargetVisibility}">
                                    <TextBlock Text="{loc:Localize Key=devices/custody_offer_target_label}"
                                               VerticalAlignment="Center" />
                                    <!-- Index 0 = this device (the default), 1 = my nest. -->
                                    <ComboBox AutomationProperties.AutomationId="custody-offer-target-select"
                                              ItemsSource="{Binding TargetOptions}"
                                              SelectedIndex="{Binding TargetIndex, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button AutomationProperties.AutomationId="custody-offer-accept-button"
                                            Content="{loc:Localize Key=devices/custody_offer_accept}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Tag="{Binding}" Click="OfferAccept_Click" />
                                    <Button AutomationProperties.AutomationId="custody-offer-decline-button"
                                            Content="{loc:Localize Key=devices/custody_offer_decline}"
                                            Tag="{Binding}" Click="OfferDecline_Click" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Offer initiation (custody-mint-*): the owner asks a friend over an
                 EXISTING 1:1 conversation (v1: Account scope, default window).
                 The flow opens only over a non-empty host list — an empty one
                 answers on error-message instead. Confirm is disabled until a
                 real host is chosen (index 0 is the placeholder). -->
            <StackPanel Spacing="8">
                <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.CustodyMintButton}"
                        Content="{loc:Localize Key=devices/custody_mint_button}"
                        Click="MintOpen_Click" />
                <StackPanel x:Name="MintFlow" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="{loc:Localize Key=devices/custody_mint_host_label}" />
                    <ComboBox x:Name="MintHostSelect"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.CustodyMintHostSelect}"
                              MinWidth="240"
                              SelectionChanged="MintHostSelect_SelectionChanged" />
                    <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.CustodyMintFloorNote}"
                               Text="{loc:Localize Key=devices/custody_mint_floor}"
                               TextWrapping="Wrap" FontSize="12" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MintConfirm"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.CustodyMintConfirmButton}"
                                Content="{loc:Localize Key=devices/custody_mint_confirm}"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="False" Click="MintConfirm_Click" />
                        <Button AutomationProperties.AutomationId="{x:Bind ids:Ids.CustodyMintCancelButton}"
                                Content="{loc:Localize Key=common/cancel}"
                                Click="MintCancel_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
