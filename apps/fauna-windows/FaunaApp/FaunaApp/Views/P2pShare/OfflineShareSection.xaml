<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline co-present share (p2p.md § Offline share initiation): a two-party
  ceremony that starts a shared set with someone in the same room, no nest
  arbitrating it. Conditional — the whole section is collapsed unless the app
  holds a usable identity secret AND the nest advertises p2p-share (Render's
  own read of FaunaFfiMethods.OfflineShareView.available). The consent card
  for an incoming invitation mints NO ids of its own — FoldersPage appends it
  to its PendingSharesContainer, one indexed family with the ordinary M2
  knocks; a landed scope is appended to its FolderContainer as an ordinary
  (read-only) folder row.

  ⚠ THIS FILE IS THE EXCISION UNIT of the `p2p-share` member's ceremony half,
  and that is why it is a file at all. XAML has no preprocessor, so a
  `#if P2P_SHARE` cannot reach an AutomationId literal: the XAML compiler emits
  every one into the generated .g.cs and the per-page .xbf, both of which ship.
  Removing the ITEM is the only construct that removes the markup, so
  FaunaApp.csproj drops `Views\P2pShare\**` from Page and Compile when
  `/p:FaunaStoreSafe=true` (dynamic-features.md § Platform-family surface
  excision) — the same shape Views\Payments\ takes for `payments`.

  Consequences, both load-bearing:
    · NOTHING may reference this type from markup. FoldersPage hosts it through
      a ContentControl its `#if P2P_SHARE` code-behind fills.
    · An offline-share render placed ANYWHERE ELSE compiles clean in both
      flavors and still ships every id it would have painted — the mutant
      `just windows-store-safe-check` is graded against.

  Reference: apple `OfflineShareSectionView`; tui (the lead app).
-->
<UserControl
    x:Class="FaunaApp.Views.P2pShare.OfflineShareSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:ids="using:FaunaApp.UiIds">

    <StackPanel x:Name="OfflineShareRoot" Spacing="8" Visibility="Collapsed">
        <TextBlock x:Name="OfflineShareHeader" Style="{StaticResource SubtitleTextBlockStyle}"
                   Text="{loc:Localize Key=folders/offline_share_section}" />

        <!-- Closed: the two entry buttons. -->
        <StackPanel x:Name="OfflineShareEntryContainer" Orientation="Horizontal" Spacing="8">
            <Button x:Name="OfflineShareButtonEl"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.OfflineShareButton}"
                    Click="OfflineShareButton_Click"
                    Content="{loc:Localize Key=folders/offline_share_start}" />
            <Button x:Name="OfflineReceiveButtonEl"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.OfflineReceiveButton}"
                    Click="OfflineReceiveButton_Click"
                    Content="{loc:Localize Key=folders/offline_share_receive}" />
        </StackPanel>

        <!-- Initiate / Receive: one panel, controls' visibility toggled
             per OfflineSharePanel (never two ContentDialogs) — Render
             is the single paint point. -->
        <StackPanel x:Name="OfflineShareOpenContainer" Spacing="8" Visibility="Collapsed">
            <TextBlock Text="{loc:Localize Key=folders/offline_share_own_code_label}" Opacity="0.7" />
            <TextBox x:Name="OfflineShareOwnCodeBox"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.OfflineShareOwnCode}"
                     IsReadOnly="True" TextWrapping="Wrap" />
            <TextBlock Text="{loc:Localize Key=folders/offline_share_own_code_help}"
                       Opacity="0.6" TextWrapping="Wrap" />

            <TextBlock Text="{loc:Localize Key=folders/offline_share_peer_code_label}" Opacity="0.7" />
            <TextBox x:Name="OfflineSharePeerCodeInputBox"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.OfflineSharePeerCodeInput}"
                     TextChanged="OfflineSharePeerCodeInput_Changed" />
            <TextBlock x:Name="OfflineShareCodeHintText" Opacity="0.6" TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <TextBlock x:Name="OfflineShareStatusText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.OfflineShareStatus}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="OfflineShareBeginButtonEl"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.OfflineShareBeginButton}"
                        Click="OfflineShareBegin_Click"
                        Content="{loc:Localize Key=folders/offline_share_begin}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="OfflineReceiveExpectButtonEl"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.OfflineReceiveExpectButton}"
                        Click="OfflineReceiveExpect_Click"
                        Content="{loc:Localize Key=folders/offline_share_expect}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="OfflineShareCancelButtonEl"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.OfflineShareCancelButton}"
                        Click="OfflineShareCancel_Click"
                        Content="{loc:Localize Key=common/cancel}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
