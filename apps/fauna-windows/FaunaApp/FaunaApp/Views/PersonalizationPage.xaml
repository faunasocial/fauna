<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.PersonalizationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    xmlns:vm="using:FaunaApp.Core.ViewModels"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!-- Settings → Personalization (content-moderation-and-ranking.md §
         Composition + § Tier-3 community models; ui.yaml personalization): the
         unified home for the user's single tier-1 ruleset. Hubs three facets
         WITHOUT rebuilding them: "Feeds" (exits Settings to the Feed page — the
         trainable factor-weight authoring lands once
         Slice 1 ships), "Muted words" (a link re-homing the ALREADY-SHIPPED
         muted-words sub-page), and "Community labelers" (the caller's
         SUBSCRIBED tier-3 labelers, each unsubscribable inline, with a link out
         to the full labeler-catalog browse/inspect/subscribe page). A thin
         renderer over the shared-Rust LabelerCatalogMachine
         (libs/fauna-labeler-catalog-machine) — this page builds its OWN machine
         instance rendering only the SUBSCRIBED-labelers slice (LabelerCatalogPage
         renders the full catalog off its own instance — the windows per-page-
         machine convention, mirrors Devices/Folders). Mirrors
         apps/fauna-linux/src/views/personalization/mod.rs (the lift reference).

         ⚠ No ConfigureAwait(false) — a WinUI page that mutates bound state off
         the UI thread throws a silent COMException
         (reference_windows_vm_configureawait_comexception). -->

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="16" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">

            <controls:CopyableInfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="True" />

            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{loc:Localize Key=personalization/title}" />

            <Button x:Name="FeedsLinkButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationFeedsLink}"
                    Content="{loc:Localize Key=personalization/feeds_link}"
                    HorizontalAlignment="Left"
                    Click="FeedsLinkButton_Click" />

            <Button x:Name="MutedWordsLinkButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationMutedWordsLink}"
                    Content="{loc:Localize Key=personalization/muted_words_link}"
                    HorizontalAlignment="Left"
                    Click="MutedWordsLinkButton_Click" />

            <!-- Trained-topics facet (topic-factors.md § Authoring surface & picker):
                 list/create/rename/delete the user's trainable tier-1 topic factors. One
                 name-input, two flows (the ratified shape): the input + create-button
                 create a factor inline; a row's rename-button retargets the SAME input at
                 that row (prefilled, button label flips to "Save name") and the next
                 commit renames instead of creating. Mirrors the MutedWords sub-page CRUD
                 shape + apps/fauna-linux/src/views/personalization/trained_topics.rs. -->
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="{loc:Localize Key=personalization/trained_topics_title}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="TrainedTopicNameInput"
                         AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorNameInput}"
                         PlaceholderText="{loc:Localize Key=personalization/trained_factor_placeholder}"
                         Width="240"
                         KeyDown="TrainedTopicNameInput_KeyDown" />
                <Button x:Name="TrainedTopicCreateButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorCreateButton}"
                        Content="{loc:Localize Key=personalization/trained_factor_create}"
                        Click="TrainedTopicCreateButton_Click" />
            </StackPanel>

            <!-- A Border (not a bare container) carries the list test id with a
                 non-empty Name — mirrors LabelersListBorder above (the bare-id-root
                 prune trap); rows live in a non-virtualizing StackPanel so FlaUI
                 realizes every row. -->
            <Border x:Name="TrainedTopicsListBorder"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorList}"
                    AutomationProperties.Name="{loc:Localize Key=personalization/trained_topics_title}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="TrainedTopicsEmptyText"
                               Opacity="0.5" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Text="{loc:Localize Key=personalization/trained_topics_empty}" />
                    <StackPanel x:Name="TrainedTopicsContainer" Spacing="6" />
                </StackPanel>
            </Border>

            <!-- Publish review-prune sheet (topic-factors.md § Publishing a
                 trained factor; frame D8, user-ratified 2026-07-12) — the
                 admin-dns-rename-sheet shape: a single INLINE panel, built ONCE
                 here, Collapsed until a row's personalization-trained-factor-
                 publish-button reveals it, pre-targeted at that row's factor
                 (mirrors AdminDnsPage's RenameSheet Border+Visibility idiom — a
                 ContentDialog does NOT surface personalization-trained-factor-
                 publish-sheet to the FlaUI is_visible tree). Exemplar rows are
                 built dynamically in code-behind (score_corpus_for_factor is
                 async) into a non-virtualizing StackPanel so FlaUI realizes
                 every row (mirrors TrainedTopicsContainer above). Retargeting +
                 generation guard (PersonalizationPage.xaml.cs's
                 _publishGeneration) and default-checked exemplar rows are the
                 load-bearing correctness details this port must not
                 approximate. -->
            <Border x:Name="PublishSheet"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishSheet}"
                    AutomationProperties.Name="{loc:Localize Key=personalization/publish_sheet_title}"
                    Visibility="Collapsed"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Localize Key=personalization/publish_sheet_title}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <!-- The kind select (topic-factors.md § Publishing a
                         trained factor, v2): List (default, weaker
                         disclosure) shares the posts the factor found; Model
                         shares the word patterns it learned. Raw-value select
                         — Items are built in code-behind from the shared
                         fauna_core::format::publish_kind_options catalog
                         (PopulatePublishKindSelect), never a hand-rolled
                         option list, with each ComboBoxItem's
                         AutomationProperties.Name carrying the WIRE value
                         (never the label) for driver.select/get_text. -->
                    <ComboBox x:Name="PublishKindSelect"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishKindSelect}"
                              Header="{loc:Localize Key=personalization/publish_kind_label}"
                              SelectionChanged="PublishKindSelect_SelectionChanged" />

                    <!-- The two mandated disclosures (topic-factors.md §
                         Publishing): List states its corpus limit +
                         anonymity; Model states generalization + the ≥3-doc
                         pattern disclosure (incl. the dislike half) +
                         anonymity, plus the corpus-size line — swapped by
                         UpdatePublishLimitationNote, never static XAML text.
                         Wrapped not truncated — a limitation the user cannot
                         read is not stated. -->
                    <TextBlock x:Name="PublishLimitationNote"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishLimitationNote}"
                               Opacity="0.7" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Text="{loc:Localize Key=personalization/publish_name_label}" Opacity="0.7" />
                    <!-- Starts BLANK on every open — never prefilled from the
                         sealed registry name (topic-factors.md § Publishing:
                         "the name input starts blank on every open, never
                         prefilled from the registry" — the sealed name is
                         private, prefilling would leak it into a public
                         artifact by default). -->
                    <TextBox x:Name="PublishNameInput"
                             AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishNameInput}"
                             PlaceholderText="{loc:Localize Key=personalization/publish_name_placeholder}"
                             HorizontalAlignment="Stretch" />

                    <!-- List kind's review body — visible by default (the
                         sheet always opens on List, topic-factors.md §
                         Publishing); toggled against PublishNgramSection by
                         OpenPublishSheetAsync/SetPublishKindAsync, the two
                         review bodies never both visible at once (ui.yaml:
                         the kind select "swaps the review body"). -->
                    <StackPanel x:Name="PublishExemplarSection" Spacing="8">
                        <TextBlock Text="{loc:Localize Key=personalization/publish_exemplars_title}" Opacity="0.7" />
                        <!-- A Border (not a bare container) carries the list test id
                             with a non-empty Name — the bare-id-root prune trap
                             (mirrors TrainedTopicsListBorder above). -->
                        <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishExemplarList}"
                                AutomationProperties.Name="{loc:Localize Key=personalization/publish_exemplars_title}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="PublishExemplarEmpty"
                                           AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishExemplarEmpty}"
                                           Opacity="0.5" TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Text="{loc:Localize Key=personalization/publish_exemplars_empty}" />
                                <StackPanel x:Name="PublishExemplarContainer" Spacing="4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Model kind's review body (topic-factors.md § Publishing
                         a trained factor, v2; IDs user-approved 2026-08-13) —
                         EVERY surviving n-gram, never a top-N: the vocabulary
                         IS the disclosure (TEXT_MODEL_PUBLISH_MAX_NGRAMS is
                         what keeps "review the whole artifact" feasible).
                         Collapsed until the kind select picks Model. -->
                    <StackPanel x:Name="PublishNgramSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="{loc:Localize Key=personalization/publish_ngrams_title}" Opacity="0.7" />
                        <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishNgramList}"
                                AutomationProperties.Name="{loc:Localize Key=personalization/publish_ngrams_title}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="PublishNgramEmpty"
                                           AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishNgramEmpty}"
                                           Opacity="0.5" TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Text="{loc:Localize Key=personalization/publish_ngrams_empty}" />
                                <StackPanel x:Name="PublishNgramContainer" Spacing="4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Starts disabled: nothing is reviewable until the
                             async corpus read lands (refresh_submit_sensitivity
                             covers both "corpus scored nothing" and "user
                             unchecked everything" — a click that does nothing
                             and explains nothing is indistinguishable from a
                             broken sheet, the restore-confirm-button
                             precedent). -->
                        <Button x:Name="PublishSubmitButton"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishSubmitButton}"
                                Content="{loc:Localize Key=personalization/publish_submit}"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="False"
                                Click="PublishSubmitButton_Click" />
                        <Button x:Name="PublishCancelButton"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationTrainedFactorPublishCancelButton}"
                                Content="{loc:Localize Key=common/cancel}"
                                Click="PublishCancelButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- "Clear activity data" (engagement-cues.md § At rest): the
                 user-revocable affordance for the sealed engagement-cue rollup —
                 deletes cues:v1 from the user's own nest and resets the live
                 engine. Page-level (not per-row): it clears the whole rollup,
                 not one factor. Placed right after the Trained-topics facet per
                 ui.yaml's personalization page element order. -->
            <Button x:Name="ClearEngagementDataButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationClearEngagementDataButton}"
                    Content="{loc:Localize Key=personalization/clear_engagement_data}"
                    HorizontalAlignment="Left"
                    Click="ClearEngagementDataButton_Click" />

            <!-- personalization-share-signals-toggle + signal-share-published-list
                 (engagement-cues.md § Layer B): opt in/out of contributing
                 k-anonymized per-item cue verdicts (watch-complete/skip) on PUBLIC
                 posts to the network, and the transparency pane of exactly what
                 this nest publishes to peers. A sibling of mail-spam's
                 report-share pane (Controls/MailSpamPanel.xaml), riding the SAME
                 shared FfiFeedManager instance the Feed page observes (never a
                 second manager — mirrors the Clear-activity-data button above)
                 via INestRpcClient.{SignalShareStatusAsync,SetSignalSharingAsync}.
                 The realization/render echo is guarded by _signalShareSyncing in
                 the code-behind (mirrors MailSpamPanel's _rsSyncing). This lift
                 proves only the toggle round-trip + pane render — the producer
                 side (a real dwell-derived verdict) needs a windows capture shell
                 (engagement-cues.md § Implementation status today), a separate,
                 not-yet-built track. -->
            <StackPanel Spacing="2">
                <ToggleSwitch x:Name="ShareSignalsToggle"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationShareSignalsToggle}"
                              Header="{loc:Localize Key=personalization/share_signals_label}"
                              Toggled="ShareSignalsToggle_Toggled" />
                <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                           Text="{loc:Localize Key=personalization/share_signals_subtitle}" />
            </StackPanel>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="{loc:Localize Key=personalization/signal_published_title}" />
            <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Localize Key=personalization/signal_published_description}" />
            <Border x:Name="SignalPublishedBorder"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SignalSharePublishedList}"
                    AutomationProperties.Name="{loc:Localize Key=personalization/signal_published_title}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="SignalPublishedEmpty" Opacity="0.5" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Text="{loc:Localize Key=personalization/signal_published_empty}" />
                    <ItemsControl x:Name="SignalPublishedList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SignalSharePublishedRow">
                                <!-- Row container needs AutomationProperties.Name or
                                     FlaUI counts 0 (reference_winui_flaui_datatemplate_name). -->
                                <Border AutomationProperties.AutomationId="{x:Bind ids:Ids.SignalSharePublishedListItem}"
                                        AutomationProperties.Name="{x:Bind ContentHash}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="12" Margin="0,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.SignalSharePublishedListItemHash}"
                                                   Text="{x:Bind ContentHash}"
                                                   IsTextSelectionEnabled="True" />
                                        <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.SignalSharePublishedListItemFactor}"
                                                   Text="{x:Bind Factor}"
                                                   Opacity="0.7" FontSize="12" />
                                        <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.SignalSharePublishedListItemCount}"
                                                   Text="{x:Bind Count}"
                                                   Opacity="0.7" FontSize="12" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}"
                       Text="{loc:Localize Key=labeler_catalog/title}" />

            <!-- A Border (not a bare container) carries the list test id with a
                 non-empty Name — a container without one prunes from the UIA
                 tree along with its children (the bare-id-root prune trap;
                 mirrors MutedWords' ListBorder); rows live in a non-virtualizing
                 StackPanel so FlaUI realizes every row. -->
            <Border x:Name="LabelersListBorder"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationLabelersList}"
                    AutomationProperties.Name="{loc:Localize Key=labeler_catalog/title}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="LabelersEmptyText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationLabelersEmpty}"
                               Opacity="0.5" TextWrapping="Wrap"
                               Visibility="Collapsed"
                               Text="{loc:Localize Key=personalization/labelers_empty}" />
                    <StackPanel x:Name="LabelersContainer" Spacing="6" />
                </StackPanel>
            </Border>

            <Button x:Name="BrowseCatalogButton"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.PersonalizationBrowseCatalogButton}"
                    Content="{loc:Localize Key=personalization/browse_catalog}"
                    HorizontalAlignment="Left"
                    Click="BrowseCatalogButton_Click" />

            <ProgressRing x:Name="LoadProgress" IsActive="False" Visibility="Collapsed"
                          HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Page>
