<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.AdminContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <!--
      The flat admin-contacts page (admin.md § Contacts; carddav-server.md
      § Independent enablement; ui.yaml admin-contacts). The CardDAV-enable
      contacts sibling of admin-calendar's CalDAV-enable toggle: email + calendar
      + contacts are three independently enableable features of one MDA bridge, so
      each gets its own admin toggle. A dumb renderer of the shared
      fauna_client_mail_settings::CarddavPolicyMachine through the testable
      AdminContactsViewModel (FaunaApp.Core), consumed over the UniFFI
      ICarddavPolicyMachine seam (machine-as-seam). The VM owns the
      get_mail_config hydrate (its carddav_enabled field) + the
      set_carddav_enabled write + the re-read-after-write (priority #2); this page
      renders the toggle and forwards the gesture. No port field — CardDAV rides
      the shared DAV listener admin-calendar's port input already governs. Static
      labels localize in XAML via {loc:Localize Key=...}. No ConfigureAwait(false)
      in these handlers (off-thread bound-state mutation throws a silent
      COMException). The admin-nav-back affordance lives in the shared AdminShell
      header, NOT on this page. Mirrors AdminCalendarPage (machine build over the
      shared INestRpcClient seam + the _syncing render guard), minus the port
      StackPanel.
    -->
    <ScrollViewer Padding="16">
        <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

            <!-- App-wide error surface (also mirrored below for the state protocol) -->
            <controls:CopyableInfoBar x:Name="ErrorBar"
                     Severity="Error" IsOpen="False" IsClosable="True" />

            <!-- Header (admin-contacts-heading per ui.yaml) -->
            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminContactsHeading}"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Text="{loc:Localize Key=admin/contacts_page/title}" />
            <TextBlock Opacity="0.7" TextWrapping="Wrap"
                       Text="{loc:Localize Key=admin/contacts_page/description}" />

            <ProgressRing x:Name="LoadProgress" IsActive="False"
                          Visibility="Collapsed" HorizontalAlignment="Left" />

            <!-- Hidden mirror keeps the app-wide error-message ID present for infra
                 (state-protocol read; memory reference_windows_error_read_via_state). -->
            <TextBlock x:Name="ErrorTextMirror"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.ErrorMessage}"
                       AutomationProperties.Name=" " Text=" " FontSize="1" Height="1" Visibility="Collapsed" />

            <!-- ════ CardDAV-enable master toggle (set_carddav_enabled) ════ -->
            <StackPanel Spacing="2">
                <ToggleSwitch x:Name="EnabledToggle"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminContactsCarddavEnabledToggle}"
                              Toggled="EnabledToggle_Toggled"
                              Header="{loc:Localize Key=admin/contacts_page/enabled_label}" />
                <TextBlock Opacity="0.6" TextWrapping="Wrap"
                           Text="{loc:Localize Key=admin/contacts_page/enabled_subtitle}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
