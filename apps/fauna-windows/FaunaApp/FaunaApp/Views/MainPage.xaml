<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:FaunaApp.Helpers"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <Page.Resources>
        <helpers:CollectionCountToVisibilityConverter x:Key="CountToVisibility" />
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="ComposeAccelerator_Invoked" />
        <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="QuickSwitchAccelerator_Invoked" />
        <!-- Ctrl+Comma for Settings — added in code-behind because VK_OEM_COMMA (188) is not in the VirtualKey enum -->
    </Page.KeyboardAccelerators>

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            PaneTitle="Fauna">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Feed"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FeedTab}"
                                    Content="{loc:Localize Key=common/feed}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="PostUpdate" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Conversations"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.ConversationsTab}"
                                    Content="{loc:Localize Key=conversations/list/title}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Message" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Contacts"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.ContactsTab}"
                                    Content="{loc:Localize Key=common/contacts}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Profile"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.ProfileTab}"
                                    Content="{loc:Localize Key=profile/title}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Bridges"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgesTab}"
                                    Content="{loc:Localize Key=common/bridges}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Link" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Backups"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.BackupsTab}"
                                    Content="{loc:Localize Key=backups/title}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="ProtectedDocument" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Media"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.MediaTab}"
                                    Content="{loc:Localize Key=media/title}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Search"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SearchTab}"
                                    Content="{loc:Localize Key=common/search}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Find" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Calendar"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.EventsTab}"
                                    Content="{loc:Localize Key=events/title}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="CalendarReply" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Moderation"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.ModerationTab}"
                                    Content="{loc:Localize Key=settings/moderation}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA18;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="Notifications"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.NotificationsTab}"
                                    Content="{loc:Localize Key=common/notifications}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Comment" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Single gated admin entry (admin.md § Navigation model, Model B).
                     Shown only to admins (ShowAdminNavItems); opens the distinct
                     AdminShellPage, which carries the per-admin-page switcher +
                     the uniform admin-nav-back. Replaces the former six flat admin
                     NavigationView tabs (the Model-A → Model-B migration). -->
                <NavigationViewItemSeparator x:Name="AdminSeparator" Visibility="Collapsed" />
                <!-- ✅ RESOLVED 2026-07-19 — there was NO app-side bug here; do not
                     "fix" this row. The long-standing red of
                     test_admin_tab_visible_for_admin[windows] was a TEST-side issue: this
                     is the LAST entry in a nav pane taller than the e2e window, so it is
                     laid out below the fold (measured: present in the UIA tree with
                     count=1, name='Admin', rect 0x0/IsOffscreen until scrolled — the row
                     above it, notifications-tab, is itself clipped to 21px of its 36).
                     A bare is_visible() reads that identically to "the gate never fired",
                     which is why five app-side fixes were tried and eliminated. The test
                     now uses driver.is_visible_scrolled(). The am_i_admin gate was always
                     correct and is proven to fire ("[admin-gate] am_i_admin=True /
                     revealed admin-tab"). Same story for the gated family-tab below. -->
                <NavigationViewItem x:Name="NavAdmin" Tag="Admin"
                                    Visibility="Collapsed"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.AdminTab}"
                                    Content="{loc:Localize Key=common/admin}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7EE;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <!-- The standalone "Sync conflicts" (conflicts-tab) footer entry was
                     RETIRED by the 2026-06-28 sync/folder UI unification (folders.md
                     § Conflicts): conflicts now render per-set on the Settings → File
                     sets sub-page via the candidate model. -->
                <!-- Single settings entry (settings.md § Navigation model). Opens
                     the distinct SettingsShellPage, which carries the per-sub-page
                     vertical nav rail (Status as the default sub-page, folded in
                     from the former standalone status-tab) + the uniform
                     settings-nav-back. NavigateToSettingsSubPage references this by
                     x:Name (mirrors how NavAdmin drives NavigateToAdminSubPage). -->
                <NavigationViewItem x:Name="NavSettings" Tag="Settings"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SettingsTab}"
                                    Content="{loc:Localize Key=common/settings}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Gated family-tab (family-safety.md § App surface;
                     navigation.gated_tabs: "sidebar row adjacent to
                     settings-tab"). Shown only when fauna.family.status
                     returns any relationship (CheckFamilyStatusAsync) — the
                     admin-tab gating shape, but a footer row beside Settings
                     rather than a main-menu entry, and NOT a shell (routes
                     straight to FamilyPage, no per-page sub-nav). -->
                <!-- ✅ RESOLVED 2026-07-19 — no app-side bug; see the admin-tab note
                     above for the full story. This footer row lands below the fold on a
                     short window exactly the same way (settings-tab occupies the last
                     fitting footer slot), and the family gate was always firing
                     ("[family-gate] incoming=1 / revealed family-tab"). Collapsed until
                     the gate reveals it (Visibility below), so the test side proves
                     reveal by tree-membership — FamilyActions.tab_visible →
                     driver.is_nav_tab_revealed → count()>=1 on windows. (a later fix
                     replaced the is_visible_scrolled check used here: a UIA scroll of this
                     below-fold footer row hung the FlaUI bridge — the app itself is fine.) -->
                <NavigationViewItem x:Name="NavFamily" Tag="Family"
                                    Visibility="Collapsed"
                                    AutomationProperties.AutomationId="{x:Bind ids:Ids.FamilyTab}"
                                    Content="{loc:Localize Key=family/title}">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- ContentFrame + the screen-time lock overlay share ONE Grid cell so
                 the overlay covers exactly the content area — never the sidebar
                 (family-tab must stay reachable) and never the top-chrome globals
                 declared as this outer Grid's own later siblings below
                 (supervised-indicator must stay clickable), mirroring apple's
                 "applied BEFORE each shell's top-chrome safeAreaInset" placement
                 and tui's "the sidebar is untouched" rule (family-safety.md
                 § Screen time). -->
            <Grid>
                <Frame x:Name="ContentFrame" />
                <!-- Global screen-time-lock overlay (family-safety.md § Screen
                     time; IDs user-approved 2026-07-15): conditionally-present,
                     full-screen-within-content, naming the policy + the
                     guardian. Toggled in code-behind (UpdateScreenTimeLockOverlay)
                     off ScreenTimeCache.LockMessage AND whether ContentFrame is
                     currently on FamilyPage — the Family page stays reachable
                     read-only while locked (the goal-doc invariant this overlay
                     exists to honor), so it is never shown there even while a
                     lock is active. AutomationProperties.Name is required on the
                     container itself, not just its child TextBlock — a container
                     carrying only an AutomationId is UIA-pruned while its
                     children still resolve fine (the critical-alerts lesson
                     above), which would make is_visible("screen-time-lock")
                     read false even while genuinely Visible. -->
                <Grid x:Name="ScreenTimeLockOverlay"
                      AutomationProperties.AutomationId="{x:Bind ids:Ids.ScreenTimeLock}"
                      AutomationProperties.Name="screen time lock"
                      Visibility="Collapsed"
                      Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <TextBlock x:Name="ScreenTimeLockMessageText"
                               AutomationProperties.AutomationId="{x:Bind ids:Ids.ScreenTimeLockMessage}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               MaxWidth="480" TextWrapping="Wrap"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Global critical-alerts banner (critical-alerts.md § Rendering
             contract): prominent, destructive-styled, non-dismissable while
             active — present iff ≥1 alert is active (CountToVisibility on
             MainViewModel.ActiveCriticalAlerts). At Page level, on top of
             NavigationView in z-order (declared after it), so it renders on
             every authenticated page the Frame swaps underneath it. A
             non-virtualizing StackPanel items panel keeps every row realized
             in the UIA tree (mirrors FeedPage's post-card/feed-item lists —
             memory: bounded count-all lists). Each row repeats the SAME
             `critical-alert` AutomationId (indexed by driver-level position,
             never a `critical-alert[0]` id string); Name carries the row text
             too, or a DataTemplate element with only an AutomationId is
             UIA-pruned (reference_winui_flaui_datatemplate_name). -->
        <!-- AutomationProperties.Name required, and it is what made this banner
             read as "never fires" for two sessions: a container carrying only an
             AutomationId is PRUNED from the UIA tree while its children resolve
             normally, so `critical-alert` counted 1 (the alarm WAS up) while
             `critical-alerts` counted 0 and is_visible stayed False forever.
             Same trap as atproto-depth-selector / quota-section / events-month-grid
             (e2e_status_and_tips.md § Windows; the asymmetric count is the
             tell). Safe on a get_text target: ElementFinder.GetText scrapes child
             TextBlocks first and falls back to the element's own Name only as a
             last resort, so a container Name never shadows the row text. -->
        <ItemsControl x:Name="CriticalAlertsList"
                      AutomationProperties.AutomationId="{x:Bind ids:Ids.CriticalAlerts}"
                      AutomationProperties.Name="critical alerts"
                      ItemsSource="{Binding ActiveCriticalAlerts, Mode=OneWay}"
                      Visibility="{Binding ActiveCriticalAlerts, Mode=OneWay, Converter={StaticResource CountToVisibility}}"
                      VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <!-- TextBlock has no Background property in WinUI (unlike
                         Border/Control) — the destructive fill lives on a Border
                         wrapper; the AutomationId/Name/text stay on the TextBlock
                         itself, which is what FlaUI's get_text reads. -->
                    <Border Background="#B00020" Padding="16,10"
                            HorizontalAlignment="Stretch">
                        <TextBlock Text="{x:Bind}"
                                   AutomationProperties.AutomationId="{x:Bind ids:Ids.CriticalAlert}"
                                   AutomationProperties.Name="{x:Bind}"
                                   Foreground="White" TextWrapping="Wrap" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Global test message elements — at Page level (outside NavigationView)
             so FlaUI can always find them. Uses TextBox (ReadOnly) because
             TextBlock doesn't always create UIA peers, and InfoBar has animation delays.
             The connection-status indicator lives here for the SAME reason: the
             NavigationView PaneHeader (the visual "top of sidebar") is not reliably
             realized in the UIA tree, so FlaUI can't read it there. -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right"
                    Margin="0,8,16,0" IsHitTestVisible="False">
            <!-- Global connection-status indicator (transport.md § Connection-status
                 indicator): always-visible live nest WS-RPC connection state, reading
                 Connected / Connecting… / Disconnected, bound to
                 MainViewModel.ConnectionStatus. The visible half of the reconnect
                 machinery — a transient drop shows "Connecting…", never an error
                 banner. Unlike the empty message shims below it is normally visible. -->
            <TextBox x:Name="ConnectionStatusText" Text="{Binding ConnectionStatus, Mode=OneWay}"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.ConnectionStatus}"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" />
            <!-- Global sync-agent-status indicator (sync-agent.md § Local agent
                 health): the LOCAL fauna-sync-agent process's own health
                 (Running / Restart pending / Not running) — a distinct concept
                 from connection-status above (that one is the nest WS-RPC link).
                 The canonical, AutomationId-bearing location (matches linux/macOS;
                 ui.yaml § sync-agent-status). -->
            <TextBox x:Name="SyncAgentStatusTextBox" Text="{Binding SyncAgentStatusText, Mode=OneWay}"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.SyncAgentStatus}"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" />
            <TextBox x:Name="SyncAgentStatusVersionTextBox" Text="{Binding SyncAgentStatusVersionText, Mode=OneWay}"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.SyncAgentStatusVersion}"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" />
            <TextBox x:Name="SyncAgentStatusUptimeTextBox" Text="{Binding SyncAgentStatusUptimeText, Mode=OneWay}"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.SyncAgentStatusUptime}"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" />
            <!-- Collapsed until they carry a message, and collapsed again the moment
                 they are cleared (UpdateTestMessages → MessageShim.ShouldShow). These
                 share `error-message`/`warning-message`/`info-message` with every
                 page's OWN InfoBar, and the FlaUI bridge resolves an id window-wide
                 checking only !IsOffscreen — so an always-on-screen empty shim made
                 `is_visible("error-message")` true on a clean page and silently
                 unobservable the "no error at page start" assertion every such e2e
                 opens with. A collapsed element has no UIA peer, which is how the
                 shared id stays honest (same net effect linux gets structurally from
                 automation/find.rs::is_showing). -->
            <TextBox x:Name="GlobalErrorText" Text="" Visibility="Collapsed"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.ErrorMessage}"
                     IsReadOnly="True" BorderThickness="0" MinHeight="1" MinWidth="1" />
            <TextBox x:Name="GlobalWarningText" Text="" Visibility="Collapsed"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.WarningMessage}"
                     IsReadOnly="True" BorderThickness="0" MinHeight="1" MinWidth="1" />
            <TextBox x:Name="GlobalInfoText" Text="" Visibility="Collapsed"
                     AutomationProperties.AutomationId="{x:Bind ids:Ids.InfoMessage}"
                     IsReadOnly="True" BorderThickness="0" MinHeight="1" MinWidth="1" />
        </StackPanel>

        <!-- Global supervised-indicator (family-safety.md § App surface —
             the one conditionally-present global element): permanent,
             non-dismissable chrome for supervised accounts, navigating to the
             family page. Rendered ONLY when fauna.family.status.supervised_by
             is set (CheckFamilyStatusAsync). A SEPARATE, hit-testable overlay
             from the StackPanel above (that one is IsHitTestVisible="False"
             so it never eats clicks meant for the page below — this button
             must actually be clickable). -->
        <Button x:Name="SupervisedIndicatorButton"
                AutomationProperties.AutomationId="{x:Bind ids:Ids.SupervisedIndicator}"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,36,16,0"
                Visibility="Collapsed"
                Click="SupervisedIndicatorButton_Click" />
    </Grid>
</Page>
