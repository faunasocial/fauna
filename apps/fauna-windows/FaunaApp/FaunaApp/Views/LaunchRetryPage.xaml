<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.LaunchRetryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ids="using:FaunaApp.UiIds">
    <Grid Padding="48" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
        <StackPanel Spacing="16" HorizontalAlignment="Center">
            <TextBlock x:Name="MessageText"
                       AutomationProperties.AutomationId="{x:Bind ids:Ids.LaunchTransientError}"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Button x:Name="RetryButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.LaunchRetryButton}"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnRetryClick" />
                <Button x:Name="FallthroughButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.LaunchFallthroughButton}"
                        Click="OnFallthroughClick" />
                <!-- box-recovery.md § Recovery UI (step 4), surviving-device entry.
                     Hidden until the launch-time reachable-nest box-list read
                     (App.xaml.cs, off the SAME saved nest) resolves >= 1
                     custodied box (ShowRecoverButton below) — a truly-dead
                     saved nest leaves this collapsed. -->
                <Button x:Name="RecoverButton"
                        AutomationProperties.AutomationId="{x:Bind ids:Ids.LaunchRecoverButton}"
                        Visibility="Collapsed"
                        Click="OnRecoverClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
