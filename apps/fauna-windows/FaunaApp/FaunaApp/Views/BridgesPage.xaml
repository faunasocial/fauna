<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.BridgesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:models="using:FaunaApp.Core.Models"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="BridgesTitle" AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

        <!-- Each row is the shared `bridge-card` component (Controls/BridgeCard),
             extracted out of this file 2026-07-31 so the AT Protocol page's Linked panel
             can embed the identical widget tree with zero new element IDs — the same
             extraction every sibling app made before windows (ui/atproto.md § Layout
             & flow item 3). The widget tree is unchanged by the move; the plain
             `ActionClick="..."` attribute resolves against this page's code-behind
             exactly as the old inline `Click=` did. -->
        <ListView Grid.Row="1" x:Name="BridgesList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:BridgeInfo">
                    <controls:BridgeCard Bridge="{x:Bind}" ActionClick="BridgeAction_Click"
                                         SettingChanged="BridgeSetting_Changed"
                                         SourceAskClick="BridgeSourceAsk_Click"
                                         FollowRequestAnswer="BridgeFollowRequest_Answer"
                                         FollowAdd="BridgeFollow_Add"
                                         FollowRemove="BridgeFollow_Remove" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <!-- The admin's hosted plugins (bridges.md § Hosted plugins on this page), after
                 the bridges, as on tui (`bridges.rs::plugin_elements`). Collapsed (pruned from
                 UIA) unless the admin gate passes. Rows are built in code-behind (RenderPlugins):
                 each `bridge-plugin-item` is a Grid root with a non-empty Name, its leaves
                 scoped inside it. -->
            <ListView.Footer>
                <StackPanel>
                    <!-- Every account's plugin settings cards (third-party.md § The principal
                         model → Hosted principals), after the bridges: one more `bridge-card`
                         per installed plugin, its `bridge-action-button` Connect/Disconnect
                         carrying `client_id` + `bound`, its settings through the one settings
                         renderer (BridgeSettingRows). Built in code-behind (RenderPluginCards),
                         as on tui (`bridges.rs::plugin_card_elements`). -->
                    <StackPanel x:Name="PluginCardsHost" />
                    <TextBlock x:Name="PluginBindOpenedText" Opacity="0.7" TextWrapping="Wrap"
                               Margin="12,4,0,0" Visibility="Collapsed" />
                    <StackPanel x:Name="PluginsSection" Spacing="8" Margin="0,16,0,0"
                                Visibility="Collapsed" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock x:Name="PluginsHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="PluginsEmpty" Opacity="0.7" Visibility="Collapsed" />
                        <StackPanel x:Name="PluginsHost" Spacing="8" />
                        <TextBox x:Name="PluginInstallUrlBox"
                                 AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgePluginInstallUrl}"
                                 TextChanged="PluginInstallUrl_TextChanged" />
                        <Button x:Name="PluginInstallButton"
                                AutomationProperties.AutomationId="{x:Bind ids:Ids.BridgePluginInstallSubmit}"
                                Style="{StaticResource AccentButtonStyle}"
                                IsEnabled="False"
                                Click="PluginInstall_Click" />
                        <TextBlock x:Name="PluginInstallOpenedText" Opacity="0.7" TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ListView.Footer>
        </ListView>

        <ProgressRing Grid.Row="1" x:Name="LoadingRing"
                      IsActive="False" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

        <controls:CopyableInfoBar Grid.Row="1" x:Name="ErrorBar"
                 Severity="Error" IsOpen="False" IsClosable="True"
                 VerticalAlignment="Bottom" Margin="0,0,0,16" />
    </Grid>
</Page>
