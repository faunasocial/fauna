<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FaunaApp.Views.SettingsGeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FaunaApp.Views"
    xmlns:loc="using:FaunaApp.Markup"
    xmlns:controls="using:FaunaApp.Controls"
    Loaded="Page_Loaded"
    xmlns:ids="using:FaunaApp.UiIds">

    <ScrollViewer Padding="16">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">

            <!-- Error bar -->
            <controls:CopyableInfoBar
                x:Name="ErrorBar"
                Severity="Error"
                IsOpen="False"
                IsClosable="True" />

            <!-- Header -->
            <TextBlock AutomationProperties.AutomationId="{x:Bind ids:Ids.PageHeading}" Style="{StaticResource TitleTextBlockStyle}" Text="{loc:Localize Key=settings/general}" />

            <!-- Startup section -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Localize Key=settings/startup}" />
                <ToggleSwitch x:Name="AutoStartToggle"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.SettingsAutostartToggle}"
                              Toggled="AutoStartToggle_Toggled"
                              Header="{loc:Localize Key=settings/autostart_header}" />

                <!-- Close-to-tray: ON (default — the 2026-07-16 shape-A residency flip;
                     a window close must not silently stop sync/badges/toasts) ⇒ hide to
                     tray, stay resident; OFF (explicit opt-out) ⇒ closing the window
                     quits (apps/windows.md § App Lifecycle). Shared desktop
                     platform_element with linux's Close-to-tray switch. -->
                <ToggleSwitch x:Name="CloseToTrayToggle"
                              AutomationProperties.AutomationId="{x:Bind ids:Ids.CloseToTrayToggle}"
                              Toggled="CloseToTrayToggle_Toggled"
                              Header="{loc:Localize Key=settings/close_to_tray_header}" />
                <TextBlock Opacity="0.7" FontSize="12"
                           Text="{loc:Localize Key=settings/close_to_tray_subtitle}" />
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Configure nest section -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Localize Key=settings/configure_nest}" />
                <TextBlock Opacity="0.7" Text="{loc:Localize Key=settings/configure_nest_desc}" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        x:Name="NewNestUrlBox"
                        Header="{loc:Localize Key=settings/new_nest_url}"
                        PlaceholderText="{loc:Localize Key=settings/new_nest_url_placeholder}" />

                    <Button
                        Grid.Column="1"
                        x:Name="ConfigureButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ConfigureButton_Click"
                        VerticalAlignment="Bottom"
                        Content="{loc:Localize Key=settings/update_button}" />
                </Grid>

                <ProgressRing
                    x:Name="ConfigureProgress"
                    IsActive="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Updates section -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Localize Key=settings/updates}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        x:Name="CheckUpdateButton"
                        Click="CheckUpdateButton_Click"
                        Content="{loc:Localize Key=settings/check_for_updates}" />

                    <TextBlock
                        Grid.Column="1"
                        x:Name="UpdateStatusText"
                        VerticalAlignment="Center"
                        Opacity="0.7" />
                </Grid>

                <ProgressRing
                    x:Name="UpdateProgress"
                    IsActive="False"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Storage section -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Localize Key=common/storage}" />
                <TextBlock Opacity="0.7" Text="{loc:Localize Key=settings/storage_desc}" />

                <ProgressBar
                    x:Name="StorageBar"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SettingsStorageBar}"
                    Minimum="0"
                    Maximum="100"
                    Value="0" />

                <TextBlock
                    x:Name="StorageText"
                    AutomationProperties.AutomationId="{x:Bind ids:Ids.SettingsStorageText}"
                    Text="{loc:Localize Key=common/loading}"
                    Opacity="0.7"
                    FontSize="12" />
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- About section -->
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{loc:Localize Key=settings/about}" />
                <TextBlock Opacity="0.7" Text="{loc:Localize Key=settings/about_name}" />
                <TextBlock Opacity="0.5" FontSize="12" Text="{loc:Localize Key=settings/about_desc}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
