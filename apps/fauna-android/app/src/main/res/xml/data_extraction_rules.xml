<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing in this app's private tree travels: not to cloud backup, not to a
  device-to-device transfer. The credential files are sealed under a Keystore key
  that never leaves the phone, so a copy would arrive without its key
  (docs/goal/architecture/apps/common.md § Credential storage → What a device's own
  backup carries). For an app targeting API 31+, android:allowBackup="false" alone
  does not stop the transfer on some manufacturers' devices; these rules do.
  CloudBackupPostureTest fails if either section lacks an exclude for any domain.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
