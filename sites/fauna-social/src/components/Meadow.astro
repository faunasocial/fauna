---
import Beaver from './critters/Beaver.astro';
import Bee from './critters/Bee.astro';
import Duckling from './critters/Duckling.astro';
import Fox from './critters/Fox.astro';
import Frog from './critters/Frog.astro';
import Hedgehog from './critters/Hedgehog.astro';
import Mouse from './critters/Mouse.astro';
import Otter from './critters/Otter.astro';
import Owl from './critters/Owl.astro';
import Rabbit from './critters/Rabbit.astro';
import Squirrel from './critters/Squirrel.astro';
import Tree from './scene/Tree.astro';

export interface CastEntry {
  critter: any;
  delay: string;
  /** Extra props for the drawing (the beaver's `pack`). */
  props?: Record<string, unknown>;
  /** Stand out of the row: half again as wide as the others. */
  featured?: boolean;
}

interface Props {
  /** Extra sky above the hills, in drawing units (the front page has none);
      the talk slides use it to make room for a picture behind the meadow. */
  sky?: number;
  /** The line-up, left to right. Defaults to the front page's cast. */
  cast?: CastEntry[];
  /** What a screen reader is told the picture shows. */
  label?: string;
}

// The meadow line-up (user's pick, 2026-08-05). It is a subset of the drawn
// critters, not all of them — the rest stay available to the pages through
// Critter.astro. Ordered so neighbours differ in colour and height rather
// than alphabetically: three browns in a row read as one brown smear at this
// size. The wave delays are deliberately unsorted so the row ripples instead
// of sweeping left to right.
const defaultCast: CastEntry[] = [
  { critter: Fox, delay: '0s' },
  { critter: Duckling, delay: '0.45s' },
  { critter: Hedgehog, delay: '0.9s' },
  { critter: Mouse, delay: '0.6s' },
  { critter: Owl, delay: '1.05s' },
  { critter: Frog, delay: '0.3s' },
  { critter: Bee, delay: '1.2s' },
  { critter: Otter, delay: '0.15s' },
  { critter: Squirrel, delay: '0.5s' },
  { critter: Rabbit, delay: '1.1s' },
  { critter: Beaver, delay: '0.55s' },
];

const {
  sky = 0,
  cast = defaultCast,
  label = 'Eleven friendly animals waving from a meadow: a fox, a duckling, a hedgehog, a mouse, an owl, a frog, a bee, an otter, a squirrel, a rabbit and a beaver.',
} = Astro.props;

// The sun climbs with the sky, so it stays clear of whatever a scene puts
// along the top of the picture.
const sunY = 42 - sky;
---
<div class="meadow" role="img" aria-label={label}>
  {/* Four slots take a scene's own drawings, one per depth: `backdrop` sits
      behind the back hill (in front of the sky and sun), `midground` between
      the back hill and the middle one — where the front page's tree stands;
      a scene that fills it places its own trees — `foreground` between the
      middle hill and the near grass strip, and `front` in front of
      everything, on the near grass itself. */}
  {/* --hills-h sizes the box; the unitless --hills-units twin lets a page
      compute its own height from the drawing's proportions (the talk slides:
      100vw * units / 1200) without hard-coding each scene's sky. */}
  <svg class="hills" viewBox={`0 ${-sky} 1200 ${210 + sky}`}
    style={`--hills-h:${210 + sky}px; --hills-units:${210 + sky}`}
    preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <circle cx="1060" cy={sunY} r="30" fill="var(--sun)" />
    <slot name="backdrop" />
    <path d="M0 120 Q300 45 600 110 T1200 95 L1200 210 L0 210 Z" fill="var(--meadow-hill-1)" />
    <slot name="midground">
      <Tree x={118.5} y={130} />
    </slot>
    <path d="M0 158 Q400 95 800 150 T1200 140 L1200 210 L0 210 Z" fill="var(--meadow-hill-2)" />
    <slot name="foreground" />
    <!-- flowers -->
    <g stroke="var(--meadow-hill-3)" stroke-width="2.5">
      <line x1="250" y1="150" x2="250" y2="132" />
      <line x1="960" y1="162" x2="960" y2="144" />
      <line x1="1130" y1="170" x2="1130" y2="152" />
    </g>
    <g fill="#e8a1b0">
      <circle cx="250" cy="128" r="6" />
      <circle cx="960" cy="140" r="6" />
      <circle cx="1130" cy="148" r="6" />
    </g>
    <g fill="var(--sun)">
      <circle cx="250" cy="128" r="2.4" />
      <circle cx="960" cy="140" r="2.4" />
      <circle cx="1130" cy="148" r="2.4" />
    </g>
    <path d="M0 195 Q600 158 1200 190 L1200 210 L0 210 Z" fill="var(--meadow-hill-3)" />
    <slot name="front" />
  </svg>
  {cast.length > 0 && (
    <div class="critters">
      {cast.map((c) => c.featured ? (
        <div class="featured"><c.critter delay={c.delay} {...(c.props ?? {})} /></div>
      ) : (
        <c.critter delay={c.delay} {...(c.props ?? {})} />
      ))}
    </div>
  )}
</div>

<style>
  .meadow {
    position: relative;
    margin-top: 1.5rem;
  }
  .hills {
    display: block;
    width: 100%;
    height: var(--hills-h, 210px);
  }
  .critters {
    position: absolute;
    bottom: 14px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 2px;
    padding: 0 0.5rem;
  }
  /* The whole cast stands shoulder to shoulder in one row. `flex: 1 1 0`
     divides the row between however many critters there are, so adding or
     removing one needs no arithmetic here — only the max-width caps how big
     a small cast is allowed to get. A featured critter takes half again as
     much. Below the breakpoint the row would shrink them past legibility, so
     they wrap onto the taller meadow instead. */
  .critters :global(.critter) {
    flex: 1 1 0;
    min-width: 0;
    max-width: 64px;
    height: auto;
  }
  .critters > :global(.featured) {
    flex: 1.5 1 0;
    min-width: 0;
    max-width: 96px;
  }
  .critters :global(.featured .critter) {
    max-width: none;
    width: 100%;
  }
  @media (max-width: 720px) {
    .hills { height: calc(var(--hills-h, 210px) + 50px); }
    .critters {
      flex-wrap: wrap;
      justify-content: center;
      gap: 2px 4px;
    }
    .critters :global(.critter) {
      flex: 0 0 auto;
      width: clamp(34px, 11vw, 52px);
    }
    .critters > :global(.featured) {
      flex: 0 0 auto;
      width: clamp(50px, 16vw, 78px);
    }
  }
</style>
