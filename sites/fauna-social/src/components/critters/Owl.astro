---
interface Props { size?: number; delay?: string; }
const { size = 110, delay = '0s' } = Astro.props;
---
<svg viewBox="0 0 120 140" width={size} height={Math.round((size * 140) / 120)}
  class="critter" style={`--wave-delay:${delay}`} aria-hidden="true">
  <ellipse cx="60" cy="134" rx="28" ry="5" class="critter-shadow" />
  <!-- waving wing -->
  <g class="wave" style="transform-origin: 84px 84px;">
    <ellipse cx="92" cy="72" rx="9" ry="20" transform="rotate(-35 92 72)" fill="#6f5f4f" />
  </g>
  <!-- body -->
  <ellipse cx="60" cy="94" rx="30" ry="36" fill="#8d7b68" />
  <ellipse cx="60" cy="106" rx="18" ry="18" fill="#a99a86" />
  <!-- head -->
  <circle cx="60" cy="52" r="26" fill="#8d7b68" />
  <path d="M38 40 L34 22 L48 32 Z" fill="#8d7b68" />
  <path d="M82 40 L86 22 L72 32 Z" fill="#8d7b68" />
  <ellipse cx="60" cy="60" rx="26" ry="17" fill="#f3e6ce" />
  <circle cx="48" cy="58" r="9" fill="#ffffff" />
  <circle cx="72" cy="58" r="9" fill="#ffffff" />
  <circle cx="48" cy="58" r="4" fill="#2b2a24" />
  <circle cx="72" cy="58" r="4" fill="#2b2a24" />
  <path d="M55 68 L65 68 L60 77 Z" fill="#f4c95d" />
  <!-- folded wing -->
  <ellipse cx="34" cy="98" rx="10" ry="20" transform="rotate(15 34 98)" fill="#6f5f4f" />
  <ellipse cx="48" cy="131" rx="6" ry="4" fill="#f4c95d" />
  <ellipse cx="72" cy="131" rx="6" ry="4" fill="#f4c95d" />
</svg>
