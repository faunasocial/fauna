---
interface Props { size?: number; delay?: string; }
const { size = 110, delay = '0s' } = Astro.props;
---
<svg viewBox="0 0 120 140" width={size} height={Math.round((size * 140) / 120)}
  class="critter" style={`--wave-delay:${delay}`} aria-hidden="true">
  <ellipse cx="60" cy="133" rx="23" ry="5" class="critter-shadow" />
  <!-- wings, behind everything -->
  <ellipse cx="34" cy="62" rx="13" ry="22" transform="rotate(-22 34 62)" fill="#cfe6f2" />
  <ellipse cx="86" cy="62" rx="13" ry="22" transform="rotate(22 86 62)" fill="#cfe6f2" />
  <!-- antennae -->
  <path d="M50 34 Q44 22 40 18" stroke="#55482f" stroke-width="3" fill="none" stroke-linecap="round" />
  <path d="M70 34 Q76 22 80 18" stroke="#55482f" stroke-width="3" fill="none" stroke-linecap="round" />
  <circle cx="39" cy="16" r="4" fill="#f4c95d" />
  <circle cx="81" cy="16" r="4" fill="#f4c95d" />
  <!-- waving foreleg -->
  <g class="wave" style="transform-origin: 80px 92px;">
    <ellipse cx="85" cy="83" rx="4" ry="12" transform="rotate(-30 85 83)" fill="#55482f" />
    <circle cx="89" cy="72" r="4" fill="#55482f" />
  </g>
  <!-- striped body -->
  <ellipse cx="60" cy="98" rx="26" ry="30" fill="#f4c95d" />
  <ellipse cx="60" cy="84" rx="22" ry="4.5" fill="#55482f" />
  <ellipse cx="60" cy="100" rx="25.5" ry="4.5" fill="#55482f" />
  <ellipse cx="60" cy="114" rx="21" ry="4.5" fill="#55482f" />
  <ellipse cx="48" cy="131" rx="6" ry="4" fill="#55482f" />
  <ellipse cx="72" cy="131" rx="6" ry="4" fill="#55482f" />
  <!-- head -->
  <circle cx="60" cy="52" r="20" fill="#55482f" />
  <circle cx="52" cy="48" r="5.5" fill="#ffffff" />
  <circle cx="68" cy="48" r="5.5" fill="#ffffff" />
  <circle cx="52" cy="48" r="2.8" fill="#2b2a24" />
  <circle cx="68" cy="48" r="2.8" fill="#2b2a24" />
  <path d="M54 60 Q60 65 66 60" stroke="#f4c95d" stroke-width="2" fill="none" stroke-linecap="round" />
</svg>
