---
interface Props { size?: number; delay?: string; }
const { size = 110, delay = '0s' } = Astro.props;
---
{/* Species-true colouring: grey body, dark limbs and belly, white face with
    the two dark stripes — the one critter whose belly is darker than its coat
    (the penguin keeps it company). */}
<svg viewBox="0 0 120 140" width={size} height={Math.round((size * 140) / 120)}
  class="critter" style={`--wave-delay:${delay}`} aria-hidden="true">
  <ellipse cx="60" cy="134" rx="29" ry="5" class="critter-shadow" />
  <!-- waving arm (behind body) -->
  <g class="wave" style="transform-origin: 82px 96px;">
    <ellipse cx="88" cy="86" rx="6" ry="14" transform="rotate(-30 88 86)" fill="#33312b" />
    <circle cx="93" cy="74" r="5" fill="#847e6e" />
  </g>
  <!-- ears (behind head) -->
  <circle cx="42" cy="32" r="6.5" fill="#847e6e" />
  <circle cx="78" cy="32" r="6.5" fill="#847e6e" />
  <!-- body -->
  <ellipse cx="60" cy="103" rx="27" ry="27" fill="#847e6e" />
  <ellipse cx="60" cy="110" rx="15" ry="16" fill="#33312b" />
  <ellipse cx="38" cy="106" rx="6" ry="12" transform="rotate(20 38 106)" fill="#33312b" />
  <ellipse cx="48" cy="130" rx="8" ry="4.5" fill="#33312b" />
  <ellipse cx="72" cy="130" rx="8" ry="4.5" fill="#33312b" />
  <!-- head -->
  <circle cx="60" cy="52" r="22" fill="#f3e6ce" />
  <ellipse cx="50" cy="50" rx="5" ry="17" transform="rotate(8 50 50)" fill="#33312b" />
  <ellipse cx="70" cy="50" rx="5" ry="17" transform="rotate(-8 70 50)" fill="#33312b" />
  <!-- eyes sit inside the stripes, ringed so they read -->
  <circle cx="50" cy="48" r="4.5" fill="#f3e6ce" />
  <circle cx="70" cy="48" r="4.5" fill="#f3e6ce" />
  <circle cx="50" cy="48" r="2.8" fill="#2b2a24" />
  <circle cx="70" cy="48" r="2.8" fill="#2b2a24" />
  <ellipse cx="60" cy="63" rx="3.5" ry="2.8" fill="#2b2a24" />
  <path d="M54 69 Q60 74 66 69" stroke="#2b2a24" stroke-width="2" fill="none" stroke-linecap="round" />
</svg>
