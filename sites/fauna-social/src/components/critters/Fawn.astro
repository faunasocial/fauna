---
interface Props { size?: number; delay?: string; }
const { size = 110, delay = '0s' } = Astro.props;
---
<svg viewBox="0 0 120 140" width={size} height={Math.round((size * 140) / 120)}
  class="critter" style={`--wave-delay:${delay}`} aria-hidden="true">
  <ellipse cx="58" cy="134" rx="27" ry="5" class="critter-shadow" />
  <!-- ears, tucked behind the head -->
  <ellipse cx="32" cy="40" rx="12" ry="7" transform="rotate(-28 32 40)" fill="#c08a5c" />
  <ellipse cx="84" cy="40" rx="12" ry="7" transform="rotate(28 84 40)" fill="#c08a5c" />
  <ellipse cx="33" cy="41" rx="6.5" ry="3.4" transform="rotate(-28 33 41)" fill="#e8c39a" />
  <ellipse cx="83" cy="41" rx="6.5" ry="3.4" transform="rotate(28 83 41)" fill="#e8c39a" />
  <!-- waving foreleg -->
  <g class="wave" style="transform-origin: 80px 100px;">
    <ellipse cx="85" cy="89" rx="5" ry="14" transform="rotate(-28 85 89)" fill="#a06e42" />
    <circle cx="89" cy="76" r="4.2" fill="#6d472b" />
  </g>
  <!-- body, with a fawn's spots -->
  <ellipse cx="58" cy="102" rx="25" ry="27" fill="#c08a5c" />
  <ellipse cx="58" cy="110" rx="15" ry="16" fill="#f7e8d4" />
  <circle cx="43" cy="92" r="3.4" fill="#f7e8d4" />
  <circle cx="57" cy="87" r="3" fill="#f7e8d4" />
  <circle cx="71" cy="94" r="3.4" fill="#f7e8d4" />
  <circle cx="46" cy="105" r="2.8" fill="#f7e8d4" />
  <ellipse cx="37" cy="102" rx="5" ry="12" transform="rotate(20 37 102)" fill="#a06e42" />
  <ellipse cx="47" cy="131" rx="6" ry="4" fill="#6d472b" />
  <ellipse cx="69" cy="131" rx="6" ry="4" fill="#6d472b" />
  <!-- head -->
  <circle cx="58" cy="56" r="21" fill="#c08a5c" />
  <ellipse cx="58" cy="66" rx="11" ry="8" fill="#f7e8d4" />
  <circle cx="49" cy="52" r="3.4" fill="#2b2a24" />
  <circle cx="67" cy="52" r="3.4" fill="#2b2a24" />
  <ellipse cx="58" cy="63" rx="3.5" ry="2.6" fill="#2b2a24" />
</svg>
