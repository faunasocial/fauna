---
// The title slide's picture: the clearing outside the walls, everyone in
// conversation — social life on open networks.
//
// Round 4 (user direction): the scene is the story, so everything is drawn
// big, and nobody just waves at the camera any more — the critters talk TO
// EACH OTHER, or use their nests. The rabbit and the mouse chat (two
// bubbles — the mouse answers with a heart); the bluebird sings from the
// big tree and the nest bird in the middle tree chirps back across the
// clearing (a call between nests); the mammoth trumpets to everyone (the
// Fediverse broadcasting); the hedgehog reads a letter the pigeon brought —
// the next one is already on its way at treetop height, in the gap between
// the big tree and the beaver (rounds 8–9: smaller bird, bigger envelope,
// lower flight, then pinned in place); the frog and the
// duckling wave to each other across the pond; the fox stands in the row
// left of the mammoth (round 8 — it took the retired squirrel's spot, and
// its trail from the breach went with the squirrel). Only the beaver —
// Fauna itself, three times anyone else, the toolkit on its back — looks
// out and waves at YOU: the invitation. The wall is a distant, bad memory
// on the far-left horizon, and the sun and the whole blue sky are on the
// outside. The round-4 state is frozen as `ClearingInConversation.astro`.
import Meadow from '../Meadow.astro';
import Beaver from '../critters/Beaver.astro';
import Duckling from '../critters/Duckling.astro';
import Fox from '../critters/Fox.astro';
import Frog from '../critters/Frog.astro';
import Hedgehog from '../critters/Hedgehog.astro';
import Mammoth from '../critters/Mammoth.astro';
import Mouse from '../critters/Mouse.astro';
import Rabbit from '../critters/Rabbit.astro';
import Bluebird from './Bluebird.astro';
import Pigeon from './Pigeon.astro';
import Tree from './Tree.astro';
import Wall from './Wall.astro';

const SKY = 170;

const label =
  'A sunny forest clearing under a blue sky, full of animals talking to each other. In the middle stands a beaver with a red backpack, three times the size of its friends, waving at you. A rabbit and a mouse chat under two speech bubbles, one holding a heart; a blue bird sings from a big tree and the bird on a nest in the next tree chirps back; a fox stands beside a mammoth trumpeting with its trunk raised; a hedgehog reads a letter while a pigeon flies at treetop height between the big tree and the beaver, carrying the next one; a frog and a duckling wave to each other across a pond. Big trees hold nests high in their crowns, each with eggs and a small bird. Far away on the left horizon a low grey wall with barbed wire, a tiny gate and gatekeeper, and the hole everyone left through.';
---
<Meadow sky={SKY} cast={[]} label={label}>
  <Fragment slot="backdrop">
    <!-- clouds, high above the grown trees -->
    <g fill="var(--cloud)" opacity="0.9">
      <g transform="translate(250 -136) scale(1.15)">
        <ellipse cx="0" cy="0" rx="28" ry="11" />
        <ellipse cx="-18" cy="4" rx="16" ry="8" />
        <ellipse cx="20" cy="4" rx="18" ry="8" />
        <ellipse cx="2" cy="-8" rx="16" ry="9" />
      </g>
      <g transform="translate(640 -98) scale(0.9)">
        <ellipse cx="0" cy="0" rx="28" ry="11" />
        <ellipse cx="-18" cy="4" rx="16" ry="8" />
        <ellipse cx="20" cy="4" rx="18" ry="8" />
        <ellipse cx="2" cy="-8" rx="16" ry="9" />
      </g>
      <g transform="translate(940 -152) scale(0.8)">
        <ellipse cx="0" cy="0" rx="28" ry="11" />
        <ellipse cx="-18" cy="4" rx="16" ry="8" />
        <ellipse cx="20" cy="4" rx="18" ry="8" />
        <ellipse cx="2" cy="-8" rx="16" ry="9" />
      </g>
    </g>
    <!-- the wall stays at its round-3 size: a distant memory does not grow
         with the party in the clearing -->
    <Wall />
    <!-- the pigeon keeps below the tallest treetop (y −107): smaller bird,
         bigger envelope (round 8), pinned in the gap between the big left
         tree and the beaver (round 9 — the glide went with the other
         slides; a deck of one slide wants its cast in place) -->
    <Pigeon x={360} y={-70} scale={1.7} envelope={1.35} />
  </Fragment>
  <Fragment slot="midground">
    <!-- foot at y 154: below the middle hill's covering edge (~145-147
         across the trunk, rounded corners included) so the tree stands in
         the grass — at 132 the foot hung above the back hill's crest (~135
         at x 770), visibly floating (round 10) -->
    <Tree x={770} y={154} scale={0.92} grand bird="#5f8fa6" chirp />
  </Fragment>
  <Fragment slot="foreground">
    <Tree x={140} y={152} scale={1.28} grand bird="#c96f4a" />
    <Bluebird x={89} y={-15} scale={1.8} />
    <!-- the fox, in the row left of the mammoth (round 8 — it took the
         squirrel's old spot; no more trail from the breach) -->
    <g transform="translate(145 88)"><Fox size={70} delay="0.9s" /></g>
    <g transform="translate(240 59)"><Mammoth size={104} delay="0.5s" call /></g>
    <g transform="translate(352 89)"><Rabbit size={78} delay="1.1s" /></g>
    <!-- the mouse, turned to face the rabbit -->
    <g transform="translate(488 104) scale(-1 1)"><Mouse size={64} delay="0.6s" /></g>
    <!-- what the two of them are saying: the rabbit talks, the mouse answers -->
    <g>
      <rect x="380" y="78" width="40" height="23" rx="10" fill="#fffdf5" stroke="#6d675a" stroke-width="1" />
      <path d="M394 101 L386 112 L404 101.5 Z" fill="#fffdf5" stroke="#6d675a" stroke-width="1" stroke-linejoin="round" />
      <g fill="#6d675a">
        <circle cx="391" cy="89.5" r="2.2" />
        <circle cx="400" cy="89.5" r="2.2" />
        <circle cx="409" cy="89.5" r="2.2" />
      </g>
      <rect x="452" y="96" width="30" height="19" rx="8.5" fill="#fffdf5" stroke="#6d675a" stroke-width="1" />
      <path d="M462 115 L458 124 L470 115.5 Z" fill="#fffdf5" stroke="#6d675a" stroke-width="1" stroke-linejoin="round" />
      <path d="M467 110.5 C461.5 105 463.5 99.5 467 102.5 C470.5 99.5 472.5 105 467 110.5 Z" fill="#d16d7e" />
    </g>
    <!-- the hedgehog, reading the letter the pigeon brought -->
    <g transform="translate(665 94)"><Hedgehog size={70} delay="0.3s" /></g>
    <g transform="rotate(-6 701 166)">
      <rect x="688" y="157" width="26" height="18" rx="1.5" fill="#fffdf5" stroke="#6d675a" stroke-width="1" />
      <g stroke="#6d675a" stroke-width="1.2" stroke-linecap="round" opacity="0.7">
        <path d="M692 162 L710 162" />
        <path d="M692 166 L710 166" />
        <path d="M692 170 L704 170" />
      </g>
    </g>
    <!-- the opened envelope, dropped at its feet -->
    <g transform="rotate(10 723.5 172)">
      <rect x="716" y="168" width="15" height="9" rx="1" fill="#fffdf5" stroke="#6d675a" stroke-width="0.9" />
      <path d="M716 168 L723.5 162 L731 168" fill="#fffdf5" stroke="#6d675a" stroke-width="0.9" stroke-linejoin="round" />
    </g>
    <!-- a few more flowers where the hedgehog stands -->
    <g stroke="var(--meadow-hill-3)" stroke-width="2.5">
      <line x1="644" y1="176" x2="644" y2="158" />
      <line x1="748" y1="180" x2="748" y2="164" />
    </g>
    <g fill="#e8a1b0">
      <circle cx="644" cy="154" r="6" />
      <circle cx="748" cy="160" r="5.5" />
    </g>
    <g fill="var(--sun)">
      <circle cx="644" cy="154" r="2.4" />
      <circle cx="748" cy="160" r="2.2" />
    </g>
    <Tree x={1050} y={182} scale={1.32} flip grand bird="#d9a441" />
  </Fragment>
  <Fragment slot="front">
    <!-- the pond -->
    <g>
      <ellipse cx="905" cy="191" rx="150" ry="18" fill="var(--pond)" />
      <ellipse cx="905" cy="191" rx="140" ry="14.5" fill="none" stroke="var(--pond-sheen)" stroke-width="1.5" opacity="0.35" />
      <path d="M800 188 Q835 183 870 188" fill="none" stroke="var(--pond-sheen)" stroke-width="2" stroke-linecap="round" />
      <ellipse cx="836" cy="197" rx="11.5" ry="4.2" fill="var(--meadow-hill-3)" />
    </g>
    <!-- the duckling paddles facing the frog; the frog waves back across the water -->
    <g transform="translate(958 130) scale(-1 1)"><Duckling size={64} delay="0.75s" /></g>
    <ellipse cx="926" cy="200" rx="76" ry="11" fill="var(--pond)" />
    <path d="M885 191 Q926 186 967 191" fill="none" stroke="var(--pond-sheen)" stroke-width="2" stroke-linecap="round" />
    <path d="M872 196 Q880 193 888 196 M866 202 Q876 198 886 202" fill="none" stroke="var(--pond-sheen)" stroke-width="1.8" stroke-linecap="round" opacity="0.8" />
    <!-- reeds -->
    <g>
      <g stroke="var(--bark)" stroke-width="2.8" stroke-linecap="round">
        <path d="M1032 193 L1029 164" />
        <path d="M1044 195 L1046 168" />
        <path d="M778 196 L776 172" />
      </g>
      <path d="M1038 193 Q1026 178 1032 161" fill="none" stroke="var(--meadow-hill-2)" stroke-width="2.2" stroke-linecap="round" />
      <g fill="#8a6444">
        <ellipse cx="1028.5" cy="159" rx="3.4" ry="7.4" />
        <ellipse cx="1046.5" cy="163" rx="3.2" ry="6.8" />
        <ellipse cx="775.7" cy="167" rx="3.1" ry="6.2" />
      </g>
    </g>
    <g transform="translate(742 125)"><Frog size={66} delay="1.2s" /></g>
    <!-- Fauna itself, front and centre, the toolkit on its back — the one
         critter that looks out and waves at YOU. At x 460 (user-tuned,
         round 10) the tail tip (~686) grazes only the hedgehog's letter
         corner — at 480 the tail lay square over hedgehog and letter -->
    <g transform="translate(460 -60)"><Beaver size={240} pack delay="0.55s" /></g>
  </Fragment>
</Meadow>
