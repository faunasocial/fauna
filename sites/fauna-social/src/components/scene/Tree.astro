---
// A tree with a nest in it. Fauna's server is a nest, so every tree in the
// meadow has one. Drawn as a group inside the meadow's SVG, in local
// coordinates with the origin at the foot of the trunk: `x`/`y` place it,
// `scale` sizes it, `flip` mirrors it so a row of trees does not repeat.
//
// Two drawings share the component. The default is the front page's small
// tree, unchanged. `grand` is the talk slide's big tree: a tall trunk, a
// wide five-lobe canopy about 205 units high, and the nest HIGH in the
// crown on a visible branch — a proper twiggy bowl with eggs peeking over
// the rim and a small bird sitting on it (`bird` is its colour), so it
// reads as a nest being lived in, not fruit hanging from a twig.
interface Props {
  x: number;
  y: number;
  scale?: number;
  flip?: boolean;
  /** The talk slide's big tree with the high nest, eggs and sitting bird. */
  grand?: boolean;
  /** The nest bird's colour (grand only). */
  bird?: string;
  /** The nest bird answers: chirp arcs from its beak, in its own colour
      (grand only). The clearing scene uses it so the bluebird's song gets a
      reply from another tree — a call across nests. */
  chirp?: boolean;
}
const { x, y, scale = 1, flip = false, grand = false, bird = '#c96f4a', chirp = false } = Astro.props;
const transform = `translate(${x} ${y}) scale(${flip ? -scale : scale} ${scale})`;
---
{grand ? (
  <g transform={transform}>
    <!-- trunk and the two branches: one carries the nest, one is a perch -->
    <rect x="-8" y="-114" width="16" height="114" rx="6" fill="var(--bark)" />
    <path d="M2 -96 Q28 -120 46 -140" stroke="var(--bark)" stroke-width="7" fill="none" stroke-linecap="round" />
    <path d="M-2 -88 Q-24 -104 -40 -116" stroke="var(--bark)" stroke-width="6" fill="none" stroke-linecap="round" />
    <!-- canopy -->
    <circle cx="-36" cy="-136" r="33" fill="var(--meadow-hill-3)" />
    <circle cx="34" cy="-140" r="31" fill="var(--meadow-hill-3)" />
    <circle cx="0" cy="-146" r="34" fill="var(--meadow-hill-3)" />
    <circle cx="-14" cy="-168" r="32" fill="var(--meadow-hill-3)" />
    <circle cx="16" cy="-172" r="30" fill="var(--meadow-hill-3)" />
    <!-- the nest, high in the crown: twiggy bowl, eggs, a sitting bird -->
    <ellipse cx="48" cy="-146" rx="15" ry="8" fill="#8a6444" />
    <circle cx="43" cy="-150" r="3.6" fill="#f3e6ce" />
    <circle cx="50.5" cy="-151" r="3.6" fill="#f3e6ce" />
    <g fill="none" stroke="#6b4a30" stroke-width="1.3" stroke-linecap="round">
      <path d="M35 -147 Q48 -141 61 -147" />
      <path d="M36 -143 Q48 -137 60 -143" />
      <path d="M34 -149 L28.5 -152" />
      <path d="M62 -149 L67.5 -152" />
    </g>
    {chirp && (
      <g fill="none" stroke={bird} stroke-width="1.6" stroke-linecap="round">
        <path d="M43 -158.5 A5 5 0 0 1 43 -166.5" />
        <path d="M38.5 -156 A9 9 0 0 1 38.5 -169" />
        <path d="M34 -153.5 A13 13 0 0 1 34 -171.5" />
      </g>
    )}
    <g>
      <path d="M62 -155 L68.5 -152.5" stroke={bird} stroke-width="2.4" stroke-linecap="round" />
      <ellipse cx="58" cy="-156" rx="5.5" ry="4.5" fill={bird} />
      <circle cx="53.5" cy="-162" r="3.4" fill={bird} />
      <path d="M50.3 -162.7 L47 -161.5 L50.3 -160.5 Z" fill="#f4c95d" />
      <circle cx="52.6" cy="-163.2" r="0.9" fill="#2b2a24" />
    </g>
  </g>
) : (
  <g transform={transform}>
    <rect x="-6.5" y="-75" width="13" height="75" rx="5" fill="var(--bark)" />
    <circle cx="-18.5" cy="-78" r="26" fill="var(--meadow-hill-3)" />
    <circle cx="19.5" cy="-82" r="24" fill="var(--meadow-hill-3)" />
    <circle cx="-0.5" cy="-100" r="26" fill="var(--meadow-hill-3)" />
    <!-- the nest -->
    <ellipse cx="21.5" cy="-64" rx="14" ry="7" fill="#8a6444" />
    <circle cx="16.5" cy="-69" r="3.5" fill="#f3e6ce" />
    <circle cx="25.5" cy="-69" r="3.5" fill="#f3e6ce" />
    <circle cx="21" cy="-73" r="3.5" fill="#f3e6ce" />
  </g>
)}
