---
import Base from '../layouts/Base.astro';
import Critter from '../components/Critter.astro';
// The prose is single-sourced from docs/sites/fauna-social/official-apps.md, like
// every other page here; the TABLES are single-sourced from
// installer/official-apps.json — the one tracked list of the identities the
// official apps and releases carry, which a merge gate holds
// equal to the tree's own pins on every merge (release-integrity.md § Release
// signing → The official-apps list).
//
// **There is deliberately no second generator.** This page imports the same
// committed JSON the gate checks, so the site can never list an identity the
// project does not build or sign with — the bylaws pattern applied to generated
// data, exactly as /features does with matrix.json. Everything below is
// placement and styling: no identity is typed here, no status is judged here,
// and a `pending` row shows its own reason, never a placeholder value.
import manifest from '../../../../installer/official-apps.json';
import { compiledContent, frontmatter as fm } from '../../../../docs/sites/fauna-social/official-apps.md';
import { fill } from '../data/fill.ts';
import { takeOpening } from '../data/copy.ts';

const { heading, lead, illustration, rest } = takeOpening(fill(await compiledContent()));

interface Identity {
  kind: string;
  label: string;
  value: string | Record<string, string> | null;
  status: 'live' | 'pending';
  pending?: string;
  source: string | null;
  how_to_check: string;
}
interface Platform {
  id: string;
  label: string;
  channel: string;
  identities: Identity[];
}

const platforms: Platform[] = manifest.platforms as Platform[];

/** A structured value (the Sigstore identity's regexp + issuer pair) renders
    as its own name/value lines; a string renders as itself. */
const valueLines = (value: Identity['value']): [string, string][] =>
  value === null
    ? []
    : typeof value === 'string'
      ? [['', value]]
      : Object.entries(value).map(([k, v]) => [k.replaceAll('_', ' '), v]);
---
<Base title={fm.title} description={fm.description}>
  <div class="wrap page">
    <article class="prose copy">
      <div class="page-head">
        {illustration && <Critter name={illustration} size={90} />}
        <div>
          <h1 set:html={heading} />
          <p class="lead" set:html={lead} />
        </div>
      </div>

      <Fragment set:html={rest} />

      {platforms.map((platform) => (
        <section class="platform" id={platform.id}>
          <h2>{platform.label}</h2>
          <p class="channel">{platform.channel}</p>
          <div class="scroller">
            <table>
              <thead>
                <tr>
                  <th scope="col" class="what">Identity</th>
                  <th scope="col" class="value">Value</th>
                  <th scope="col" class="how">How to check</th>
                </tr>
              </thead>
              <tbody>
                {platform.identities.map((identity) => (
                  <tr class={`state-${identity.status}`}>
                    <th scope="row" class="what">{identity.label}</th>
                    <td class="value">
                      {identity.status === 'pending' && (
                        <span class="badge">not yet</span>
                      )}
                      {valueLines(identity.value).map(([name, value]) => (
                        <div class="line">
                          {name && <span class="name">{name}: </span>}
                          <code>{value}</code>
                        </div>
                      ))}
                      {identity.status === 'pending' && (
                        <p class="reason">{identity.pending}</p>
                      )}
                    </td>
                    <td class="how">{identity.how_to_check}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ))}
    </article>
  </div>
</Base>

<style>
  .platform { margin-top: 2.5rem; }
  .platform h2 { font-size: 1.2rem; margin-bottom: 0.2rem; }
  .channel { margin: 0 0 0.6rem; color: var(--text-muted); font-size: 0.92rem; }

  /* Three columns are wider than a phone. The table scrolls inside its own
     box rather than making the whole page scroll sideways. */
  .scroller { overflow-x: auto; }

  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
  }
  th, td {
    border-bottom: 1px solid var(--rule, rgba(0, 0, 0, 0.08));
    padding: 0.5rem 0.55rem;
    text-align: left;
    vertical-align: top;
  }
  thead th {
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  th.what { font-weight: 500; min-width: 10rem; }
  td.value { min-width: 14rem; }
  td.how { min-width: 16rem; }

  /* Identifiers and keys wrap at any character: a 44-character key or a long
     regexp must never force the row wider than the box. */
  code { overflow-wrap: anywhere; word-break: break-all; }
  .line .name { color: var(--text-muted); font-size: 0.82rem; }

  /* A pending row keeps its value readable (when it has one) and carries its
     reason underneath. The badge says "not yet" once, up front; the reason is
     the sentence the manifest gives, never a placeholder value. */
  .badge {
    display: inline-block;
    margin-bottom: 0.25rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--rule, rgba(0, 0, 0, 0.15));
  }
  .reason { margin: 0.25rem 0 0; font-size: 0.85rem; color: var(--text-muted); }

  @media (max-width: 560px) {
    table { font-size: 0.85rem; }
    th.what { min-width: 8rem; }
  }
</style>
