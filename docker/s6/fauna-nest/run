#!/command/with-contenv /bin/bash
# Reads /data/inbound-deliver-key (generated by entrypoint.sh) and
# exports it as FAUNA_INBOUND_DELIVER_KEY so nest's
# /api/v1/email/deliver authenticates the bridge daemon's
# x-deliver-key header. Without this, the endpoint returns 503
# (inbox_routes.rs:521).
#
# --blob-dir is required so the BackupService initializes; without
# it, /api/v1/email/deliver falls through to a deliver_local
# fallback that stores messages in a fauna-internal payload format
# that IMAP SEARCH HEADER cannot query. config/default.toml lists
# blob_dir but nest's main.rs only reads it from CLI today.
# FAUNA_FRONTED_BY_ROUTER=1 declares this nest's client-facing listener is
# fronted by the always-up fauna-sni-router (which owns the external :443 and
# forwards to nest's internal :${FAUNA_PORT:-3000}). This is bucket-2 IPC wiring
# (no operator): it tells nest's boot-resolve that the external client-facing
# port is realized by the router + the compose port-map + the provisioning
# orchestrator, NOT by nest's own bind — so the admin-chosen `serving_port`
# singleton is INERT for nest's bind here (it still rides setup.status). Absent
# (Windows desktop service / bare-metal `--bind`) => direct listener => the
# singleton overrides the bind port. See docs/goal/architecture/nest/common.md
# § Serving ports.
DELIVER_KEY=$(cat /data/inbound-deliver-key 2>/dev/null || true)
# (security.md § Co-resident process trust boundary): the secret nest uses
# to verify a PROXY-v2 header came from the fauna-sni-router (not a co-resident
# bridge forging one to spoof a source IP). Read here as root and exported — NOT
# placed on the s6-setuidgid/env argv — so it never lands in the world-readable
# /proc/<pid>/cmdline; /proc/<pid>/environ is readable only by nest's own UID.
# Empty on a non-router box ⇒ nest keeps its trust-any-loopback behaviour.
export FAUNA_ROUTER_PROXY_SECRET="$(cat /data/keys/router/proxy-secret 2>/dev/null || true)"
# (security.md § Enrollment proof-of-possession contract): point
# nest at the root-owned, bridge-UID-unwritable blessed-pubkey registry
# entrypoint.sh wrote. nest re-reads `<dir>/<role>.pub` LIVE on every
# request_enrollment — a path, not a boot-time value snapshot, because a
# service-user key rotation re-blesses the registry mid-life via the bridge
# run-scripts' rebless-bridge-key.sh and the running nest must see the fresh
# key without a restart (mail-bridge-lifecycle.md § Service-user re-keying).
# The dir is 0755 root-owned: nest can read, no bridge UID can substitute
# (integrity is the property; the pubkeys are public). A binary-only/dev nest
# (no artifact mint) leaves this unset ⇒ lenient loopback enrollment, the live
# posture of every shape without this image's registry (installers/docker.md
# § Environment Variables). The registry dir is the one source: nothing reads
# the earlier FAUNA_BLESSED_{MTA,MDA}_PUBKEY value envs.
export FAUNA_BLESSED_KEYS_DIR=/data/keys/blessed
# The public iroh P2P relay URL (`iroh_relay_url` on `fauna.nest.info`) is NOT
# wired here anymore: nest derives `https://relay.<domain>` from its own CLAIMED
# identity (`state.handle_domain()`, discovery_core::nest_info_core), gated on a
# relay sidecar being connected to it AND an orderable apex. There is no
# `FAUNA_DOMAIN` for a run-script to key off (retired; domains-and-tls-bootstrap.md
# § Env contract) — the box boots domainless and learns its domain at claim, so a
# nest-side derivation advertises the right URL with no reboot and no env. See
# transport.md § Future directions + p2p.md § Architecture (Transport seam).
#
# Co-resident UID isolation (security.md § UID isolation): nest creates its
# sealed store (nest.db + WAL/SHM), blob files, ACME private keys, and the
# sidecar token. With /data traversable by the bridge UIDs (0711), those files
# must be born nest-only — so set a 0077 umask (inherited across the setuidgid +
# exec) so every file nest writes is 0600 / dir 0700, unreadable by a co-resident
# bridge. None of nest's /data outputs need group/other read (the flags and
# the sidecar token are read by ROOT run-scripts).
umask 077
exec s6-setuidgid fauna \
  env FAUNA_INBOUND_DELIVER_KEY="$DELIVER_KEY" FAUNA_FRONTED_BY_ROUTER=1 \
  fauna-nest --config /data/nest.toml --blob-dir /data/blobs
