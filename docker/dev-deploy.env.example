# Fauna dev VPS .env — fill these, then run `just dev-deploy user@host`.
# `just dev-deploy` copies this to /srv/fauna/.env on the host on first run if
# none exists; edit the real file there (or here before first deploy).

# Image tag to run. `dev` is what `just docker-push-dev` / `dev-deploy` push.
FAUNA_IMAGE_TAG=dev

# No FAUNA_DOMAIN — it is retired. The box boots DOMAINLESS and learns its
# domain at claim, from the admin's handle (admin@yourdomain.com), persisted as
# the primary mail_domains row (the nest's identity). DNS records (A/AAAA, MX,
# SPF, DMARC, DKIM) are published by your Fauna app, which holds the
# DNS-provider token (the nest never sees it). See
# docs/goal/architecture/nest/domains-and-tls-bootstrap.md § Env contract and
# docs/goal/behavior/dns-management.md.

# Nest internal listen port (the SNI router on :443 fronts it; pure IPC). 3000 —
# kept off 8443 so 8443 means CalDAV only (bare-IP box serves CalDAV at <ip>:8443).
FAUNA_PORT=3000

# Content-scan sidecar addresses (defaults match the compose service names;
# override only for an external clamd/rspamd).
# FAUNA_CLAMD_ADDR=clamd:3310
# FAUNA_RSPAMD_URL=http://rspamd:11333

# Watchtower instant-update API — `just deploy-dev` POSTs /v1/update over SSH.
WATCHTOWER_HTTP_API_UPDATE=true
WATCHTOWER_HTTP_TOKEN=REPLACE_ME_WITH_A_RANDOM_TOKEN
WATCHTOWER_POLL_INTERVAL=86400
